{
  "permissions": {
    "allow": [
      "Bash(ASPNETCORE_ENVIRONMENT=Development dotnet run --no-launch-profile --urls http://localhost:5299)",
      "Read(//c/tmp/**)",
      "Bash(dotnet user-secrets *)",
      "Read(//tmp/**)",
      "Bash(ASPNETCORE_ENVIRONMENT=Development dotnet run --project src/ResidApp.Web --no-launch-profile --urls http://localhost:5299)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5299/)",
      "Bash(taskkill //F //IM dotnet.exe)",
      "Read(//c/Users/logik/**)",
      "Bash(sqlcmd -?)",
      "Bash(sqlcmd -S ACER-ORLANDO -d ResidApp -E -C -Q \"SELECT name FROM sys.tables ORDER BY name;\")",
      "Bash(netstat -ano)",
      "Bash(git rev-list *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(gh run list *)",
      "Bash(dotnet run *)",
      "Bash(powershell -NoProfile -Command 'Get-CimInstance Win32_Process -Filter \"Name='\\\\''dotnet.exe'\\\\''\" | Where-Object { $_.CommandLine -like '\\\\''*ResidApp.Web*'\\\\'' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }')",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" --max-time 3 http://localhost:5299/)",
      "Bash(powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\\\"Name='dotnet.exe'\\\\\" | Select-Object ProcessId, CommandLine | Format-List\")",
      "Bash(pkill -f \"dotnet.*ResidApp.Web\")",
      "Bash(command -v sqlcmd)",
      "Bash(pkill -f \"ResidApp.Web.dll\")",
      "Bash(tasklist //FI \"IMAGENAME eq ResidApp.Web.exe\")",
      "WebSearch",
      "WebFetch(domain:www.boe.es)",
      "WebFetch(domain:boe.es)",
      "WebFetch(domain:publications.europa.eu)",
      "WebFetch(domain:eur-lex.europa.eu)",
      "WebFetch(domain:www.aepd.es)",
      "WebFetch(domain:aepd.es)",
      "WebFetch(domain:www.apdcat.cat)",
      "WebFetch(domain:apdcat.cat)",
      "WebFetch(domain:apdcat.gencat.cat)",
      "WebFetch(domain:seu.apdcat.cat)",
      "WebFetch(domain:canalsalut.gencat.cat)",
      "WebFetch(domain:portaldogc.gencat.cat)",
      "WebFetch(domain:portaljuridic.gencat.cat)",
      "WebFetch(domain:www.edpb.europa.eu)",
      "WebFetch(domain:edpb.europa.eu)",
      "WebFetch(domain:health.ec.europa.eu)",
      "Bash(pwsh -NoProfile -File tools/normativa.ps1)",
      "Bash(pwsh -NoProfile -File tools/normativa.ps1 *)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/aviso-doc-usuario.js"]
          }
        ]
      }
    ]
  }
}

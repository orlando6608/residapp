<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>residapp-prueba-dictado</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResidApp.Domain\ResidApp.Domain.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
  </ItemGroup>

  <!-- El prompt vive en un fichero versionado (ADR 0011), igual que en la aplicación. -->
  <ItemGroup>
    <None Include="Prompts\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

@using ResidApp.Web.Models
@model EnfermeriaResidentDetailViewModel
@{
    ViewData["Title"] = "Ficha del residente";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Resident.DisplayName</li>
    </ol>
</nav>

<h1 class="h3">@Model.Resident.DisplayName</h1>
<p class="text-muted">@(Model.Resident.UnitName ?? "Sin unidad")</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Estado basal vigente</h2>
        @if (Model.Baseline is null)
        {
            <p class="text-muted mb-0">Sin basal vigente registrado.</p>
        }
        else
        {
            <p class="mb-1">Barthel total: <strong>@Model.Baseline.BarthelTotal / 100</strong></p>
            <p class="text-muted mb-0">Firmado el @Model.Baseline.SignedAt.ToLocalTime().ToString("g")</p>
        }
        <a asp-controller="EnfermeriaBasal" asp-action="Draft" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-primary btn-lg mt-3">
            @(Model.Baseline is null ? "Crear borrador de basal" : "Iniciar reevaluación")
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Registrar evento</h2>
        <p class="text-muted">
            Documenta directamente un evento que observas, sin que pase primero por Auxiliar.
        </p>
        <a asp-action="RegistrarEvento" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">
            Registrar evento
        </a>
    </div>
</div>

<div class="alert alert-info mb-0">
    Todavía no está disponible la bandeja de trabajo ni la valoración de eventos: llegan en un grupo
    posterior del vertical Enfermería.
</div>

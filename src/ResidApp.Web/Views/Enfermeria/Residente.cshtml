@using ResidApp.Web.Models
@model EnfermeriaResidentDetailViewModel
@{
    ViewData["Title"] = "Ficha del residente";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Resident.DisplayName</li>
    </ol>
</nav>

<h1 class="h3">@Model.Resident.DisplayName</h1>
<p class="text-muted">@Model.Resident.LocationLabel</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@* Acciones arriba; en escritorio, lo clínico (eventos abiertos) a la izquierda y el basal y el contacto urgente en una
   columna lateral (guia-diseno-sistema-visual.md, 2.B). En móvil, una sola columna en ese orden. *@
<div class="d-grid d-sm-flex flex-wrap gap-2 mb-3">
    <a asp-action="RegistrarEvento" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-primary btn-lg">
        Registrar evento
    </a>
    <a asp-action="Historial" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">
        Ver historial
    </a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <partial name="_EventosAbiertos" model="Model" />
    </div>
    <div class="col-12 col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 card-title">Estado basal vigente</h2>
                <partial name="_ResumenBasal" model="Model.Baseline" />
                <a asp-controller="EnfermeriaBasal" asp-action="Draft" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-primary btn-lg w-100 mt-3">
                    @(Model.Baseline is null ? "Crear borrador de basal" : "Iniciar reevaluación")
                </a>
            </div>
        </div>
        <partial name="_ContactoUrgente" model="new EmergencyContactCardModel(Model.EmergencyContact)" />
    </div>
</div>

@model ResidApp.Web.Models.EnfermeriaInicioViewModel
@{
    ViewData["Title"] = "Inicio de Enfermería";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Enfermería</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Enfermería</h1>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <a asp-action="Residentes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Residentes</h2>
                <p class="card-text text-muted mb-0">Residentes de tu ámbito, con su estado basal vigente o pendiente.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Prioritarios" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Bandeja prioritaria</h2>
                <p class="card-text mb-0"><span class="badge text-bg-danger">@Model.Prioritarios</span> evento(s) prioritario(s) abierto(s).</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Ordinarios" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Cambios ordinarios</h2>
                <p class="card-text mb-0"><span class="badge text-bg-secondary">@Model.Ordinarios</span> evento(s) ordinario(s) abierto(s).</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Seguimientos" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Seguimientos</h2>
                <p class="card-text mb-0">
                    <span class="badge text-bg-info">@Model.Seguimientos</span> seguimiento(s) abierto(s)@(Model.SeguimientosVencidos > 0 ? "," : ".")
                    @if (Model.SeguimientosVencidos > 0)
                    {
                        <span><span class="badge text-bg-danger">@Model.SeguimientosVencidos</span> vencido(s).</span>
                    }
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Indicaciones</h2>
                <p class="card-text mb-0">Próximamente: indicaciones pendientes de Medicina.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Comunicaciones" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Comunicaciones</h2>
                <p class="card-text mb-0"><span class="badge text-bg-secondary">@Model.Comunicaciones</span> comunicación(es) familiar(es) pendiente(s) de aprobación.</p>
            </div>
        </a>
    </div>
</div>

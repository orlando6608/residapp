@{
    ViewData["Title"] = "Inicio de Enfermería";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Enfermería</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Enfermería</h1>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <a asp-action="Residentes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Residentes</h2>
                <p class="card-text text-muted mb-0">Residentes de tu ámbito, con su estado basal vigente o pendiente.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Bandeja prioritaria</h2>
                <p class="card-text mb-0">Próximamente: cambios prioritarios enviados por Auxiliar.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Cambios ordinarios</h2>
                <p class="card-text mb-0">Próximamente: cambios ordinarios enviados por Auxiliar.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Seguimientos</h2>
                <p class="card-text mb-0">Próximamente: seguimientos abiertos de tu unidad.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Indicaciones</h2>
                <p class="card-text mb-0">Próximamente: indicaciones pendientes de Medicina.</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Comunicaciones</h2>
                <p class="card-text mb-0">Próximamente: comunicaciones familiares pendientes de aprobación.</p>
            </div>
        </div>
    </div>
</div>

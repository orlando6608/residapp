@model ResidApp.Web.Models.EnfermeriaInicioViewModel
@{
    ViewData["Title"] = "Inicio de Enfermería";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Enfermería</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Enfermería</h1>

<partial name="_AvisosHitos" model='new MilestoneWarningsModel(Model.Avisos, "Enfermeria")' />

@* Fichas con contador (guia-diseno-sistema-visual.md, 2.B y 2.D): cifra grande con plural real y color según el
   valor (rojo solo si un contador urgente pasa de 0; ámbar si hay indicaciones sin leer). El orden es fijo, con lo
   urgente primero. *@
<div class="row g-3">
    <div class="col-6 col-xl-3">
        <a asp-action="Prioritarios" class="card text-decoration-none h-100 @(Model.Prioritarios > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"prioritarios"' />Bandeja prioritaria</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Prioritarios, "evento prioritario abierto", "eventos prioritarios abiertos", Urgent: true)' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Protocolos" class="card text-decoration-none h-100 @(Model.Protocolos > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"protocolos"' />Protocolos urgentes</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Protocolos, "protocolo urgente activo", "protocolos urgentes activos", Urgent: true)' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Seguimientos" class="card text-decoration-none h-100 @(Model.SeguimientosVencidos > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"seguimientos"' />Seguimientos</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Seguimientos, "seguimiento abierto", "seguimientos abiertos")' />
                @if (Model.SeguimientosVencidos > 0)
                {
                    <span class="d-block text-danger fw-semibold mt-1">@Model.SeguimientosVencidos @(Model.SeguimientosVencidos == 1 ? "pendiente" : "pendientes")</span>
                }
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Indicaciones" class="card text-decoration-none h-100 @(Model.IndicacionesSinLeer > 0 ? "border-start border-4 border-warning" : "")">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"indicaciones"' />Indicaciones</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Indicaciones, "indicación de Medicina pendiente", "indicaciones de Medicina pendientes")' />
                @if (Model.IndicacionesSinLeer > 0)
                {
                    <span class="d-block text-warning-emphasis fw-semibold mt-1">@Model.IndicacionesSinLeer sin leer</span>
                }
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="ParaCerrar" class="card text-decoration-none h-100 @(Model.ParaCerrar > 0 ? "border-start border-4 border-success" : "")">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"para-cerrar"' />Para cerrar</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.ParaCerrar, "episodio con las indicaciones cumplidas", "episodios con las indicaciones cumplidas")' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Ordinarios" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"ordinarios"' />Cambios ordinarios</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Ordinarios, "evento ordinario abierto", "eventos ordinarios abiertos")' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Escalados" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"escalados"' />Escalados a Medicina</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Escalados, "escalado abierto en Medicina", "escalados abiertos en Medicina")' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Comunicaciones" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"comunicaciones"' />Comunicaciones</h2>
                <partial name="_CifraFicha" model='new ResidApp.Web.Models.CardFigure(Model.Comunicaciones, "comunicación familiar pendiente de publicar", "comunicaciones familiares pendientes de publicar")' />
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a asp-action="Residentes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"residentes"' />Residentes</h2>
                <p class="card-text text-body-secondary mb-0">Residentes de tu ámbito, con su estado basal vigente o pendiente.</p>
            </div>
        </a>
    </div>
    @if (ResidApp.Domain.Platform.CurrentCenterService.IsDayCenter)
    {
        <div class="col-6 col-xl-3">
            <a asp-controller="Asistencia" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"planificacion"' />Asistencia</h2>
                    <p class="card-text text-body-secondary mb-0">Quién ha venido hoy al centro, las pautas y las ausencias programadas.</p>
                </div>
            </a>
        </div>
    }
    <div class="col-6 col-xl-3">
        <a asp-controller="CitasExternas" asp-action="Index" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h6 card-title d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2"><partial name="_Icono" model='"citas"' />Citas externas</h2>
                <p class="card-text text-body-secondary mb-0">Pruebas, consultas y tratamientos de tus residentes fuera del centro.</p>
            </div>
        </a>
    </div>
</div>

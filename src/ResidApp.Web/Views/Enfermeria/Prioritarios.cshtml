@using ResidApp.Application.Ports
@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model IReadOnlyList<PendingChangeSummary>
@{
    ViewData["Title"] = "Bandeja prioritaria";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item active" aria-current="page">Bandeja prioritaria</li>
    </ol>
</nav>

<h1 class="h3">Bandeja prioritaria</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<div class="alert alert-info">
    La clasificación inicial organiza la atención; no constituye un diagnóstico.
</div>

@if (Model.Count == 0)
{
    <p class="estado-vacio">No hay eventos prioritarios abiertos.</p>
}
else
{
    @* En pantallas estrechas, una tarjeta pulsable por evento en lugar de la tabla (directrices-pwa-movil.md,
       sección 2). *@
    <div class="d-md-none">
        @foreach (var item in Model)
        {
            <div class="card mb-3 border-start border-4 border-danger">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="flex-grow-1">
                        <h2 class="h6 card-title mb-1">
                            <a asp-action="DetalleCambio" asp-route-eventoId="@item.EventId" class="stretched-link text-body text-decoration-none">@item.ResidentDisplayName</a>
                        </h2>
                        <p class="mb-1">
                            <span class="badge @ClinicalEventStatusDisplay.BadgeClass(item.Status, prioritario: true)">@ClinicalEventStatusDisplay.Label(item.Status)</span>
                            <span class="text-body-secondary small">hace @ElapsedTimeDisplay.Since(item.OccurredAt) · @(item.UnitName ?? "Sin unidad")</span>
                        </p>
                        <p class="mb-1">@(item.Origin == ClinicalEventOrigin.EventoEnfermeria ? "Evento observado por Enfermería" : item.PriorityReason is null ? "—" : DailyChangePriorityReasonDisplay.Label(item.PriorityReason.Value))</p>
                        @if (item.DirectNoticeNotes is not null)
                        {
                            <p class="text-body-secondary small mb-0">Aviso directo: @item.DirectNoticeNotes</p>
                        }
                    </div>
                    <span class="fs-3 text-body-secondary" aria-hidden="true">›</span>
                </div>
            </div>
        }
    </div>
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Residente</th>
                    <th scope="col">Unidad</th>
                    <th scope="col">Motivo inicial</th>
                    <th scope="col">Aviso directo documentado</th>
                    <th scope="col">Antigüedad</th>
                    <th scope="col">Estado</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ResidentDisplayName</td>
                        <td>@(item.UnitName ?? "Sin unidad")</td>
                        <td>@(item.Origin == ClinicalEventOrigin.EventoEnfermeria ? "Evento observado por Enfermería" : item.PriorityReason is null ? "—" : DailyChangePriorityReasonDisplay.Label(item.PriorityReason.Value))</td>
                        <td>@(item.DirectNoticeNotes ?? "—")</td>
                        <td>@ElapsedTimeDisplay.Since(item.OccurredAt)</td>
                        <td><span class="badge @ClinicalEventStatusDisplay.BadgeClass(item.Status, prioritario: true)">@ClinicalEventStatusDisplay.Label(item.Status)</span></td>
                        <td>
                            <a asp-action="DetalleCambio" asp-route-eventoId="@item.EventId" class="btn btn-outline-primary btn-sm">Ver detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model SeguimientoViewModel
@{
    ViewData["Title"] = "Seguimiento";
    var evento = Model.Event;
    var seguimiento = evento.FollowUp!;
    var vencido = FollowUpDisplay.IsOverdue(seguimiento.DueDate);
    var pendiente = seguimiento.PendingTransfer;
    var actuacion = Model.FormFor(FollowUpActionType.Actuacion);
    var reprogramacion = Model.FormFor(FollowUpActionType.Reprogramacion);
    var transferencia = Model.FormFor(FollowUpActionType.Transferencia);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="Seguimientos">Seguimientos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Seguimiento</li>
    </ol>
</nav>

<h1 class="h3">Seguimiento — @evento.ResidentDisplayName</h1>
<p class="text-muted">
    Equipo responsable: Enfermería de @(evento.UnitName ?? "la unidad") ·
    iniciado @(seguimiento.StartedByCurrentAccount ? "por ti" : "por otro profesional de Enfermería")
    el @seguimiento.StartedAt.ToLocalTime().ToString("g") ·
    <a asp-action="DetalleCambio" asp-route-eventoId="@evento.EventId">Ver el evento y la valoración</a>
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-3 border-start border-4 @(vencido ? "border-danger" : "border-info")">
    <div class="card-body">
        <h2 class="h5 card-title">Plan vigente</h2>
        <p class="mb-1">
            @if (vencido)
            {
                <span class="badge text-bg-danger">Vencido</span>
            }
            <span style="white-space: pre-line">@FollowUpDisplay.Plan(seguimiento.DueDate, seguimiento.Criterion)</span>
        </p>
        @if (vencido)
        {
            <p class="text-muted mb-1">Un seguimiento vencido sigue abierto: resuélvelo o reprográmalo justificadamente.</p>
        }
        @if (seguimiento.ContinuityNotes is not null)
        {
            <p class="fw-semibold mb-0 mt-2">Indicaciones de continuidad</p>
            <p class="mb-0" style="white-space: pre-line">@seguimiento.ContinuityNotes</p>
        }
    </div>
</div>

@if (pendiente is not null)
{
    <div class="alert alert-warning">
        <p class="mb-2">
            <strong>Transferencia pendiente de recepción:</strong> al equipo o turno «@pendiente.IncomingTeam»,
            el @pendiente.RecordedAt.ToLocalTime().ToString("g").
            @if (pendiente.Text is not null)
            {
                <br /><span style="white-space: pre-line">Nota: @pendiente.Text</span>
            }
        </p>
        <form asp-action="Seguimiento" method="post" class="d-grid d-md-flex">
            <input type="hidden" name="Form.EventoId" value="@evento.EventId" />
            <input type="hidden" name="Form.Revision" value="@evento.Revision" />
            <input type="hidden" name="Form.Tipo" value="@FollowUpActionType.Recepcion" />
            <input type="hidden" name="Form.TransferenciaId" value="@pendiente.Id" />
            <button type="submit" class="btn btn-dark btn-lg">Confirmar recepción</button>
        </form>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Actuaciones y cambios</h2>
        @if (seguimiento.Actions.Count == 0)
        {
            <p class="text-muted mb-0">Todavía no hay actuaciones registradas.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var accion in seguimiento.Actions)
                {
                    <li class="mb-3">
                        <p class="mb-1">
                            <strong>@FollowUpDisplay.Label(accion.Type)</strong> ·
                            @(accion.ByCurrentAccount ? "tú" : "otro profesional de Enfermería") ·
                            @accion.RecordedAt.ToLocalTime().ToString("g")
                        </p>
                        @switch (accion.Type)
                        {
                            case FollowUpActionType.Reprogramacion:
                                <p class="mb-0">Nuevo plan: @FollowUpDisplay.Plan(accion.DueDate, accion.Criterion)</p>
                                <p class="mb-0" style="white-space: pre-line">Justificación: @accion.Text</p>
                                break;
                            case FollowUpActionType.Transferencia:
                                <p class="mb-0">A: @accion.IncomingTeam</p>
                                if (accion.Text is not null)
                                {
                                    <p class="mb-0" style="white-space: pre-line">Nota: @accion.Text</p>
                                }
                                break;
                            case FollowUpActionType.Recepcion:
                                break;
                            default:
                                <p class="mb-0" style="white-space: pre-line">@accion.Text</p>
                                break;
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Registrar actuación</h2>
        <form asp-action="Seguimiento" method="post">
            <input type="hidden" name="Form.EventoId" value="@evento.EventId" />
            <input type="hidden" name="Form.Revision" value="@actuacion.Revision" />
            <input type="hidden" name="Form.Tipo" value="@FollowUpActionType.Actuacion" />
            <label for="actuacion-texto" class="form-label">Actuación</label>
            <textarea id="actuacion-texto" name="Form.Texto" class="form-control mb-3" rows="3">@actuacion.Texto</textarea>
            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary btn-lg">Registrar actuación</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Reprogramar</h2>
        <form asp-action="Seguimiento" method="post">
            <input type="hidden" name="Form.EventoId" value="@evento.EventId" />
            <input type="hidden" name="Form.Revision" value="@reprogramacion.Revision" />
            <input type="hidden" name="Form.Tipo" value="@FollowUpActionType.Reprogramacion" />
            <p class="text-muted">El plan nuevo sustituye al vigente. Indica una fecha, un criterio o ambos, y justifica el cambio.</p>
            <div class="mb-3">
                <label for="reprogramar-fecha" class="form-label">Nueva fecha prevista</label>
                <input id="reprogramar-fecha" name="Form.FechaPrevista" type="date" class="form-control form-control-lg" style="max-width: 260px;"
                       value="@reprogramacion.FechaPrevista?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label for="reprogramar-criterio" class="form-label">Nuevo criterio</label>
                <textarea id="reprogramar-criterio" name="Form.Criterio" class="form-control" rows="2">@reprogramacion.Criterio</textarea>
            </div>
            <label for="reprogramar-justificacion" class="form-label">Justificación</label>
            <textarea id="reprogramar-justificacion" name="Form.Texto" class="form-control mb-3" rows="2">@reprogramacion.Texto</textarea>
            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-outline-primary btn-lg">Reprogramar</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Transferir al turno entrante</h2>
        <form asp-action="Seguimiento" method="post">
            <input type="hidden" name="Form.EventoId" value="@evento.EventId" />
            <input type="hidden" name="Form.Revision" value="@transferencia.Revision" />
            <input type="hidden" name="Form.Tipo" value="@FollowUpActionType.Transferencia" />
            <p class="text-muted">El seguimiento sigue visible aunque nadie confirme la recepción.</p>
            <div class="mb-3">
                <label for="transferir-equipo" class="form-label">Equipo entrante</label>
                @if (Model.Teams.Count == 0)
                {
                    <p class="text-muted mb-0" id="transferir-equipo">
                        La unidad del residente no tiene equipos activos. Pide a Administración que cree uno para poder transferir.
                    </p>
                }
                else
                {
                    <select id="transferir-equipo" name="Form.EquipoEntranteId" class="form-select form-select-lg">
                        <option value="">Elige un equipo</option>
                        @foreach (var team in Model.Teams)
                        {
                            <option value="@team.TeamId" selected="@(team.TeamId == transferencia.EquipoEntranteId)">@team.Name</option>
                        }
                    </select>
                }
            </div>
            <label for="transferir-nota" class="form-label">Nota de continuidad</label>
            <textarea id="transferir-nota" name="Form.Texto" class="form-control mb-3" rows="3">@transferencia.Texto</textarea>
            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-outline-primary btn-lg">Transferir</button>
            </div>
        </form>
    </div>
</div>

<div class="d-grid d-md-flex justify-content-md-end gap-2 mb-3">
    <a asp-action="Seguimientos" class="btn btn-outline-secondary btn-lg">Volver a la bandeja</a>
    <a asp-action="Decision" asp-route-eventoId="@evento.EventId" class="btn btn-primary btn-lg">Resolver</a>
</div>

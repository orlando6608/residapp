@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model IReadOnlyList<VitalSignAlert>
@* Aviso informativo (ENF-05): nunca bloquea ni cambia clasificación, prioridad o desenlace del evento. *@
@if (Model.Count > 0)
{
    <div class="alert alert-warning" role="status">
        <p class="fw-semibold mb-1">⚠ Constantes fuera del rango de referencia del centro</p>
        <ul class="mb-1">
            @foreach (var alert in Model)
            {
                <li>@VitalSignRangeDisplay.Alert(alert)</li>
            }
        </ul>
        <p class="small mb-0">Aviso informativo: no cambia la clasificación ni la prioridad del evento; la decisión es del profesional.</p>
    </div>
}

@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model EnfermeriaChangeDetailViewModel
@{
    ViewData["Title"] = "Detalle del evento recibido";
    var evento = Model.Change;
    var esPrioritario = evento.Classification == ResidApp.Domain.Auxiliar.DailyChangeClassification.Prioritario;
    var esPropio = evento.Origin == ClinicalEventOrigin.EventoEnfermeria;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="@(esPrioritario ? "Prioritarios" : "Ordinarios")">@(esPrioritario ? "Bandeja prioritaria" : "Cambios ordinarios")</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<h1 class="h3">@evento.ResidentDisplayName</h1>
<p class="text-muted">
    @(evento.UnitName ?? "Sin unidad") ·
    <span class="badge @(esPrioritario ? "text-bg-danger" : "text-bg-secondary")">@(esPrioritario ? "Prioritario" : "Ordinario")</span>
    <span class="badge @ClinicalEventStatusDisplay.BadgeClass(evento.Status, esPrioritario)">@ClinicalEventStatusDisplay.Label(evento.Status)</span>
    · @(esPropio ? "Observado" : "Registrado") por @SystemProfileDisplay.Label(evento.AuthorProfile) el @evento.OccurredAt.ToLocalTime().ToString("g")
    (@ElapsedTimeDisplay.Since(evento.OccurredAt))
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (esPrioritario && !esPropio)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Motivo inicial y aviso directo</h2>
            <p class="mb-1">
                Motivo: <strong>@(evento.PriorityReason is null ? "—" : DailyChangePriorityReasonDisplay.Label(evento.PriorityReason.Value))</strong>
            </p>
            <p class="mb-0">Aviso directo documentado: @(evento.DirectNoticeNotes ?? "—")</p>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Observación original</h2>
        <p class="text-muted">La observación original es inmutable; no se modifica al valorarla.</p>
        @if (esPropio)
        {
            <p class="mb-3" style="white-space: pre-line">@evento.Observation</p>
            @if (!string.IsNullOrWhiteSpace(evento.ClinicalData))
            {
                <p class="fw-semibold mb-1">Datos clínicos pertinentes</p>
                <p class="mb-0" style="white-space: pre-line">@evento.ClinicalData</p>
            }
        }
        else
        {
            @if (evento.TemperatureCelsius is not null)
            {
                <p class="mb-3">Temperatura: <strong>@evento.TemperatureCelsius.Value.ToString("0.0")°C</strong></p>
            }
            @foreach (var area in evento.Areas)
            {
                <div class="mb-3">
                    <p class="fw-semibold mb-1">@DailyChangeAreaDisplay.Label(area.AreaCode)</p>
                    @if (area.Options.Count > 0)
                    {
                        <ul class="mb-1">
                            @foreach (var option in area.Options)
                            {
                                <li>@DailyChangeAreaOptionDisplay.Label(option)</li>
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(area.FreeText))
                    {
                        <p class="mb-0">@area.FreeText</p>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Basal vigente</h2>
        @if (Model.Baseline is null)
        {
            <p class="text-muted mb-0">Sin basal vigente registrado.</p>
        }
        else
        {
            <p class="mb-1">Barthel total: <strong>@Model.Baseline.BarthelTotal / 100</strong></p>
            <p class="text-muted mb-0">Firmado el @Model.Baseline.SignedAt.ToLocalTime().ToString("g")</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Valoración de Enfermería</h2>
        @if (evento.Status == ClinicalEventStatus.Pendiente)
        {
            <p class="mb-0">Todavía no se ha empezado a valorar. Al empezar se registra quién lo hace y a qué hora; no te convierte en responsable exclusivo del evento.</p>
        }
        else
        {
            <p class="mb-2">
                Valoración iniciada @(evento.AssessmentStartedByCurrentAccount == true ? "por ti" : "por otro profesional de Enfermería")
                el @evento.AssessmentStartedAt?.ToLocalTime().ToString("g").
            </p>
            @if (evento.Assessment is null)
            {
                <p class="text-muted mb-0">Sin borrador guardado todavía.</p>
            }
            else
            {
                var content = evento.Assessment.Content;
                <partial name="_AvisosConstantes" model="VitalSignReferenceRanges.Evaluate(content.Vitals, evento.ReferenceRanges)" />
                <p class="text-muted">
                    Último guardado @(evento.Assessment.LastUpdatedByCurrentAccount ? "tuyo" : "de otro profesional")
                    el @evento.Assessment.LastUpdatedAt.ToLocalTime().ToString("g").
                </p>
                <dl class="row mb-0">
                    @foreach (var (etiqueta, texto) in new[] { ("Hallazgos", content.Findings), ("Valoración", content.Assessment), ("Actuaciones", content.Actions), ("Comunicaciones", content.Communications), ("Resultado", content.Outcome) })
                    {
                        if (texto is not null)
                        {
                            <dt class="col-sm-3">@etiqueta</dt>
                            <dd class="col-sm-9" style="white-space: pre-line">@texto</dd>
                        }
                    }
                    @if (!content.Vitals.IsEmpty)
                    {
                        <dt class="col-sm-3">Constantes</dt>
                        <dd class="col-sm-9">@VitalSignsDisplay.Summary(content.Vitals)</dd>
                    }
                </dl>
            }
        }
    </div>
</div>

<div class="d-grid d-md-flex justify-content-md-end gap-2 mb-3">
    @if (evento.Status == ClinicalEventStatus.Pendiente)
    {
        <form asp-action="EmpezarValoracion" method="post">
            <input type="hidden" name="eventoId" value="@evento.EventId" />
            <input type="hidden" name="revision" value="@evento.Revision" />
            <button type="submit" class="btn btn-primary btn-lg w-100">Empezar valoración</button>
        </form>
    }
    else
    {
        <a asp-action="Valoracion" asp-route-eventoId="@evento.EventId" class="btn btn-primary btn-lg">
            @(evento.Assessment is null ? "Completar valoración" : "Continuar valoración")
        </a>
    }
</div>

<div class="alert alert-info mb-0">
    La decisión asistencial (cerrar, iniciar seguimiento, escalar a Medicina o activar el protocolo urgente)
    y la línea temporal del evento todavía no están disponibles: llegan en próximos bloques del vertical Enfermería.
</div>

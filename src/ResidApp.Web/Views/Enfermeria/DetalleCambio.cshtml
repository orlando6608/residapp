@using ResidApp.Web.Models
@model EnfermeriaChangeDetailViewModel
@{
    ViewData["Title"] = "Detalle del evento recibido";
    var esPrioritario = Model.Change.Classification == ResidApp.Domain.Auxiliar.DailyChangeClassification.Prioritario;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="@(esPrioritario ? "Prioritarios" : "Ordinarios")">@(esPrioritario ? "Bandeja prioritaria" : "Cambios ordinarios")</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle</li>
    </ol>
</nav>

<h1 class="h3">@Model.Change.ResidentDisplayName</h1>
<p class="text-muted">
    @(Model.Change.UnitName ?? "Sin unidad") ·
    <span class="badge @(esPrioritario ? "text-bg-danger" : "text-bg-secondary")">@(esPrioritario ? "Prioritario" : "Ordinario")</span>
    · Registrado por @SystemProfileDisplay.Label(Model.Change.AuthorProfile) el @Model.Change.OccurredAt.ToLocalTime().ToString("g")
    (@ElapsedTimeDisplay.Since(Model.Change.OccurredAt))
</p>

@if (esPrioritario)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Motivo inicial y aviso directo</h2>
            <p class="mb-1">
                Motivo: <strong>@(Model.Change.PriorityReason is null ? "—" : DailyChangePriorityReasonDisplay.Label(Model.Change.PriorityReason.Value))</strong>
            </p>
            <p class="mb-0">Aviso directo documentado: @(Model.Change.DirectNoticeNotes ?? "—")</p>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Observación original</h2>
        <p class="text-muted">La observación original es inmutable; no se modifica al valorarla.</p>
        @if (Model.Change.TemperatureCelsius is not null)
        {
            <p class="mb-3">Temperatura: <strong>@Model.Change.TemperatureCelsius.Value.ToString("0.0")°C</strong></p>
        }
        @foreach (var area in Model.Change.Areas)
        {
            <div class="mb-3">
                <p class="fw-semibold mb-1">@DailyChangeAreaDisplay.Label(area.AreaCode)</p>
                @if (area.Options.Count > 0)
                {
                    <ul class="mb-1">
                        @foreach (var option in area.Options)
                        {
                            <li>@DailyChangeAreaOptionDisplay.Label(option)</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(area.FreeText))
                {
                    <p class="mb-0">@area.FreeText</p>
                }
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Basal vigente</h2>
        @if (Model.Baseline is null)
        {
            <p class="text-muted mb-0">Sin basal vigente registrado.</p>
        }
        else
        {
            <p class="mb-1">Barthel total: <strong>@Model.Baseline.BarthelTotal / 100</strong></p>
            <p class="text-muted mb-0">Firmado el @Model.Baseline.SignedAt.ToLocalTime().ToString("g")</p>
        }
    </div>
</div>

<div class="alert alert-info mb-0">
    Todavía no está disponible empezar la valoración ni desplegar la línea temporal desde aquí: llegan en
    un grupo posterior del vertical Enfermería. Por ahora, sin actuaciones registradas.
</div>

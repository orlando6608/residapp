@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model CerrarViewModel
@{
    ViewData["Title"] = "Cerrar el evento";
    var evento = Model.Event;
    ViewData["Derivacion"] = evento.Referral;
    var content = evento.Assessment!.Content;
    var (volver, volverTexto) = evento.Status == ClinicalEventStatus.ProtocoloUrgente ? ("Protocolo", "Protocolo urgente") : ("Decision", "Decisión asistencial");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="DetalleCambio" asp-route-eventoId="@evento.EventId">Detalle</a></li>
        <li class="breadcrumb-item"><a asp-action="@volver" asp-route-eventoId="@evento.EventId">@volverTexto</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cerrar</li>
    </ol>
</nav>

<h1 class="h3">Cerrar el evento — @evento.ResidentDisplayName</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Resumen de la valoración</h2>
        <p class="text-muted">
            Último guardado @(evento.Assessment.LastUpdatedByCurrentAccount ? "tuyo" : "de otro profesional")
            el @evento.Assessment.LastUpdatedAt.ToLocalTime().ToString("g"). Al cerrar, la valoración ya no se puede modificar.
        </p>
        <dl class="row mb-0">
            @foreach (var (etiqueta, texto) in new[] { ("Hallazgos", content.Findings), ("Valoración", content.Assessment), ("Actuaciones", content.Actions), ("Comunicaciones", content.Communications), ("Resultado", content.Outcome) })
            {
                if (texto is not null)
                {
                    <dt class="col-sm-3">@etiqueta</dt>
                    <dd class="col-sm-9" style="white-space: pre-line">@texto</dd>
                }
            }
            @if (!content.Vitals.IsEmpty)
            {
                <dt class="col-sm-3">Constantes</dt>
                <dd class="col-sm-9">@VitalSignsDisplay.Summary(content.Vitals)</dd>
            }
        </dl>
    </div>
</div>

@if (evento.FollowUp is { } seguimiento)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Seguimiento</h2>
            <p class="mb-2">Plan vigente: @FollowUpDisplay.Plan(seguimiento.DueDate, seguimiento.Criterion)</p>
            @if (seguimiento.Actions.Count == 0)
            {
                <p class="text-muted mb-0">Sin actuaciones registradas durante el seguimiento.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var accion in seguimiento.Actions.Where(a => a.Type == FollowUpActionType.Actuacion))
                    {
                        <li style="white-space: pre-line">@accion.RecordedAt.ToLocalTime().ToString("g"): @accion.Text</li>
                    }
                </ul>
            }
        </div>
    </div>
}

<form asp-action="Cerrar" method="post">
    <input type="hidden" asp-for="Form.EventoId" />
    <input type="hidden" asp-for="Form.Revision" />
    <input type="hidden" asp-for="Form.OperacionId" />

    <partial name="_ComunicacionFamiliarFormulario" for="Form" />

    <div class="d-grid d-md-flex justify-content-md-end gap-2">
        <a asp-action="@volver" asp-route-eventoId="@evento.EventId" class="btn btn-outline-secondary btn-lg">Volver sin cerrar</a>
        <button type="submit" class="btn btn-primary btn-lg">Cerrar evento</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

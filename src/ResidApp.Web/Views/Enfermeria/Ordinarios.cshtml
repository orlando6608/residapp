@using ResidApp.Application.Ports
@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model PendingChangeListViewModel
@{
    ViewData["Title"] = "Bandeja de cambios ordinarios";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cambios ordinarios</li>
    </ol>
</nav>

<h1 class="h3">Bandeja de cambios ordinarios</h1>
<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.TotalCount > 0)
{
    <form method="get" asp-action="Ordinarios" role="search" class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md">
                    <label for="filtro-q" class="form-label">Residente</label>
                    <input id="filtro-q" name="q" type="search" value="@Model.Filter.Q" maxlength="200" class="form-control form-control-lg"
                           autocomplete="off" />
                </div>
                @if (Model.Units.Count > 1)
                {
                    <div class="col-12 col-md-3">
                        <label for="filtro-unidad" class="form-label">Unidad</label>
                        <select id="filtro-unidad" name="unidad" class="form-select form-select-lg">
                            <option value="">Todas</option>
                            @foreach (var unit in Model.Units)
                            {
                                <option value="@unit.Id" selected="@(Model.Filter.Unidad == unit.Id)">@unit.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-12 col-md-3">
                    <label for="filtro-estado" class="form-label">Estado</label>
                    <select id="filtro-estado" name="estado" class="form-select form-select-lg">
                        <option value="">Todos</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status" selected="@(Model.Filter.Estado == status)">@ClinicalEventStatusDisplay.Label(status)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">Buscar</button>
                    @if (!Model.Filter.IsEmpty)
                    {
                        <a asp-action="Ordinarios" class="btn btn-outline-secondary btn-lg">Limpiar</a>
                    }
                </div>
            </div>
        </div>
    </form>
    @if (!Model.Filter.IsEmpty)
    {
        <p class="text-muted" role="status">
            @(Model.Items.Count == 0
                ? "Ningún evento coincide con la búsqueda."
                : $"{Model.Items.Count} de {Model.TotalCount} eventos.")
        </p>
    }
}

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No hay eventos ordinarios abiertos.</p>
}
else if (Model.Items.Count > 0)
{
    @* En pantallas estrechas, una tarjeta pulsable por evento en lugar de la tabla (directrices-pwa-movil.md,
       sección 2). *@
    <div class="d-md-none">
        @foreach (var item in Model.Items)
        {
            <div class="card mb-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="flex-grow-1">
                        <h2 class="h6 card-title mb-1">
                            <a asp-action="DetalleCambio" asp-route-eventoId="@item.EventId" class="stretched-link text-body text-decoration-none">@item.ResidentDisplayName</a>
                        </h2>
                        <p class="mb-1">
                            <span class="badge @ClinicalEventStatusDisplay.BadgeClass(item.Status, prioritario: false)">@ClinicalEventStatusDisplay.Label(item.Status)</span>
                            <span class="text-body-secondary small">hace @ElapsedTimeDisplay.Since(item.OccurredAt) · @(item.UnitName ?? "Sin unidad")</span>
                        </p>
                        <p class="mb-1">@(item.Origin == ClinicalEventOrigin.EventoEnfermeria ? $"Evento observado por Enfermería: {EventExcerpt(item.Observation)}" : string.Join(", ", item.Areas.Select(DailyChangeAreaDisplay.Label)))</p>
                        <p class="text-body-secondary small mb-0">@SystemProfileDisplay.Label(item.AuthorProfile) · @item.OccurredAt.ToLocalTime().ToString("g")</p>
                    </div>
                    <span class="fs-3 text-body-secondary" aria-hidden="true">›</span>
                </div>
            </div>
        }
    </div>
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Residente</th>
                    <th scope="col">Unidad</th>
                    <th scope="col">Área observada o evento</th>
                    <th scope="col">Autor</th>
                    <th scope="col">Fecha/hora</th>
                    <th scope="col">Antigüedad</th>
                    <th scope="col">Estado</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ResidentDisplayName</td>
                        <td>@(item.UnitName ?? "Sin unidad")</td>
                        <td>@(item.Origin == ClinicalEventOrigin.EventoEnfermeria ? $"Evento observado por Enfermería: {EventExcerpt(item.Observation)}" : string.Join(", ", item.Areas.Select(DailyChangeAreaDisplay.Label)))</td>
                        <td>@SystemProfileDisplay.Label(item.AuthorProfile)</td>
                        <td>@item.OccurredAt.ToLocalTime().ToString("g")</td>
                        <td>@ElapsedTimeDisplay.Since(item.OccurredAt)</td>
                        <td><span class="badge @ClinicalEventStatusDisplay.BadgeClass(item.Status, prioritario: false)">@ClinicalEventStatusDisplay.Label(item.Status)</span></td>
                        <td>
                            <a asp-action="DetalleCambio" asp-route-eventoId="@item.EventId" class="btn btn-outline-primary btn-sm">Ver detalle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    private static string EventExcerpt(string? observation) =>
        observation is null ? "—" : observation.Length <= 80 ? observation : observation[..80] + "…";
}

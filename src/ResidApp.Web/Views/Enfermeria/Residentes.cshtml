@model ResidApp.Web.Models.ResidentListViewModel
@{
    ViewData["Title"] = "Residentes";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item active" aria-current="page">Residentes</li>
    </ol>
</nav>

<h1 class="h3">Residentes</h1>
<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.TotalCount > 0)
{
    <partial name="_FiltroResidentes" model="Model" />
}

@if (Model.TotalCount == 0)
{
    <p class="text-muted">No hay residentes en tu ámbito.</p>
}
else
{
    <div class="row g-3">
        @foreach (var resident in Model.Residents)
        {
            <div class="col-12 col-md-6 col-lg-4">
                @* La tarjeta entera abre la ficha: el enlace del nombre se estira sobre ella (guía, 2.B). *@
                <div class="card h-100 border-start border-4 @(resident.TieneBasalVigente ? "border-success" : "border-danger")">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="flex-grow-1">
                            <h2 class="h5 card-title mb-1">
                                <a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value" class="stretched-link text-body text-decoration-none">@resident.DisplayName</a>
                            </h2>
                            <p class="card-text text-muted mb-2">@resident.LocationLabel</p>
                            <span class="badge @(resident.TieneBasalVigente ? "text-bg-success" : "text-bg-danger")">
                                @(resident.TieneBasalVigente ? "Basal vigente" : "Basal pendiente")
                            </span>
                        </div>
                        <span class="fs-3 text-body-secondary" aria-hidden="true">›</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

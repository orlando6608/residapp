@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model RangosReferenciaViewModel
@{
    ViewData["Title"] = "Rangos de referencia de constantes";
    string Limit(decimal? value) => value is null ? "—" : value.Value.ToString("0.#");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Rangos de referencia</li>
    </ol>
</nav>

<h1 class="h3">Rangos de referencia de constantes</h1>

@if (Model.View is null)
{
    <div class="alert alert-danger">
        No se puede acceder a esta operación. Fijar los rangos requiere un perfil clínico (Medicina o
        Dirección/Coordinación Clínica) con el permiso específico para ello en este centro.
    </div>
    return;
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<div class="alert alert-info">
    Estos rangos se aplican a todo el centro. Cuando Enfermería registra una constante fuera de su rango, la
    valoración muestra un aviso <strong>solo informativo</strong>: no impide guardar ni cambia la
    clasificación o la prioridad del evento. Deja vacíos el mínimo y el máximo de una constante para que no
    tenga rango. El rango de la saturación es el de aire ambiente: si se registró con oxigenoterapia, no se
    avisa. El permiso para fijar los rangos lo concede Administración a una persona concreta (de Medicina o de
    Dirección/Coordinación Clínica); ningún perfil lo tiene por defecto.
</div>

@if (Model.SugeridosCargados)
{
    <div class="alert alert-warning" role="status">
        Se han cargado los <strong>valores sugeridos</strong> en el formulario, pero
        <strong>todavía no se han guardado</strong>. Revísalos y pulsa «Guardar rangos». La glucemia solo tiene
        mínimo: el resto de valores se individualiza.
    </div>
}
else
{
    <p>
        <a asp-action="Index" asp-route-sugeridos="true" class="btn btn-outline-secondary">Cargar valores sugeridos</a>
        <span class="form-text d-block">Rellena el formulario con los valores propuestos; no se guarda nada hasta que lo hagas.</span>
    </p>
}

<form asp-action="Index" method="post">
    <input type="hidden" asp-for="Form.Version" />

    <div class="card mb-3">
        <div class="card-body">
            @* Rejilla en lugar de tabla: en el móvil cada constante ocupa su fila con el mínimo y el máximo lado a lado, sin
               scroll horizontal (directrices-pwa-movil.md, sección 2). Los campos no se pueden duplicar en una vista de
               tarjetas aparte porque se enviarían dos veces. *@
            <div class="row g-2 d-none d-md-flex fw-semibold border-bottom pb-2">
                <div class="col-md-4">Constante</div>
                <div class="col-md-4">Mínimo</div>
                <div class="col-md-4">Máximo</div>
            </div>
            @for (var i = 0; i < Model.Form.Rangos.Count; i++)
            {
                var label = VitalSignRangeDisplay.Label(Model.Form.Rangos[i].Constante);
                var unit = VitalSignRangeDisplay.Unit(Model.Form.Rangos[i].Constante);
                <fieldset class="row gx-2 gy-1 align-items-center py-3 @(i < Model.Form.Rangos.Count - 1 ? "border-bottom" : "")">
                    <legend class="col-12 col-md-4 fs-6 fw-semibold mb-0">
                        @label <span class="text-body-secondary fw-normal">(@unit)</span>
                    </legend>
                    <input type="hidden" asp-for="Form.Rangos[i].Constante" />
                    <div class="col-6 col-md-4">
                        <span class="d-block small mb-1 d-md-none" aria-hidden="true">Mínimo</span>
                        <input asp-for="Form.Rangos[i].Minimo" type="number" step="0.1" inputmode="decimal"
                               class="form-control form-control-lg" aria-label="@label: mínimo" />
                        <span asp-validation-for="Form.Rangos[i].Minimo" class="text-danger"></span>
                    </div>
                    <div class="col-6 col-md-4">
                        <span class="d-block small mb-1 d-md-none" aria-hidden="true">Máximo</span>
                        <input asp-for="Form.Rangos[i].Maximo" type="number" step="0.1" inputmode="decimal"
                               class="form-control form-control-lg" aria-label="@label: máximo" />
                        <span asp-validation-for="Form.Rangos[i].Maximo" class="text-danger"></span>
                    </div>
                </fieldset>
            }
        </div>
    </div>

    <div class="d-grid d-md-flex justify-content-md-end mb-4">
        <button type="submit" class="btn btn-primary btn-lg">Guardar rangos</button>
    </div>
</form>

<h2 class="h5">Historial de cambios</h2>
@if (Model.View.History.Count == 0)
{
    <p class="estado-vacio">Todavía no se ha fijado ningún rango en este centro.</p>
}
else
{
    @* En pantallas estrechas, una entrada por cambio en lugar de la tabla (directrices-pwa-movil.md, sección 2). *@
    <ul class="list-group d-md-none mb-3">
        @foreach (var change in Model.View.History)
        {
            <li class="list-group-item py-3">
                <div class="fw-semibold">@VitalSignRangeDisplay.Label(change.Code)</div>
                <div class="small">
                    @(change.PreviousMin is null && change.PreviousMax is null ? "Sin rango" : $"{Limit(change.PreviousMin)} – {Limit(change.PreviousMax)}")
                    → @(change.NewMin is null && change.NewMax is null ? "Sin rango" : $"{Limit(change.NewMin)} – {Limit(change.NewMax)}")
                </div>
                <div class="text-body-secondary small">
                    @change.ChangedAt.ToLocalTime().ToString("g") · @SystemProfileDisplay.Label(change.ChangedByProfile)@(change.ChangedByCurrentAccount ? " (tú)" : "")
                </div>
            </li>
        }
    </ul>
    <div class="table-responsive d-none d-md-block">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Constante</th>
                    <th scope="col">Antes (mín. – máx.)</th>
                    <th scope="col">Después (mín. – máx.)</th>
                    <th scope="col">Cambiado por</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var change in Model.View.History)
                {
                    <tr>
                        <td>@change.ChangedAt.ToLocalTime().ToString("g")</td>
                        <td>@VitalSignRangeDisplay.Label(change.Code)</td>
                        <td>@(change.PreviousMin is null && change.PreviousMax is null ? "Sin rango" : $"{Limit(change.PreviousMin)} – {Limit(change.PreviousMax)}")</td>
                        <td>@(change.NewMin is null && change.NewMax is null ? "Sin rango" : $"{Limit(change.NewMin)} – {Limit(change.NewMax)}")</td>
                        <td>@SystemProfileDisplay.Label(change.ChangedByProfile)@(change.ChangedByCurrentAccount ? " (tú)" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

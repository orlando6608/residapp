@using ResidApp.Domain.Residents
@using ResidApp.Web.Models
@model HealthBackgroundCardModel
@* Ficha de antecedentes de salud, fases 1 y 2: alergias e intolerancias a medicamentos (script 0094) y enfermedades e intervenciones (script 0096). La ven Enfermería y
   Medicina; la cambian con el permiso que da Administración. «Pendiente», «No refiere» y «No consta» se dicen distinto, y la ficha no dice «revisado»: dice cuándo y quién la
   modificó por última vez. Un apartado ilegible no oculta al otro. *@
@{
    var allergies = Model.View.Allergies;
    var conditions = Model.View.Conditions;
    var canEdit = Model.View.CanEdit;
}
<section class="card mb-3" aria-labelledby="antecedentes-titulo">
    <div class="card-body">
        <h2 class="h5 card-title" id="antecedentes-titulo">Antecedentes de salud</h2>

        <h3 class="h6">@HealthBackgroundDisplay.AllergiesTitle</h3>
        @if (Model.View.UnreliableVersion is not null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Ficha con error: este dato no es fiable.</strong> La última versión guardada de las alergias está incompleta, así que no se enseña
                ni se imprime en el informe de derivación. Contrasta con el residente o su familia y con la hoja de tratamiento oficial del centro@(canEdit ? ", y vuelve a rellenar las alergias: se guardará como una versión nueva que la corrige." : ". Avisa a quien pueda rellenarla.")
            </div>
        }
        else if (allergies is null)
        {
            <p><span class="badge text-bg-warning">Pendiente</span> @HealthBackgroundDisplay.Pending</p>
        }
        else
        {
            <p class="mb-2">@HealthBackgroundDisplay.State(allergies.Content.State)</p>
            @if (allergies.Content.Items.Count > 0)
            {
                <ul class="mb-2">
                    @foreach (var item in allergies.Content.Items)
                    {
                        <li>@HealthBackgroundDisplay.Item(item)</li>
                    }
                </ul>
            }
            @if (HealthBackgroundDisplay.Source(allergies.Content.Source) is { } source)
            {
                <p class="mb-1">@source</p>
            }
            <p class="text-muted small mb-2">@HealthBackgroundDisplay.LastModified(allergies)</p>
        }
        @if (canEdit)
        {
            <a asp-controller="FichaAntecedentes" asp-action="Alergias" asp-route-residenteId="@Model.ResidentId" class="btn btn-outline-primary btn-lg w-100 mt-2">
                @(allergies is null && Model.View.UnreliableVersion is null ? "Rellenar las alergias" : "Cambiar las alergias")
            </a>
        }

        <hr />
        <h3 class="h6">@HealthBackgroundDisplay.ConditionsTitle</h3>
        @if (Model.View.UnreliableConditionsVersion is not null)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Ficha con error: este dato no es fiable.</strong> La última versión guardada de las enfermedades e intervenciones está incompleta, así que no se enseña
                ni se imprime en el informe de derivación. Contrasta con el residente o su familia y con la documentación clínica del centro@(canEdit ? ", y vuelve a rellenarlas: se guardará como una versión nueva que la corrige." : ". Avisa a quien pueda rellenarla.")
            </div>
        }
        else if (conditions is null)
        {
            <p><span class="badge text-bg-warning">Pendiente</span> @HealthBackgroundDisplay.ConditionsPending</p>
        }
        else
        {
            <p class="mb-2">@HealthBackgroundDisplay.ConditionsState(conditions.Content.State)</p>
            @if (conditions.Content.Items.Count > 0)
            {
                <ul class="mb-2">
                    @foreach (var item in conditions.Content.Items)
                    {
                        <li>@HealthBackgroundDisplay.ConditionLine(item)</li>
                    }
                </ul>
            }
            @if (HealthBackgroundDisplay.Source(conditions.Content.Source) is { } conditionsSource)
            {
                <p class="mb-1">@conditionsSource</p>
            }
            <p class="text-muted small mb-2">@HealthBackgroundDisplay.ConditionsLastModified(conditions)</p>
        }
        @if (canEdit)
        {
            <a asp-controller="FichaAntecedentes" asp-action="Enfermedades" asp-route-residenteId="@Model.ResidentId" class="btn btn-outline-primary btn-lg w-100 mt-2">
                @(conditions is null && Model.View.UnreliableConditionsVersion is null ? "Rellenar las enfermedades e intervenciones" : "Cambiar las enfermedades e intervenciones")
            </a>
        }
        else
        {
            <p class="text-muted small mb-0 mt-2">Para rellenar o cambiar la ficha hace falta el permiso «Rellenar y cambiar la ficha de antecedentes de salud»: pídeselo a Administración.</p>
        }
    </div>
</section>

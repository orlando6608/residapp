@model ResidApp.Web.Models.HojaInvitacionViewModel
@{
    var recuperacion = Model.Tipo == ResidApp.Domain.Accounts.AccessInvitationKind.Recuperacion;
    ViewData["Title"] = recuperacion ? "Invitación de recuperación" : "Invitación de acceso";
    var nombre = string.IsNullOrWhiteSpace(Model.Nombre) ? Model.Usuario : Model.Nombre;
}

<div class="alert alert-warning d-print-none" role="alert">
    <strong>Esta hoja solo se enseña ahora.</strong> Imprímela o enséñale la pantalla a la persona para que escanee el código, y
    entrégasela en mano: con ella entra en su cuenta. Si se pierde, crea otra: la nueva anula esta.
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">@ViewData["Title"] para @nombre</h1>
                <dl class="row mb-3">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8"><code class="text-break">@Model.Usuario</code></dd>
                    <dt class="col-sm-4">Centro</dt>
                    <dd class="col-sm-8">@Model.Centro</dd>
                    <dt class="col-sm-4">Vale hasta</dt>
                    <dd class="col-sm-8">@Model.CaducaEnUtc.ToLocalTime().ToString("dddd d 'de' MMMM, HH:mm") (una sola vez)</dd>
                </dl>

                <div class="row g-4 align-items-center">
                    <div class="col-12 col-sm-auto text-center">
                        @* Fondo blanco también en oscuro: un QR sobre fondo oscuro no lo leen todas las cámaras. *@
                        <div id="qr-invitacion" class="p-3 bg-white d-inline-block rounded" data-direccion="@Model.Direccion"
                             role="img" aria-label="Código QR de la invitación"></div>
                    </div>
                    <div class="col-12 col-sm">
                        <ol class="mb-0">
                            <li class="mb-2">Escanea el código con la cámara del móvil, o escribe en el navegador la dirección de abajo.</li>
                            <li class="mb-2">Elige tu contraseña (al menos 12 caracteres).</li>
                            @if (!recuperacion)
                            {
                                <li class="mb-2">Si trabajas en el centro, prepara el código del móvil con una aplicación de autenticación y
                                    guarda los códigos de recuperación que te dará.</li>
                            }
                            else
                            {
                                <li class="mb-2">Si trabajas en el centro, vuelve a preparar el código del móvil: el anterior deja de valer, y
                                    también la contraseña anterior y las sesiones abiertas.</li>
                            }
                        </ol>
                    </div>
                </div>

                <p class="mt-3 mb-1 small text-muted">Dirección de la invitación:</p>
                <p class="font-monospace small text-break mb-0">@Model.Direccion</p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3 d-print-none">
            <button type="button" class="btn btn-primary btn-lg" id="imprimir-invitacion">Imprimir</button>
            <a href="@Model.Volver" class="btn btn-outline-secondary btn-lg">Volver</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/qrcodejs/qrcode.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            var caja = document.getElementById('qr-invitacion');
            if (caja && window.QRCode) {
                new QRCode(caja, { text: caja.dataset.direccion, width: 192, height: 192, correctLevel: QRCode.CorrectLevel.M });
            } else if (caja) {
                caja.hidden = true;
            }
            document.getElementById('imprimir-invitacion').addEventListener('click', function () { window.print(); });
        })();
    </script>
}

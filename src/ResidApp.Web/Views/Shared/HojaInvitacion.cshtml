@model ResidApp.Web.Models.HojaInvitacionViewModel
@inject ResidApp.Application.Ports.FamilyAccessPolicy FamilyAccess
@{
    var recuperacion = Model.Tipo == ResidApp.Domain.Accounts.AccessInvitationKind.Recuperacion;
    ViewData["Title"] = recuperacion ? "Invitación de recuperación" : "Invitación de acceso";
    var nombre = string.IsNullOrWhiteSpace(Model.Nombre) ? Model.Usuario : Model.Nombre;
}

<div class="alert alert-warning d-print-none" role="alert">
    <strong>Esta hoja solo se enseña ahora.</strong> Imprímela o enséñale la pantalla a la persona para que escanee el código, y
    entrégasela en mano: con ella entra en su cuenta. Si se pierde, crea otra: la nueva anula esta.
</div>

<div class="row justify-content-center">
    <div class="hoja-invitacion col-12 col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">@ViewData["Title"] para @nombre</h1>
                <dl class="row mb-3">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8"><code class="text-break">@Model.Usuario</code></dd>
                    <dt class="col-sm-4">Centro</dt>
                    <dd class="col-sm-8">@Model.Centro <partial name="_EtiquetaTipoServicio" model="Model.TipoDeServicio" /></dd>
                    <dt class="col-sm-4">Vale hasta</dt>
                    <dd class="col-sm-8">@CenterTime.Local(Model.CaducaEnUtc).ToString("dddd d 'de' MMMM, HH:mm") (una sola vez)</dd>
                </dl>

                <div class="row g-4 align-items-center">
                    <div class="col-12 col-sm-auto text-center">
                        @* Fondo blanco también en oscuro: un QR sobre fondo oscuro no lo leen todas las cámaras. *@
                        <div id="qr-invitacion" class="p-3 bg-white d-inline-block rounded" data-direccion="@Model.Direccion"
                             role="img" aria-label="Código QR de la invitación"></div>
                    </div>
                    <div class="col-12 col-sm">
                        <ol class="mb-0">
                            <li class="mb-2">Escanea el código con la cámara del móvil, o escribe en el navegador la dirección de abajo.</li>
                            <li class="mb-2">Elige tu contraseña (al menos 12 caracteres).</li>
                            @if (!recuperacion)
                            {
                                <li class="mb-2">Si trabajas en el centro, prepara el código del móvil con una aplicación de autenticación y
                                    guarda los códigos de recuperación que te dará.</li>
                            }
                            else
                            {
                                <li class="mb-2">Si trabajas en el centro, vuelve a preparar el código del móvil: el anterior deja de valer, y
                                    también la contraseña anterior y las sesiones abiertas.</li>
                            }
                            @if (FamilyAccess.EmailCode)
                            {
                                <li class="mb-2">Si eres familiar, para entrar necesitas además un código que te llega cada vez al correo de tu ficha.
                                    Usa en ResidApp una contraseña distinta de la de tu correo.</li>
                            }
                        </ol>
                    </div>
                </div>

                <p class="mt-3 mb-1 small text-muted">Dirección de la invitación:</p>
                <p class="font-monospace small text-break mb-0" id="direccion-invitacion">@Model.Direccion</p>
                <div class="d-print-none d-flex flex-wrap align-items-center gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-lg" id="copiar-direccion" hidden>Copiar dirección</button>
                    <span id="copiar-direccion-estado" role="status"></span>
                </div>

                @* Información breve de protección de datos (LOPDGDD art. 11), borrador por validar: docs/privacidad/codigo-acceso-familiar-por-correo.md. La hoja no sabe si es de una
                   familia, así que empieza por «Si eres familiar»; teléfono, delegado y autoridad del centro no están en la aplicación y no se inventan. *@
                @if (FamilyAccess.EmailCode)
                {
                    <section class="hoja-datos-familia border-top mt-3 pt-3 small" aria-labelledby="datos-familia">
                        <h2 class="h6" id="datos-familia">Si eres familiar: qué hacemos con tus datos</h2>
                        <ul class="mb-0">
                            <li><strong>Responsable:</strong> @Model.Centro. ResidApp trata tus datos por su cuenta.</li>
                            <li><strong>Tu correo</strong> se usa para enviarte el código de cada entrada, para avisarte si se cambia esa dirección y, si el centro la ha confirmado contigo y no te has dado de baja, para avisos sobre citas.</li>
                            <li>Para proteger tu cuenta se anota cuándo entras y desde qué dirección IP (el número que identifica tu conexión).</li>
                            <li>Puedes dejar de recibir los avisos sin perder el acceso: pídeselo al centro. Sin correo no se puede usar el portal; el centro te atiende en persona o por teléfono.</li>
                            <li><strong>Tus derechos</strong> (ver, corregir o borrar tus datos y oponerte a su uso, entre otros): dirígete a @Model.Centro. Pregunta allí por su delegado de protección de datos y por la autoridad ante la que puedes reclamar.</li>
                            <li class="text-break">Más información: @Url.Action("Privacy", "Home", null, Context.Request.Scheme)</li>
                        </ul>
                    </section>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3 d-print-none">
            <button type="button" class="btn btn-primary btn-lg" id="imprimir-invitacion">Imprimir</button>
            <a href="@Model.Volver" class="btn btn-outline-secondary btn-lg">Volver</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/qrcodejs/qrcode.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            var caja = document.getElementById('qr-invitacion');
            if (caja && window.QRCode) {
                new QRCode(caja, { text: caja.dataset.direccion, width: 192, height: 192, correctLevel: QRCode.CorrectLevel.M });
            } else if (caja) {
                caja.hidden = true;
            }
            document.getElementById('imprimir-invitacion').addEventListener('click', function () { window.print(); });

            // El botón solo aparece si el navegador deja copiar; la dirección sigue a la vista para copiarla a mano.
            var copiar = document.getElementById('copiar-direccion');
            if (navigator.clipboard) {
                copiar.hidden = false;
                copiar.addEventListener('click', function () {
                    var estado = document.getElementById('copiar-direccion-estado');
                    navigator.clipboard.writeText(document.getElementById('direccion-invitacion').textContent.trim()).then(
                        function () { estado.textContent = 'Dirección copiada. Con ella se entra en la cuenta: entrégasela solo a esa persona. No la envíes por correo ni por mensajería.'; },
                        function () { estado.textContent = 'No se ha podido copiar. Selecciona la dirección y cópiala a mano.'; });
                });
            }
        })();
    </script>
}

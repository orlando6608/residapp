@using ResidApp.Shared
@using ResidApp.Domain.Enfermeria
@model ResidApp.Application.Ports.PendingChangeDetail
@{
    // Quién cerró consta en la auditoría del cierre (CJ, 4.2: un escalado lo cierra Medicina, o Enfermería cuando ya se han
    // cumplido las indicaciones). Sin ese dato, la deducción de siempre: un escalado o un evento propio de Medicina, Medicina.
    var cierre = Model.Closure!;
    var cerroMedicina = cierre.ClosedByProfile is { } perfilCierre
        ? perfilCierre == SystemProfile.Medicina
        : Model.Escalation is not null || Model.Origin == ClinicalEventOrigin.EventoMedicina;
    var autor = cierre.ClosedBySystemForDeath ? "por el sistema al dar de baja al residente por fallecimiento"
        : cierre.ClosedByCurrentAccount ? "por ti"
        : cerroMedicina ? "por Medicina"
        : "por otro profesional de Enfermería";
}

<div class="card mb-3 border-start border-4 border-success">
    <div class="card-body">
        <h2 class="h5 card-title">Cierre</h2>
        <p class="mb-2">
            Cerrado @autor
            el @cierre.ClosedAt.ToLocalTime().ToString("g"). Comunicación familiar:
            <strong>@FamilyCommunicationDisplay.Label(cierre.Decision)</strong>.
        </p>
        @if (cierre.Communication is { } comunicacion)
        {
            <p class="mb-1">
                <span class="badge text-bg-light border">@FamilyCommunicationDisplay.Label(comunicacion.Type)</span>
                Pendiente de aprobación · se mostrará como «@FamilyCommunicationChoice.VisibleAuthor»
            </p>
            <p class="mb-0" style="white-space: pre-line">@comunicacion.Text</p>
        }
    </div>
</div>

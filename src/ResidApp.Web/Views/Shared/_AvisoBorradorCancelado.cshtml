@model DateTimeOffset?
@* Aviso a quien creó un borrador de basal que se canceló porque otra persona trasladó al residente de unidad (solo la fecha, sin el contenido del borrador). *@
@if (Model is { } cancelledAt)
{
    <div class="alert alert-warning" role="status">
        Tu borrador de basal de este residente se canceló por un traslado de unidad el @cancelledAt.LocalDateTime.ToString("d").
        El basal se rehace en la unidad de destino.
    </div>
}

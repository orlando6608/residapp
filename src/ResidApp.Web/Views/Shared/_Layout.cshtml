<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A58CA" />
    <title>@ViewData["Title"] - ResidApp</title>
    <script type="importmap"></script>
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" href="~/images/logo.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/residapp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ResidApp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var devSubjectLayout = Context.Request.Cookies[ResidApp.Web.Security.DevSessionIdentityProvider.CookieName];
        var activeScopeLayout = ResidApp.Web.Security.ActiveProfileScopeCookie.Read(Context.Request);
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-residapp border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="" width="28" height="28" />
                    ResidApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Manual">Manual de usuario</a>
                        </li>
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(devSubjectLayout))
                    {
                        <span class="badge text-bg-light">Identidad: @devSubjectLayout</span>
                    }
                    @if (activeScopeLayout is not null)
                    {
                        <span class="badge text-bg-light">
                            Ámbito: @ResidApp.Web.Models.SystemProfileDisplay.Label(activeScopeLayout.Profile) · @activeScopeLayout.CenterName
                        </span>
                        <a asp-controller="ProfileScope" asp-action="Select" class="nav-link">Cambiar ámbito</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ResidApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

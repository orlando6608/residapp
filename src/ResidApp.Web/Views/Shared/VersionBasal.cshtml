@using ResidApp.Domain.Baseline
@using ResidApp.Web.Models
@model BaselineVersionViewModel
@{
    ViewData["Title"] = "Versión del basal";
    // Vista común: asp-action sin asp-controller apunta al controlador en curso (Enfermería o Medicina).
    var perfil = ViewContext.RouteData.Values["controller"] as string == "Medicina" ? "Medicina" : "Enfermería";
    var version = Model.Version;
    var header = version.Header;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@perfil</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-residenteId="@Model.Resident.ResidentId.Value">@Model.Resident.DisplayName</a></li>
        <li class="breadcrumb-item"><a asp-action="Historial" asp-route-residenteId="@Model.Resident.ResidentId.Value">Historial</a></li>
        <li class="breadcrumb-item active" aria-current="page">Basal versión @header.VersionNumber</li>
    </ol>
</nav>

<h1 class="h3">Basal versión @header.VersionNumber — @Model.Resident.DisplayName</h1>
<p class="text-muted">Solo lectura. Una versión firmada no se edita; un error se corrige con una versión nueva.</p>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-2">
            @if (header.IsCurrent)
            {
                <span class="badge text-bg-success">Vigente</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Histórica</span>
            }
        </p>
        <dl class="row mb-0">
            <dt class="col-sm-4">Motivo</dt>
            <dd class="col-sm-8">@BaselineReasonDisplay.Label(header.ReasonCode)</dd>
            <dt class="col-sm-4">Firmado</dt>
            <dd class="col-sm-8">@header.SignedAt.ToLocalTime().ToString("g") por @SystemProfileDisplay.Label(header.SignedByProfile)</dd>
            <dt class="col-sm-4">Sustituye a</dt>
            <dd class="col-sm-8">@(header.ReplacesVersionNumber is { } previous ? $"Versión {previous}" : "—")</dd>
            <dt class="col-sm-4">Fuente de la información</dt>
            <dd class="col-sm-8">
                @EnumDisplay.Label(version.InformationSource)@(version.InformationSourceOtherText is { } other ? $": {other}" : "")
            </dd>
            <dt class="col-sm-4">Fecha de la información</dt>
            <dd class="col-sm-8 mb-0">@version.InformationDate.ToString("d")</dd>
        </dl>
    </div>
</div>

<div class="row g-3 mb-3">
    @foreach (var area in version.Areas.OrderBy(a => a.AreaCode))
    {
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 card-title">@BaselineAreaDisplay.Label(area.AreaCode)</h2>
                    <ul class="mb-0">
                        @foreach (var value in BaselineAreaDisplay.Summarize(area.Answer))
                        {
                            <li>@value</li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(area.Observation))
                    {
                        <p class="text-muted mt-2 mb-0">@area.Observation</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Índice de Barthel: @header.BarthelTotal / 100</h2>
        <p class="text-muted">Valorado el @version.BarthelDate.ToString("d").</p>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Ítem</th>
                        <th scope="col">Opción</th>
                        <th scope="col" class="text-end">Puntos</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in version.BarthelItems)
                    {
                        <tr>
                            <td>@EnumDisplay.Label(item.ItemCode)</td>
                            <td>@BaselineVersionDisplay.BarthelOption(item)</td>
                            <td class="text-end">@item.AwardedScore</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Historial" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">
    Volver al historial
</a>

@using ResidApp.Domain.Platform
@using ResidApp.Shared
@using ResidApp.Web.Models
@model CenterServiceType?
@* Etiqueta del tipo de servicio de un centro (ADR 0017): Residencia o Centro de Día. Siempre con texto, no solo color. Sin tipo (el centro de Plataforma, que no es un servicio) no pinta nada. *@
@if (Model is { } type)
{
    <span class="badge text-bg-light border align-middle" data-tipo-servicio="@type.ToCode()">@CenterServiceTypeDisplay.Label(type)</span>
}

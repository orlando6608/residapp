@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model InformacionReunidaViewModel
@*
    HIS-03: un evento cerrado muestra el basal y la ubicación de su fecha (la instantánea de eventos_contexto), no
    el basal actual. Un evento abierto sigue mostrando el basal vigente, que es el que importa para atenderlo.
*@
<div class="card mb-3">
    <div class="card-body">
        @if (Model.Event.Status == ClinicalEventStatus.Cerrado)
        {
            <h2 class="h5 card-title">Basal y ubicación de la fecha del evento</h2>
            @if (Model.Event.Context is null)
            {
                <p class="text-muted mb-0">Sin datos de contexto.</p>
            }
            else
            {
                <p class="mb-1">@ResidentHistoryDisplay.Baseline(Model.Event.Context)</p>
                <p class="text-muted mb-0">Unidad: @(Model.Event.Context.UnitName ?? "sin ubicación registrada")</p>
                @if (Model.Event.Context.BaselineVersionNumber is { } baselineVersion)
                {
                    <a asp-action="VersionBasal" asp-route-residenteId="@Model.Event.ResidentId.Value" asp-route-version="@baselineVersion"
                       class="btn btn-outline-secondary btn-sm mt-2 me-2">
                        Ver ese basal
                    </a>
                }
            }
        }
        else
        {
            <h2 class="h5 card-title">Basal vigente</h2>
            <partial name="_ResumenBasal" model="Model.Baseline" />
        }
        @* HIS-02: la línea temporal completa del residente, bajo demanda (no se carga hasta que se pide). *@
        <a asp-action="LineaTemporal" asp-route-residenteId="@Model.Event.ResidentId.Value" class="btn btn-outline-secondary btn-sm mt-2">
            Ver línea temporal del residente
        </a>
    </div>
</div>

@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se ha producido un error al procesar la solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Inténtalo de nuevo. Si el problema continúa, comunícalo a Administración indicando el identificador de la solicitud.</p>

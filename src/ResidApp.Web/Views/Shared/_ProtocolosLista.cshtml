@using ResidApp.Web.Models
@model IReadOnlyList<ResidApp.Application.Ports.UrgentProtocolSummary>
@* ENF-11/MED-13: protocolos urgentes activos del perfil en curso, del más antiguo al más reciente. *@

<h1 class="h3">Protocolos urgentes activos</h1>
<p class="text-muted">Compartidos por la unidad. Siguen aquí hasta que el evento se deriva o se cierra.</p>
<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.Count == 0)
{
    <p class="text-muted">No hay protocolos urgentes activos.</p>
}
else
{
    @foreach (var item in Model)
    {
        <a asp-action="Protocolo" asp-route-eventoId="@item.EventId" class="card mb-3 text-decoration-none text-body border-start border-4 border-danger">
            <div class="card-body">
                <h2 class="h5 card-title">@item.ResidentDisplayName</h2>
                <p class="mb-1">
                    <span class="badge @ClinicalEventStatusDisplay.BadgeClass(item.Status, false)">@ClinicalEventStatusDisplay.Label(item.Status)</span>
                    · @(item.UnitName ?? "Sin unidad") · activado el @item.ActivatedAt.ToLocalTime().ToString("g")
                    (@ElapsedTimeDisplay.Since(item.ActivatedAt))
                </p>
                <p class="text-muted mb-0">
                    @if (item.LastEntryType is { } tipo)
                    {
                        <span>Último registro: @UrgentProtocolDisplay.Label(tipo), @item.LastEntryAt!.Value.ToLocalTime().ToString("g")</span>
                    }
                    else
                    {
                        <span>Sin registros todavía</span>
                    }
                </p>
            </div>
        </a>
    }
}

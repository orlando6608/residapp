@using ResidApp.Web.Models
@model EmergencyContactCardModel
@* ADM-08 (0022, 0044): contactos urgentes designados por Administración (puede haber varios), en solo lectura, en la ficha de
   Enfermería y de Medicina (la matriz les da lectura). Un residente puede no tener ninguno, con su motivo (0050). *@

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"contacto"' />@(Model.Contacts?.Contacts.Count > 1 ? "Contactos urgentes" : "Contacto urgente")</h2>
        @if (Model.Contacts is { Contacts.Count: > 0 } contactos)
        {
            foreach (var contacto in contactos.Contacts)
            {
                <p class="mb-1">
                    <strong>@contacto.DisplayName</strong> (@contacto.Relationship) ·
                    <a href="@EmergencyContactDisplay.TelHref(contacto.Phone)">@contacto.Phone</a>
                </p>
            }
        }
        else if (Model.Contacts?.NoContactReason is { } motivo)
        {
            <p class="mb-0">Sin contacto urgente: <span style="white-space: pre-line">@motivo</span></p>
        }
        else
        {
            <p class="text-muted mb-0">No hay contacto urgente designado (lo designa Administración).</p>
        }
    </div>
</div>

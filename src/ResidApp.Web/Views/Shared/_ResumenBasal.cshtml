@model ResidApp.Application.Ports.CurrentBaselineSummary?
@* Resumen del basal vigente: total de Barthel con una barra en color neutro (sin umbrales clínicos de dependencia,
   que tendría que fijar CJ) y fecha de firma. *@
@if (Model is null)
{
    <p class="text-muted mb-0">Sin basal vigente registrado.</p>
}
else
{
    <p class="mb-1">Barthel total: <strong>@Model.BarthelTotal / 100</strong></p>
    <div class="progress mb-2" role="progressbar" aria-label="Índice de Barthel" aria-valuenow="@Model.BarthelTotal"
         aria-valuemin="0" aria-valuemax="100" style="height: 0.5rem">
        <div class="progress-bar bg-secondary" style="width: @(Model.BarthelTotal)%"></div>
    </div>
    <p class="text-muted mb-0">Firmado el @Model.SignedAt.ToLocalTime().ToString("g")</p>
}

@model ResidApp.Web.Models.ResidentPhotoEditorViewModel
@* Foto de identificación (script 0059): la ponen, cambian y quitan Administración y Enfermería. site.js reduce la foto en el navegador antes de
   enviarla; sin JavaScript el servidor solo acepta un JPEG de 1 MB como máximo. *@
<section class="card mb-3" aria-labelledby="foto-residente-titulo">
    <div class="card-body">
        <h2 class="h5 card-title" id="foto-residente-titulo">Foto de identificación</h2>
        <p class="text-muted small">Sirve para reconocer al residente en las listas y en su ficha. No se muestra a las familias.</p>
        @if (TempData["FotoError"] is string fotoError)
        {
            <div class="alert alert-danger" role="alert">@fotoError</div>
        }
        <form asp-controller="FotoResidente" asp-action="Guardar" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Form.ResidenteId" value="@Model.ResidentId" />
            <div class="mb-3">
                <label class="form-label" for="foto-residente-fichero">@(Model.UpdatedAt is null ? "Elige o haz una foto" : "Elige o haz una foto nueva")</label>
                <input class="form-control form-control-lg" type="file" accept="image/*" name="Form.Foto" id="foto-residente-fichero" required
                       data-foto-residente data-foto-vista="foto-residente-vista" />
                <img id="foto-residente-vista" alt="Vista previa de la foto elegida" class="foto-residente foto-residente-grande rounded-3 object-fit-cover mt-2" hidden />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="Form.Consentimiento" value="true" id="foto-residente-consentimiento" required />
                <label class="form-check-label" for="foto-residente-consentimiento">
                    Consta el consentimiento del residente o de su representante para usar esta foto solo para identificarlo.
                </label>
            </div>
            <button type="submit" class="btn btn-outline-primary btn-lg">Guardar foto</button>
        </form>
        @if (Model.UpdatedAt is not null)
        {
            <form asp-controller="FotoResidente" asp-action="Quitar" asp-route-residenteId="@Model.ResidentId" method="post" class="mt-2">
                <button type="submit" class="btn btn-outline-danger btn-lg">Quitar foto</button>
            </form>
        }
    </div>
</section>

@using System.Globalization
@using ResidApp.Web.Models
@model GuiaPerfil
@{
    ViewData["Title"] = "Guía de " + Model.Titulo;
    var sello = Model.RevisadoPara is null ? "Pendiente de revisión de punta a punta" : "Revisado para ResidApp v" + Model.RevisadoPara;
    var fecha = DateOnly.ParseExact(Model.Revisado, "yyyy-MM-dd", CultureInfo.InvariantCulture).ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/css/guia.css" asp-append-version="true" />

<nav aria-label="breadcrumb" class="guia-no-imprimir">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Guía por perfil</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
    </ol>
</nav>

<partial name="_Perfil" model="(Model, false)" />

<div class="perfil-@Model.Slug">
    <p class="guia-sello guia-sello-pantalla">@sello · Estado a @fecha · Guía por perfil: @Model.Titulo</p>
</div>

@* En papel el sello va en el pie de cada página (grupo «impresion-pie» del _Layout), no solo al final. *@
@section PieImpresion {
    <p class="guia-sello mb-0">@sello · Estado a @fecha · Guía por perfil: @Model.Titulo</p>
}

@using ResidApp.Domain.Attendance
@using ResidApp.Web.Models
@model AsistenciaAusenciasViewModel
@* Ausencias programadas (ADR 0019, punto 4): un ingreso, unas vacaciones… registrados por adelantado para no marcar «no vino» cada día. El motivo solo lo ven Enfermería y Medicina. *@
@{
    ViewData["Title"] = "Ausencias programadas";
    var today = Model.Today.ToString("yyyy-MM-dd");
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Asistencia</a></li>
        <li class="breadcrumb-item active" aria-current="page">Ausencias programadas</li>
    </ol>
</nav>

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"planificacion"' />Ausencias programadas</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<p>
    Una ausencia programada avisa de que una persona no vendrá unos días. Esos días salen como «ausencia programada» y no como «sin anotar». Dura @AttendanceRules.MaxAbsenceDays días como máximo
    y el último día cuenta. Si alguien anota ese día que vino o no vino, manda lo anotado.
    @if (Model.CanManage && !Model.CanSeeReason)
    {
        <text>El motivo lo eliges al registrarla, pero después solo lo ven Enfermería y Medicina.</text>
    }
</p>

@if (Model.CanManage)
{
    <section aria-labelledby="registrar-titulo" class="mb-4">
        <h2 class="h5" id="registrar-titulo">Registrar una ausencia</h2>
        <form method="post" asp-action="RegistrarAusencia" class="row g-2 align-items-end" aria-label="Registrar una ausencia programada">
            <div class="col-12 col-md-4">
                <label class="form-label" for="residenteId">Persona</label>
                <select class="form-select form-select-lg" id="residenteId" name="residenteId" required>
                    <option value="">Elige…</option>
                    @foreach (var person in Model.Residents)
                    {
                        <option value="@person.ResidentId.Value" selected="@(Model.ResidentFilter == person.ResidentId.Value)">@person.ResidentName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="desde">Primer día</label>
                <input class="form-control form-control-lg" type="date" id="desde" name="desde" value="@today" required />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" for="hasta">Último día</label>
                <input class="form-control form-control-lg" type="date" id="hasta" name="hasta" value="@today" required />
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label" for="motivo">Motivo</label>
                <select class="form-select form-select-lg" id="motivo" name="motivo" required aria-describedby="@(Model.CanSeeReason ? null : "ayuda-motivo")">
                    <option value="">Elige…</option>
                    @foreach (var reason in Enum.GetValues<AbsenceReason>())
                    {
                        <option value="@reason">@EnumDisplay.Label(reason)</option>
                    }
                </select>
                @if (!Model.CanSeeReason)
                {
                    <div class="form-text" id="ayuda-motivo">Solo lo verán Enfermería y Medicina.</div>
                }
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100">Registrar</button>
            </div>
        </form>
    </section>
}

<h2 class="h5" id="vigentes-titulo">Vigentes y próximas</h2>
@if (Model.Absences.Count == 0)
{
    <div class="alert alert-info" role="status">No hay ausencias programadas vigentes ni próximas.</div>
}
else
{
    <partial name="_ListaAusencias" model='new AsistenciaListaAusenciasViewModel(Model.Absences, Model.CanManage, Model.CanSeeReason, "vigentes-titulo")' />
}

@if (Model.Ended.Count > 0)
{
    <details class="mb-3">
        <summary class="h5 py-2" id="terminadas-titulo">Terminadas (@Model.Ended.Count)</summary>
        <p>
            Su último día ya ha pasado. Anular o acortar una ausencia terminada cambia cómo se leen esos días: los que no tengan nada anotado pasan a «sin anotar». Una ausencia anulada no se recupera:
            hay que registrarla otra vez, con su motivo.
            @if (!Model.CanSeeReason)
            {
                <text>Si no sabes el motivo, pregúntalo a Enfermería antes de anular.</text>
            }
        </p>
        <partial name="_ListaAusencias" model='new AsistenciaListaAusenciasViewModel(Model.Ended, Model.CanManage, Model.CanSeeReason, "terminadas-titulo")' />
    </details>
}

<a class="btn btn-outline-secondary btn-lg" asp-action="Index">Volver a la asistencia</a>

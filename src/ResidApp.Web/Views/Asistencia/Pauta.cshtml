@using ResidApp.Domain.Attendance
@using ResidApp.Web.Models
@model AsistenciaPautaViewModel
@* Pauta de una persona (ADR 0019, punto 5): qué días de la semana se la espera. Sin horas ni jornada; la familia nunca la ve. Solo Administración y Enfermería la cambian. *@
@{
    ViewData["Title"] = "Pauta de asistencia";
    var pattern = Model.Pattern;
    var allVersions = pattern.Versions.Select(v => new PatternVersion(v.Number, v.From, v.DaysMask)).ToList();
    var scheduled = AttendanceRules.ScheduledChanges(allVersions, Model.Today);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Asistencia</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pauta</li>
    </ol>
</nav>

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"planificacion"' />Pauta de @pattern.ResidentName</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status" tabindex="-1" data-foco-aviso>@mensaje</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning" role="status" tabindex="-1" data-foco-aviso>@aviso</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert" tabindex="-1" data-foco-aviso>@error</div>
}

<p>
    La pauta son los días de la semana en que se espera a esta persona. Sirve para saber qué días «toca»: quien viene lunes, miércoles y viernes no está ausente el martes. La familia no la ve.
</p>

@if (pattern.DaysMask == 0)
{
    <div class="alert alert-secondary" role="status">Todavía no tiene pauta: hasta que se fije, se espera a esta persona todos los días.</div>
}
else
{
    <p><strong>Ahora se espera a esta persona:</strong> @AsistenciaDisplay.PatternText(pattern.DaysMask).</p>
}

@if (Model.CanManage)
{
    <form method="post" asp-action="Pauta" aria-label="Fijar la pauta">
        <input type="hidden" name="residenteId" value="@pattern.ResidentId.Value" />
        <input type="hidden" name="version" value="@pattern.Number" />
        <fieldset class="mb-3">
            <legend class="h5">Días en que se espera a esta persona</legend>
            @foreach (var day in AsistenciaDisplay.WeekDays)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dia-@day" name="dias" value="@day"
                           checked="@((pattern.DaysMask & AttendanceRules.Mask(day)) != 0)" />
                    <label class="form-check-label" for="dia-@day">@AsistenciaDisplay.DayName(day)</label>
                </div>
            }
        </fieldset>
        @if (pattern.Versions.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label" for="valeDesde">Vale desde</label>
                <input class="form-control form-control-lg w-auto" type="date" id="valeDesde" name="valeDesde" value="@Model.Today.ToString("yyyy-MM-dd")" aria-describedby="ayuda-vale-desde" />
                <div class="form-text" id="ayuda-vale-desde">
                    Es el primer día en que esta pauta cuenta. Por defecto es hoy. Los días anteriores siguen con la pauta de antes.
                    Si eliges una fecha futura, empezará a contar ese día y hasta entonces sigue la de ahora.
                    Si eliges una fecha pasada, cambiará los días en que se esperaba a esta persona desde esa fecha, y por tanto la lista de personas que llevan varios días sin venir:
                    úsalo solo para corregir un error. Quedará anotado quién lo hizo y cuándo.
                </div>
            </div>
        }
        @if (scheduled.Count > 0)
        {
            <div class="alert alert-warning">
                @foreach (var change in scheduled)
                {
                    <p class="mb-1"><strong>Hay un cambio programado desde el @AsistenciaDisplay.LongDate(change.From, Model.Today):</strong> @AsistenciaDisplay.PatternText(change.DaysMask).</p>
                }
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="sustituirProgramado" name="sustituirProgramado" value="true" aria-describedby="ayuda-sustituir" />
                    <label class="form-check-label" for="sustituirProgramado">Sustituir el cambio programado</label>
                </div>
                <div class="small" id="ayuda-sustituir">
                    Márcala solo si quieres que deje de valer. Hace falta cuando la pauta que guardas empieza ese día o antes; sin marcarla no se guarda.
                </div>
            </div>
        }
        <button type="submit" class="btn btn-primary btn-lg">Guardar la pauta</button>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Volver</a>
    </form>
}
else
{
    <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Volver</a>
}

@if (pattern.Versions.Count > 0)
{
    <section class="mt-4" aria-labelledby="historial-titulo">
        <h2 class="h5" id="historial-titulo">@(Model.CanSeeHistory ? "Pautas anteriores" : "Pauta en vigor y próximos cambios")</h2>
        <ul class="list-unstyled">
            @foreach (var version in pattern.Versions)
            {
                <li class="mb-2">
                    @(version.From == AttendanceRules.FromTheBeginning ? "Desde el principio" : "Desde el " + AsistenciaDisplay.LongDate(version.From, Model.Today)):
                    @AsistenciaDisplay.PatternText(version.DaysMask).
                    @if (AttendanceRules.IsReplaced(allVersions, new PatternVersion(version.Number, version.From, version.DaysMask)))
                    {
                        <span class="badge text-bg-secondary">Sustituida: no cuenta</span>
                    }
                    else if (version.From > Model.Today)
                    {
                        <span class="badge text-bg-info">Todavía no cuenta</span>
                    }
                    <span class="d-block small text-body-secondary">
                        Anotado el @AsistenciaDisplay.LongDate(version.RegisteredOn, Model.Today) por @SystemProfileDisplay.Label(version.RegisteredBy).
                        @if (version.From != AttendanceRules.FromTheBeginning && version.From < version.RegisteredOn)
                        {
                            <text>Con efecto desde una fecha anterior a la del registro.</text>
                        }
                    </span>
                </li>
            }
        </ul>
    </section>
}

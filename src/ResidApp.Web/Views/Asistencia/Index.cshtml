@using ResidApp.Domain.Attendance
@using ResidApp.Shared
@using ResidApp.Web.Models
@model AsistenciaDiaViewModel
@* Asistencia diaria del Centro de Día (ADR 0019): quién vino cada día. Sin hora de llegada. Solo anota quien tiene el permiso; Administración la lee. *@
@{
    ViewData["Title"] = "Asistencia";
    var previous = Model.Day.AddDays(-1);
    var next = Model.Day.AddDays(1);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Asistencia</li>
    </ol>
</nav>

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"planificacion"' />Asistencia del @AsistenciaDisplay.Date(Model.Day)</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (Model.Error is { } listError)
{
    <div class="alert alert-warning" role="alert">@listError</div>
    return;
}

<div class="d-flex flex-wrap align-items-end gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-lg" asp-action="Index" asp-route-fecha="@previous.ToString("yyyy-MM-dd")">Día anterior</a>
    <form method="get" class="d-flex align-items-end gap-2" aria-label="Elegir el día">
        <div>
            <label class="form-label mb-1" for="fecha">Día</label>
            <input class="form-control form-control-lg" type="date" id="fecha" name="fecha" value="@Model.Day.ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-outline-primary btn-lg">Ver</button>
    </form>
    @if (Model.Day < Model.Today)
    {
        <a class="btn btn-outline-secondary btn-lg" asp-action="Index" asp-route-fecha="@next.ToString("yyyy-MM-dd")">Día siguiente</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Hoy</a>
    }
    <a class="btn btn-outline-primary btn-lg ms-lg-auto" asp-action="Ausencias">Ausencias programadas</a>
    @if (Model.Profile == SystemProfile.Administracion)
    {
        <a class="btn btn-outline-primary btn-lg" asp-action="Seguimiento">Lista de seguimiento</a>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Ajustes">Ajustes</a>
    }
</div>

@if (!Model.Active)
{
    <div class="alert alert-warning" role="status">La asistencia está desactivada: puedes consultar lo ya anotado, pero no anotar días nuevos. Administración puede activarla en Ajustes.</div>
}

<p class="text-body-secondary">
    @if (Model.CanRecord)
    {
        <text>Pulsa «Vino», o elige por qué no vino y pulsa «No vino». «Sin anotar» no es «no vino»: es que nadie lo ha anotado todavía.</text>
    }
    else
    {
        <text>Aquí solo ves lo que han anotado Auxiliar, Enfermería y Medicina. «Sin anotar» no es «no vino»: es que nadie lo ha anotado todavía.</text>
    }
</p>

@if (Model.Entries.Count == 0)
{
    <div class="alert alert-info" role="status">No hay personas que anotar en tu ámbito.</div>
}
else
{
    @* Rejilla y no tabla: con campos de formulario no se duplica para el móvil (guía de diseño). En el móvil cada persona se apila: nombre, estado y anotar. *@
    var anchoDato = Model.CanRecord ? "col-md-3" : "col-md-6";
    <div class="row g-2 d-none d-md-flex fw-semibold px-3 mb-1" aria-hidden="true">
        <div class="@anchoDato">Persona</div>
        <div class="@anchoDato">Estado</div>
        @if (Model.CanRecord)
        {
            <div class="col-md-6">Anotar</div>
        }
    </div>
    <ul class="list-group mb-3" aria-label="Asistencia del @AsistenciaDisplay.Date(Model.Day)">
        @foreach (var entry in Model.Entries)
        {
            var rowId = entry.ResidentId.Value.ToString("N");
            <li class="list-group-item">
                <div class="row g-2 align-items-center">
                    <div class="col-12 @anchoDato">
                        <h2 class="h6 mb-0">@entry.ResidentName</h2>
                        @if (entry.UnitName is { } unit)
                        {
                            <span class="d-block small text-body-secondary">@unit</span>
                        }
                        @if (!entry.Expected)
                        {
                            <span class="d-block small text-body-secondary">No toca este día según su pauta</span>
                        }
                        @if (Model.CanManage)
                        {
                            <a class="small" asp-action="Pauta" asp-route-residenteId="@entry.ResidentId.Value">@(entry.HasPattern ? "Cambiar su pauta" : "Fijar su pauta")</a>
                        }
                        else if (entry.HasPattern)
                        {
                            <a class="small" asp-action="Pauta" asp-route-residenteId="@entry.ResidentId.Value">Ver su pauta</a>
                        }
                    </div>
                    <div class="col-12 @anchoDato">
                        <span class="badge @AsistenciaDisplay.StatusBadge(entry.Status)">@AsistenciaDisplay.Status(entry.Status)</span>
                        @if (entry.Mark is { State: AttendanceState.NoAsistio } mark)
                        {
                            <span class="d-block small text-break">
                                @(mark.Cause is { } cause ? EnumDisplay.Label(cause) : string.Empty)@if (Model.CanSeeNote && !string.IsNullOrWhiteSpace(mark.Note)) {<text>: @mark.Note</text>}
                            </span>
                        }
                    </div>
                    @if (Model.CanRecord)
                    {
                        <div class="col-12 col-md-6">
                            <form method="post" asp-action="Anotar" class="row g-2 align-items-end" aria-label="Anotar la asistencia de @entry.ResidentName">
                                <input type="hidden" name="residenteId" value="@entry.ResidentId.Value" />
                                <input type="hidden" name="fecha" value="@Model.Day.ToString("yyyy-MM-dd")" />
                                <div class="col-12 col-sm-auto">
                                    <button type="submit" name="estado" value="@AttendanceState.Asistio" class="btn btn-success btn-lg w-100">Vino</button>
                                </div>
                                <div class="col-12 col-sm">
                                    <label class="form-label mb-1 small" for="causa-@rowId">Por qué no vino</label>
                                    <select class="form-select form-select-lg" id="causa-@rowId" name="causa">
                                        <option value="">Elige…</option>
                                        @foreach (var option in Enum.GetValues<AttendanceCause>())
                                        {
                                            <option value="@option" selected="@(entry.Mark?.Cause == option)">@EnumDisplay.Label(option)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label mb-1 small" for="nota-@rowId">Nota (solo con «Otro motivo»)</label>
                                    <input class="form-control form-control-lg" type="text" id="nota-@rowId" name="nota" maxlength="@AttendanceRules.MaxNoteLength"
                                           value="@(Model.CanSeeNote ? entry.Mark?.Note : null)" autocomplete="off" aria-describedby="ayuda-nota-@rowId" />
                                    <div class="form-text" id="ayuda-nota-@rowId">Solo el motivo, en pocas palabras. No escribas enfermedades, diagnósticos, ingresos ni nombres de otras personas.</div>
                                </div>
                                <div class="col-12 col-sm-auto">
                                    <button type="submit" name="estado" value="@AttendanceState.NoAsistio" class="btn btn-outline-danger btn-lg w-100">No vino</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
}

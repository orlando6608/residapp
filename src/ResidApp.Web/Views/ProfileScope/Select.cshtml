@model ResidApp.Web.Models.SelectProfileScopeViewModel
@{
    ViewData["Title"] = "Seleccionar ámbito";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Seleccionar ámbito</li>
    </ol>
</nav>

<h1 class="h3">Seleccionar ámbito</h1>
@if (Model.Options.Count > 1)
{
    <p class="text-muted">
        Tu cuenta tiene varios ámbitos activos (centro y perfil). Elige con cuál quieres operar; podrás
        cambiarlo en cualquier momento desde "Cambiar ámbito".
    </p>
}

<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.Options.Count == 0)
{
    <div class="card">
        <div class="card-body">
            @* Con error de carga (p. ej. la base de datos no responde) no se sabe si la cuenta tiene ámbitos: solo se
               muestra el error del resumen, no la afirmación de que no los tiene. *@
            @if (ViewData.ModelState.IsValid)
            {
                <p>Tu cuenta no tiene ningún ámbito activo en este momento. Contacta con Administración.</p>
            }
            <div class="d-flex flex-wrap gap-2">
                @if (!ViewData.ModelState.IsValid)
                {
                    <a asp-controller="ProfileScope" asp-action="Select" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-primary">Reintentar</a>
                }
                <a asp-controller="DevAuth" asp-action="Login" class="btn @(ViewData.ModelState.IsValid ? "btn-primary" : "btn-outline-secondary")">Cambiar de identidad</a>
                <form asp-controller="DevAuth" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-secondary">Salir</button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var option in Model.Options)
            {
                <form asp-controller="ProfileScope" asp-action="Select" method="post" class="list-group-item">
                    <input type="hidden" name="profileScopeId" value="@option.ProfileScopeId" />
                    <input type="hidden" name="centerId" value="@option.CenterId" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-primary btn-lg w-100 d-flex justify-content-between align-items-center">
                        <span>@option.CenterName</span>
                        <span class="badge text-bg-light text-dark">@option.ProfileLabel</span>
                    </button>
                </form>
            }
        </div>
    </div>
}

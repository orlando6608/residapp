@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@using ResidApp.Web.Security
@model BaselineDraftDetail
@{
    ViewData["Title"] = "Confirmación y firma del basal";
    var resident = (ScopeResidentSummary)ViewBag.Resident;
    var activeScope = (ActiveProfileScopeCookieValue)ViewBag.ActiveScope;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="Enfermeria" asp-action="Index">Enfermería</a></li>
        <li class="breadcrumb-item"><a asp-action="Draft" asp-route-residenteId="@resident.ResidentId.Value">Estado basal</a></li>
        <li class="breadcrumb-item active" aria-current="page">Confirmación y firma</li>
    </ol>
</nav>

<h1 class="h3">Confirmación y firma — @resident.DisplayName</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Datos comunes</h2>
        <p class="mb-1">Motivo: <strong>@Model.ReasonCode</strong></p>
        <p class="mb-1">Fuente de la información: <strong>@Model.CommonInformationSourceCode</strong></p>
        <p class="mb-0">Fecha de la información: <strong>@Model.CommonInformationDate.ToString("dd/MM/yyyy")</strong></p>
    </div>
</div>

<div class="row g-3 mb-3">
    @foreach (var area in Model.Areas.OrderBy(a => a.AreaCode))
    {
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h6 card-title">@BaselineAreaDisplay.Label(area.AreaCode)</h3>
                    <ul class="mb-0">
                        @foreach (var value in BaselineAreaDisplay.Summarize(area.Answer))
                        {
                            <li>@value</li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(area.Observation))
                    {
                        <p class="text-muted mt-2 mb-0">@area.Observation</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Índice de Barthel</h2>
        <p class="mb-0"><strong>@Model.Barthel.TotalScore / 100</strong> (@Model.Barthel.AssessmentDate?.ToString("dd/MM/yyyy"))</p>
    </div>
</div>

<div class="alert alert-warning">
    Al firmar, esta versión pasa a ser la vigente de forma inmediata. Solo puedes firmarla si tú mismo
    creaste este borrador, con tu mismo perfil.
</div>

<form asp-controller="Baseline" asp-action="Sign" method="post">
    <input type="hidden" name="AmbitoPerfilId" value="@activeScope.ProfileScopeId" />
    <input type="hidden" name="CentroId" value="@activeScope.CenterId" />
    <input type="hidden" name="ResidenteId" value="@resident.ResidentId.Value" />
    <input type="hidden" name="BorradorId" value="@Model.Id.Value" />
    <input type="hidden" name="RevisionBorradorEsperada" value="@Model.DraftRevision" />
    <input type="hidden" name="OperacionId" value="@Guid.NewGuid()" />
    <div class="d-grid d-md-flex justify-content-md-end">
        <button type="submit" class="btn btn-success btn-lg">Firmar estado basal</button>
    </div>
</form>

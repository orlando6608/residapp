@using ResidApp.Domain.Baseline
@using ResidApp.Shared
@model ResidApp.Web.Models.BarthelFormModel
@{
    ViewData["Title"] = "Índice de Barthel";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="@BaselineModuleDisplay.ProfileController(Context.Request)" asp-action="Index">@BaselineModuleDisplay.ProfileLabel(Context.Request)</a></li>
        <li class="breadcrumb-item"><a asp-action="Draft" asp-route-residenteId="@Model.ResidenteId">Estado basal</a></li>
        <li class="breadcrumb-item active" aria-current="page">Índice de Barthel</li>
    </ol>
</nav>

<h1 class="h3">Índice de Barthel</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form asp-controller="EnfermeriaBasal" asp-action="Barthel" method="post">
    <input type="hidden" asp-for="ResidenteId" />

    <div class="card mb-3">
        <div class="card-body">
            <label asp-for="FechaValoracion" class="form-label"></label>
            <input asp-for="FechaValoracion" type="date" class="form-control" style="max-width: 220px;" />
        </div>
    </div>

    @foreach (var item in Enum.GetValues<BarthelItemCode>())
    {
        var seleccionada = Model.Opciones.GetValueOrDefault(item.ToCode());
        <div class="card mb-3">
            <fieldset class="card-body">
                <legend class="h6 card-title">@EnumDisplay.Label(item)</legend>
                @foreach (var opcion in BarthelCatalog.Options[item])
                {
                    var inputId = $"{item.ToCode()}-{opcion.OptionCode}";
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Opciones[@item.ToCode()]" id="@inputId"
                               value="@opcion.OptionCode" data-puntos="@opcion.Score" checked="@(seleccionada == opcion.OptionCode)" />
                        <label class="form-check-label" for="@inputId">@opcion.Label (@opcion.Score puntos)</label>
                    </div>
                }
            </fieldset>
        </div>
    }

    @* Barra fija con el total en vivo (solo la suma: sin bandas de dependencia, que serían umbrales clínicos de CJ).
       Sin JavaScript queda solo el botón; el total se calcula siempre en el servidor al guardar. *@
    <div class="barra-accion">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <p class="mb-0" id="barthel-total" role="status" hidden>
                Total: <strong><span data-total>0</span> / 100</strong>
                <span class="text-body-secondary">· <span data-respondidos>0</span> de @BarthelCatalog.Options.Count ítems</span>
            </p>
            <button type="submit" class="btn btn-primary btn-lg ms-auto">Guardar Barthel</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (() => {
            const total = document.getElementById("barthel-total");
            const radios = [...document.querySelectorAll("input[data-puntos]")];
            const actualizar = () => {
                const marcados = radios.filter(r => r.checked);
                total.querySelector("[data-total]").textContent = marcados.reduce((suma, r) => suma + Number(r.dataset.puntos), 0);
                total.querySelector("[data-respondidos]").textContent = marcados.length;
            };
            radios.forEach(r => r.addEventListener("change", actualizar));
            total.hidden = false;
            actualizar();
        })();
    </script>
}

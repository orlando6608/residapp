@model ResidApp.Web.Models.NewCenterViewModel
@{
    ViewData["Title"] = "Nuevo centro";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Centros</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nuevo centro</li>
    </ol>
</nav>

<h1 class="h3">Nuevo centro</h1>
<p class="text-muted">
    Se crea todo a la vez o nada: el centro, su primera unidad y la cuenta de su primer administrador, que nace activa con el perfil
    Administración y la unidad concedida. Los códigos del centro y de la unidad se generan solos a partir de los nombres y no se
    pueden cambiar después. El identificador de acceso no puede ser el de una cuenta que ya exista.
</p>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="NuevoCentro" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Form.OperacionId" value="@Model.Form.OperacionId" />
            <fieldset class="mb-3">
                <legend class="h5 d-flex align-items-center gap-2"><partial name="_Icono" model='"centros"' />Centro</legend>
                <div class="mb-3">
                    <label asp-for="Form.NombreCentro" class="form-label"></label>
                    <input asp-for="Form.NombreCentro" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Form.NombreCentro" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.ZonaHoraria" class="form-label"></label>
                    <select asp-for="Form.ZonaHoraria" class="form-select form-select-lg" aria-describedby="zona-ayuda">
                        @foreach (var zone in Model.Zones)
                        {
                            <option value="@zone.Code" selected="@(zone.Code == Model.Form.ZonaHoraria)">@zone.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Form.ZonaHoraria" class="text-danger"></span>
                    <div id="zona-ayuda" class="form-text">Decide cómo se ven las horas y qué día es «hoy» en ese centro. La elige quien da de alta el centro; después solo Plataforma puede corregirla.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.TipoDeServicio" class="form-label"></label>
                    <select asp-for="Form.TipoDeServicio" class="form-select form-select-lg" aria-describedby="tipo-servicio-ayuda" required>
                        <option value="">Elige el tipo de servicio</option>
                        @foreach (var type in Enum.GetValues<ResidApp.Domain.Platform.CenterServiceType>())
                        {
                            <option value="@type" selected="@(type == Model.Form.TipoDeServicio)">@ResidApp.Web.Models.CenterServiceTypeDisplay.Label(type)</option>
                        }
                    </select>
                    <span asp-validation-for="Form.TipoDeServicio" class="text-danger"></span>
                    <div id="tipo-servicio-ayuda" class="form-text">Residencia o Centro de Día, según lo que el centro declara en el alta o el contrato. <strong>No se podrá cambiar cuando el centro tenga personas.</strong> Hasta entonces, solo Plataforma puede corregir un error.</div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="Form.ConfirmoTipo" id="tipo-servicio-confirmo" value="true" required @(Model.Form.ConfirmoTipo ? "checked" : "") />
                    <label class="form-check-label" for="tipo-servicio-confirmo">Confirmo que el tipo de servicio elegido es el correcto y que no se podrá cambiar cuando el centro tenga personas.</label>
                    <span asp-validation-for="Form.ConfirmoTipo" class="text-danger d-block"></span>
                </div>
                <partial name="_LogoCentroCampo" model='new ResidApp.Web.Models.LogoCentroCampoViewModel("Form.Logo", "logo-centro-fichero", "Logo del centro (opcional)")' />
                <p class="form-text mt-0">El centro con logo propio lo ve en su encabezado en vez del de ResidApp. Después lo cambia su Administración.</p>
            </fieldset>
            <fieldset class="mb-3">
                <legend class="h5 d-flex align-items-center gap-2"><partial name="_Icono" model='"unidades"' />Primera unidad</legend>
                <div class="mb-3">
                    <label asp-for="Form.NombreUnidad" class="form-label"></label>
                    <input asp-for="Form.NombreUnidad" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Form.NombreUnidad" class="text-danger"></span>
                </div>
            </fieldset>
            <fieldset class="mb-3">
                <legend class="h5 d-flex align-items-center gap-2"><partial name="_Icono" model='"usuarios"' />Primer administrador</legend>
                <div class="mb-3">
                    <label asp-for="Form.IdentificadorAdministrador" class="form-label"></label>
                    <input asp-for="Form.IdentificadorAdministrador" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Form.IdentificadorAdministrador" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.NombreAdministrador" class="form-label"></label>
                    <input asp-for="Form.NombreAdministrador" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Form.NombreAdministrador" class="text-danger"></span>
                </div>
            </fieldset>
            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">Crear centro</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

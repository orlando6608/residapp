@using ResidApp.Application.Ports
@model PlatformCenterDetail
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Centros</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<h1 class="h3">@Model.Name <small class="text-body-secondary"><code>@Model.Code</code></small></h1>
<p class="text-muted">
    Las Administraciones del centro. La <strong>principal</strong> ve todas las unidades del centro y se añade las que no tiene; aquí puedes marcarla o
    quitar la marca, y añadir una unidad al ámbito de cualquier Administración (por ejemplo, para recuperar una unidad sin Administración). Cada cambio
    queda en la auditoría. No se muestran residentes ni contenido clínico.
</p>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Administrations.Count == 0)
{
    <p class="estado-vacio">El centro no tiene ninguna Administración vigente.</p>
}
else
{
    @foreach (var scope in Model.Administrations)
    {
        <section class="card mb-3" aria-labelledby="admin-@scope.ProfileScopeId">
            <div class="card-body">
                <h2 class="h5 card-title" id="admin-@scope.ProfileScopeId">
                    @(scope.AccountName ?? scope.AccountSubject)
                    @if (scope.IsPrincipal)
                    {
                        <span class="badge text-bg-primary align-middle">Principal</span>
                    }
                    @if (!scope.Active)
                    {
                        <span class="badge text-bg-secondary align-middle">Cuenta suspendida</span>
                    }
                </h2>
                <p class="small text-body-secondary">Identificador de acceso: <code>@scope.AccountSubject</code></p>
                <form asp-action="MarcarPrincipal" method="post" class="mb-3">
                    <input type="hidden" name="centroId" value="@Model.CenterId.Value" />
                    <input type="hidden" name="ambitoId" value="@scope.ProfileScopeId" />
                    <input type="hidden" name="principal" value="@(scope.IsPrincipal ? "false" : "true")" />
                    <button type="submit" class="btn @(scope.IsPrincipal ? "btn-outline-danger" : "btn-outline-primary")">
                        @(scope.IsPrincipal ? "Quitar la marca de principal" : "Marcar como Administración principal")
                    </button>
                </form>
                <h3 class="h6">Unidades</h3>
                <ul class="list-group">
                    @foreach (var unit in scope.Units)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span>
                                @unit.Name
                                <span class="badge @(unit.InScope ? "text-bg-success" : "text-bg-secondary") ms-1">@(unit.InScope ? "En su ámbito" : "Fuera de su ámbito")</span>
                            </span>
                            @if (!unit.InScope)
                            {
                                <form asp-action="AnadirUnidad" method="post">
                                    <input type="hidden" name="centroId" value="@Model.CenterId.Value" />
                                    <input type="hidden" name="ambitoId" value="@scope.ProfileScopeId" />
                                    <input type="hidden" name="unidadId" value="@unit.UnitId.Value" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Añadir a su ámbito</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
}

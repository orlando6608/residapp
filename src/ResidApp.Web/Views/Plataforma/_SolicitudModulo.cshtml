@using ResidApp.Domain.Modules
@using ResidApp.Web.Models
@model string
@* La solicitud del centro: lo que prueba cuándo se pidió el cambio y, en una baja, el plazo de apagado del anexo. El modelo es un sufijo para que los ids no se repitan en la página. *@
<fieldset class="mt-3">
    <legend class="h6">Petición del centro</legend>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label class="form-label" for="recibida-@Model">Recibida el (hora de Madrid)</label>
            <input class="form-control form-control-lg" type="datetime-local" id="recibida-@Model" name="SolicitudRecibidaEn" required />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label" for="canal-@Model">Canal</label>
            <select class="form-select form-select-lg" id="canal-@Model" name="Canal" required>
                <option value="">Elige…</option>
                @foreach (var channel in Enum.GetValues<ModuleRequestChannel>())
                {
                    <option value="@channel">@ModuleDisplay.Channel(channel)</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <p class="form-label mb-1">Referencia de la solicitud</p>
            <p class="form-text mt-0">La asigna ResidApp al guardar. Anótala en tu respuesta al centro: así la petición y el registro quedan enlazados.</p>
        </div>
    </div>
</fieldset>

@using ResidApp.Domain.Platform
@using ResidApp.Web.Models
@model PlatformCenterTimeZoneViewModel
@* Zona horaria de un centro (script 0109). La elige quien da de alta el centro; solo Plataforma la corrige, con un motivo de una lista cerrada, habiendo visto lo que se ve afectado. Sin la cuenta de quien la cambió. *@
<section aria-labelledby="zona-titulo" class="mt-5">
    <h2 class="h4" id="zona-titulo">Zona horaria</h2>
    <p class="text-muted">
        La zona horaria decide cómo ve el centro las horas y qué día es «hoy» para él. Todo se guarda en hora universal: cambiarla no toca ningún dato guardado.
        La elige quien da de alta el centro; <strong>después solo Plataforma puede corregirla</strong>, con un motivo, y queda en la auditoría del centro.
    </p>
    <p class="fw-semibold mb-3">Zona actual: <span data-zona-actual="@Model.State.Current.Code">@Model.State.Current.Label</span></p>

    @{
        var others = Model.Zones.Where(zone => zone.Code != Model.State.Current.Code).ToList();
    }
    @if (others.Count == 0)
    {
        <p class="estado-vacio">No hay otra zona disponible a la que cambiar.</p>
    }
    else
    {
        <details class="mb-3">
            <summary class="fw-semibold">Corregir la zona horaria</summary>
            <form asp-action="CambiarZona" method="post" class="mt-3" data-formulario-zona>
                <input type="hidden" name="CentroId" value="@Model.CenterId" />
                <input type="hidden" name="FranjasVistas" value="@Model.State.Impact.Slots" />
                <input type="hidden" name="CitasVistas" value="@Model.State.Impact.Appointments" />
                <div class="mb-3">
                    <label for="zona-nueva" class="form-label">Zona nueva</label>
                    <select id="zona-nueva" name="ZonaHoraria" class="form-select form-select-lg" required>
                        <option value="">Elige una zona</option>
                        @foreach (var zone in others)
                        {
                            <option value="@zone.Code">@zone.Label</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="zona-motivo" class="form-label">Motivo</label>
                    <select id="zona-motivo" name="Motivo" class="form-select form-select-lg" required>
                        <option value="">Elige un motivo</option>
                        @foreach (var reason in Enum.GetValues<CenterTimeZoneChangeReason>())
                        {
                            <option value="@reason">@CenterTimeZoneDisplay.Reason(reason)</option>
                        }
                    </select>
                </div>
                <div class="alert alert-warning" role="status" data-impacto-zona>
                    <p class="mb-2"><strong>Lo que se ve afectado ahora mismo:</strong></p>
                    <ul class="mb-2">
                        <li><strong>@Model.State.Impact.Slots</strong> @(Model.State.Impact.Slots == 1 ? "franja de citas activa" : "franjas de citas activas"): se guardan como hora local («de 10:00 a 12:00»), así que su hora real se mueve con la zona.</li>
                        <li><strong>@Model.State.Impact.Appointments</strong> @(Model.State.Impact.Appointments == 1 ? "cita futura reservada" : "citas futuras reservadas"): no se tocan (están en hora universal), pero se verán a otra hora.</li>
                    </ul>
                    <p class="mb-0">Las horas ya guardadas del centro, en su historial y en su auditoría, también se verán en la zona nueva.</p>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="Confirmo" id="zona-confirmo" value="true" required />
                    <label class="form-check-label" for="zona-confirmo">He visto lo que se ve afectado y confirmo el cambio de zona.</label>
                </div>
                <button type="submit" class="btn btn-primary btn-lg">Cambiar la zona horaria</button>
            </form>
        </details>
    }

    <h3 class="h5 mt-4">Historia de la zona</h3>
    <ul class="list-group">
        @foreach (var change in Model.State.History)
        {
            <li class="list-group-item">
                <span class="fw-semibold">@change.ZoneLabel</span> · @CenterTimeZoneDisplay.ReasonOfCode(change.Reason)
                <span class="small text-body-secondary d-block">@CenterTime.Local(change.ChangedAt).ToString("dd/MM/yyyy HH:mm")@(change.Number > 1 ? $" · afectaba a {change.Confirmed.Slots} franjas y {change.Confirmed.Appointments} citas" : "")</span>
            </li>
        }
        @if (Model.State.History.Count == 0)
        {
            <li class="list-group-item text-body-secondary">Sin cambios: el centro usa la zona de la península, la de siempre.</li>
        }
    </ul>
</section>

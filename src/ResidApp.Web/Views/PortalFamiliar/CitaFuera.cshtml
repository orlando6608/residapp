@using ResidApp.Domain.Appointments
@using ResidApp.Web.Models
@model PortalFamiliarCitaFueraViewModel
@* Detalle de una cita fuera del centro para la familia (PR 5; PR 6: «Me encargo yo», «Ya no puedo» y «No puedo»). El título de la pestaña es genérico: ningún dato de la cita. *@
@{
    var resident = Model.Resident;
    var appointment = Model.Appointment;
    ViewData["Title"] = "Cita fuera del centro";
    var missing = ExternalAppointmentFamilyDisplay.Missing(appointment);
    var preparation = ExternalAppointmentDisplay.Preparation(appointment.Preparation);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-linkId="@resident.LinkId">@resident.ResidentName</a></li>
        <li class="breadcrumb-item"><a asp-action="CitasFuera" asp-route-linkId="@resident.LinkId">Citas fuera del centro</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cita</li>
    </ol>
</nav>

<h1 class="h3">@ExternalAppointmentFamilyDisplay.Title(appointment)</h1>

@if (TempData["Mensaje"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

@if (appointment.Cancelled)
{
    <div class="alert alert-secondary" role="status"><strong>Esta cita está cancelada.</strong> Si tienes dudas, llama por teléfono al centro.</div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Residente</dt><dd class="col-sm-9">@resident.ResidentName</dd>
            <dt class="col-sm-3">Día</dt><dd class="col-sm-9">@ExternalAppointmentFamilyDisplay.Day(appointment.Date)</dd>
            <dt class="col-sm-3">Hora</dt><dd class="col-sm-9">@ExternalAppointmentFamilyDisplay.Time(appointment)</dd>
            @if (!appointment.Cancelled)
            {
                @if (appointment.Place is { } place)
                {
                    <dt class="col-sm-3">Lugar</dt><dd class="col-sm-9">@place</dd>
                }
                @if (preparation is not null)
                {
                    <dt class="col-sm-3">Qué preparar</dt><dd class="col-sm-9">@preparation</dd>
                }
                <dt class="col-sm-3">Transporte</dt><dd class="col-sm-9">@ExternalAppointmentFamilyDisplay.Transport(appointment)</dd>
                <dt class="col-sm-3">Acompañante</dt><dd class="col-sm-9">@ExternalAppointmentFamilyDisplay.Companion(appointment)</dd>
                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    @if (missing is null)
                    {
                        <span class="badge text-bg-success">Transporte y acompañante resueltos</span>
                    }
                    else
                    {
                        <span class="badge text-bg-warning">@missing</span>
                    }
                </dd>
            }
        </dl>
    </div>
</div>

@if (!appointment.Cancelled && (appointment.FamilyCanAct(ExternalArrangementScope.Transporte) || appointment.FamilyCanAct(ExternalArrangementScope.Acompanante)))
{
    <section class="card mb-3" aria-labelledby="ayuda-titulo">
        <div class="card-body">
            <h2 class="h5" id="ayuda-titulo">¿Puedes ayudar?</h2>
            <p class="small text-body-secondary">
                Si pulsas «Me encargo yo», el personal del centro verá tu nombre. Otros familiares solo verán que lo hará un familiar. El centro no te llamará solo por esto: las citas no son un canal urgente.
                Es un aviso para el centro y no sustituye al teléfono: el centro lo confirmará por su cuenta.
            </p>
            @foreach (var scope in new[] { ExternalArrangementScope.Transporte, ExternalArrangementScope.Acompanante })
            {
                var part = scope == ExternalArrangementScope.Transporte ? "del transporte" : "del acompañamiento";
                @if (appointment.LapsedOf(scope))
                {
                    <p class="alert alert-warning py-2" role="status">Te habías encargado @part, pero la cita ha cambiado y ya no cuenta. Si puedes, vuelve a ofrecerte.</p>
                }
                @if (appointment.CanTake(scope))
                {
                    <form method="post" asp-action="CitaFueraAccion" asp-route-linkId="@resident.LinkId" asp-route-citaId="@appointment.Id" class="mb-2">
                        <input type="hidden" name="ambito" value="@scope" />
                        <input type="hidden" name="accion" value="@FamilyArrangementAction.Take" />
                        <button type="submit" class="btn btn-primary btn-lg">Me encargo yo @part</button>
                    </form>
                }
                else if (appointment.CanRelease(scope))
                {
                    <form method="post" asp-action="CitaFueraAccion" asp-route-linkId="@resident.LinkId" asp-route-citaId="@appointment.Id" class="mb-2">
                        <input type="hidden" name="ambito" value="@scope" />
                        <input type="hidden" name="accion" value="@FamilyArrangementAction.Release" />
                        <button type="submit" class="btn btn-outline-secondary btn-lg">Ya no puedo encargarme @part</button>
                    </form>
                }
            }
            @if (appointment.CanRefuse)
            {
                <form method="post" asp-action="CitaFueraAccion" asp-route-linkId="@resident.LinkId" asp-route-citaId="@appointment.Id" class="mb-2">
                    <input type="hidden" name="accion" value="@FamilyArrangementAction.Refuse" />
                    <button type="submit" class="btn btn-outline-secondary btn-lg">No puedo</button>
                </form>
            }
            else if (appointment.Refused)
            {
                <p class="mb-2">Has dicho que no puedes ayudar con esta cita.</p>
                <form method="post" asp-action="CitaFueraAccion" asp-route-linkId="@resident.LinkId" asp-route-citaId="@appointment.Id" class="mb-2">
                    <input type="hidden" name="accion" value="@FamilyArrangementAction.UndoRefuse" />
                    <button type="submit" class="btn btn-outline-secondary btn-lg">Quitar el «No puedo»</button>
                </form>
            }
        </div>
    </section>
}

<p class="small text-body-secondary">
    Esta información la ve quien está autorizado a acompañar a @resident.ResidentName y solo en la medida en que él o ella lo permite. Si crees que no debería verla, avisa al centro.
</p>
<a class="btn btn-outline-secondary" asp-action="CitasFuera" asp-route-linkId="@resident.LinkId">Volver a las citas fuera del centro</a>

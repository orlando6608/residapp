@using ResidApp.Application.Ports
@model IReadOnlyList<FamilyPortalResident>
@{
    ViewData["Title"] = "Mis residentes";
}

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"residentes"' />Mis residentes</h1>
<p class="text-muted">Elige a quién quieres ver. Solo aparecen los residentes para los que el centro te ha dado acceso.</p>
@if (Model.Count == 1)
{
    <div class="alert alert-info" role="status">Solo tienes acceso a un residente, así que no hay otro al que cambiar.</div>
}
<div class="row g-3">
    @foreach (var resident in Model)
    {
        <div class="col-12 col-md-6">
            <a asp-action="Residente" asp-route-linkId="@resident.LinkId" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">@resident.ResidentName</h2>
                    <p class="card-text text-muted mb-0">@resident.Relationship</p>
                    @if (resident.ProposalAwaitingAnswer || resident.NewCommunications > 0)
                    {
                        <p class="card-text mt-2 mb-0 d-flex flex-wrap gap-2">
                            @if (resident.ProposalAwaitingAnswer)
                            {
                                <span class="badge text-bg-primary">Propuesta de cita pendiente</span>
                            }
                            @if (resident.NewCommunications > 0)
                            {
                                <span class="badge text-bg-primary">@(resident.NewCommunications == 1 ? "1 novedad nueva" : $"{resident.NewCommunications} novedades nuevas")</span>
                            }
                        </p>
                    }
                </div>
            </a>
        </div>
    }
</div>
<p class="small text-body-secondary mt-4">Este portal no es un canal urgente. Si necesitas información urgente, llama por teléfono al centro.</p>

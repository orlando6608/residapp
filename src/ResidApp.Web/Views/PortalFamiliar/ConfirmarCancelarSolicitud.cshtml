@using ResidApp.Web.Models
@model PortalFamiliarSolicitudViewModel
@{
    var resident = Model.Resident;
    var request = Model.Request;
    ViewData["Title"] = "Cancelar la solicitud de " + resident.ResidentName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-linkId="@resident.LinkId">@resident.ResidentName</a></li>
        <li class="breadcrumb-item"><a asp-action="Citas" asp-route-linkId="@resident.LinkId">Citas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cancelar</li>
    </ol>
</nav>

<h1 class="h3">¿Cancelar esta solicitud?</h1>
<p>
    @AppointmentDisplay.Label(request.Team) · @AppointmentDisplay.Label(request.Modality) · @AppointmentRequestDisplay.Label(request.Reason).
    Si el centro te había propuesto un horario, ese hueco quedará libre para otras familias. Si luego quieres una cita, tendrás que enviar una solicitud nueva.
</p>
<form asp-action="CancelarSolicitud" asp-route-linkId="@resident.LinkId" asp-route-solicitudId="@request.Id" method="post">
    <button type="submit" class="btn btn-danger btn-lg">Sí, cancelar la solicitud</button>
    <a class="btn btn-outline-secondary btn-lg" asp-action="Solicitud" asp-route-linkId="@resident.LinkId" asp-route-solicitudId="@request.Id">No, mantenerla</a>
</form>

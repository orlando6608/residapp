@using ResidApp.Application.Ports
@using ResidApp.Domain.Appointments
@using ResidApp.Web.Models
@model PortalFamiliarCitaViewModel
@{
    var resident = Model.Resident;
    var appointment = Model.Appointment;
    ViewData["Title"] = "Cita de " + resident.ResidentName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-linkId="@resident.LinkId">@resident.ResidentName</a></li>
        <li class="breadcrumb-item"><a asp-action="Citas" asp-route-linkId="@resident.LinkId">Citas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cita</li>
    </ol>
</nav>

<h1 class="h3">Cita del @AppointmentDisplay.When(appointment.StartsAt)</h1>
<div class="alert alert-warning" role="note">Las citas no son un canal urgente. Si necesitas algo urgente, llama por teléfono al centro.</div>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Residente</dt><dd class="col-sm-9">@resident.ResidentName</dd>
            <dt class="col-sm-3">Con quién</dt><dd class="col-sm-9">@AppointmentDisplay.Label(appointment.Team)</dd>
            <dt class="col-sm-3">Cómo</dt><dd class="col-sm-9">@AppointmentDisplay.Label(appointment.Modality)</dd>
            <dt class="col-sm-3">Cuándo</dt><dd class="col-sm-9">@AppointmentDisplay.When(appointment.StartsAt) – @AppointmentDisplay.Time(appointment.EndsAt)</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @(appointment.Status == AppointmentStatus.Confirmada ? "text-bg-success" : appointment.Status == AppointmentStatus.Finalizada ? "text-bg-secondary" : "text-bg-danger")">@AppointmentDisplay.Label(appointment.Status)</span>
            </dd>
        </dl>
    </div>
</div>

<h2 class="h6">Historial</h2>
<ul class="list-unstyled small text-body-secondary mb-3">
    @foreach (var change in appointment.Changes)
    {
        <li>@AppointmentDisplay.Label(change.Action) el @change.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(change.ByCenter ? " por el centro" : "")</li>
    }
</ul>

@if (appointment.Status == AppointmentStatus.Confirmada)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @if (appointment.CanReschedule)
        {
            <a class="btn btn-outline-primary" asp-action="NuevaCita" asp-route-linkId="@resident.LinkId" asp-route-reprogramar="@appointment.Id">Reprogramar</a>
        }
        @if (appointment.CanCancel)
        {
            <a class="btn btn-outline-danger" asp-action="ConfirmarCancelarCita" asp-route-linkId="@resident.LinkId" asp-route-citaId="@appointment.Id">Cancelar la cita</a>
        }
    </div>
    @if (!appointment.CanCancel)
    {
        <p class="small text-body-secondary">Ya no se puede cambiar desde el portal. Para cambiarla o cancelarla, llama por teléfono al centro.</p>
    }
}
<a class="btn btn-outline-secondary" asp-action="Citas" asp-route-linkId="@resident.LinkId">Volver a mis citas</a>

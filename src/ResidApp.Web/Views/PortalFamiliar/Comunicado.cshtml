@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model PortalFamiliarComunicadoViewModel
@{
    ViewData["Title"] = "Novedad de " + Model.Resident.ResidentName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-linkId="@Model.Resident.LinkId">@Model.Resident.ResidentName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Novedad</li>
    </ol>
</nav>

<h1 class="h3">Novedad sobre @Model.Resident.ResidentName</h1>
<p class="text-muted">
    <span class="badge text-bg-light border">@FamilyCommunicationDisplay.Label(Model.Comunicado.Type)</span>
    · @Model.Comunicado.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @FamilyCommunicationChoice.VisibleAuthor
</p>
<div class="card mb-3">
    <div class="card-body">
        <p class="card-text mb-0" style="white-space: pre-line">@Model.Comunicado.Text</p>
    </div>
</div>
<p class="small text-body-secondary">Este portal no es un canal urgente. Si necesitas información urgente, llama por teléfono al centro.</p>
<a class="btn btn-outline-secondary" asp-action="Residente" asp-route-linkId="@Model.Resident.LinkId">Volver a las novedades</a>

@using ResidApp.Application.Ports
@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model PortalFamiliarComunicadoViewModel
@{
    var item = Model.Comunicado;
    var title = item.Kind switch
    {
        FamilyPortalCommunicationKind.Corrective => "Corrección de una novedad sobre " + Model.Resident.ResidentName,
        _ => "Novedad sobre " + Model.Resident.ResidentName,
    };
    ViewData["Title"] = (item.Kind == FamilyPortalCommunicationKind.Corrective ? "Corrección de " : "Novedad de ") + Model.Resident.ResidentName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-linkId="@Model.Resident.LinkId">@Model.Resident.ResidentName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(item.Kind == FamilyPortalCommunicationKind.Corrective ? "Corrección" : "Novedad")</li>
    </ol>
</nav>

<h1 class="h3">@title</h1>
@if (item.Kind == FamilyPortalCommunicationKind.Withdrawn)
{
    <p class="text-muted">Novedad publicada el @item.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    <div class="alert alert-secondary" role="status">
        Esta novedad ya no está disponible. Si tienes dudas, llama por teléfono al centro.
    </div>
}
else
{
    <p class="text-muted">
        @if (item.Kind == FamilyPortalCommunicationKind.Corrective)
        {
            <span class="badge text-bg-dark">Corrección</span>
        }
        <span class="badge text-bg-light border">@FamilyCommunicationDisplay.Label(item.Type)</span>
        · @item.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @FamilyCommunicationChoice.VisibleAuthor
    </p>
    @if (item.Corrects is { } corrects)
    {
        <p class="small text-body-secondary">
            Corrige la novedad publicada el @corrects.OriginalPublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            <a asp-action="Comunicado" asp-route-linkId="@Model.Resident.LinkId" asp-route-comunicadoId="@corrects.OriginalId">Ver la novedad original</a>
        </p>
    }
    @foreach (var correction in Model.Correcciones)
    {
        <div class="alert alert-warning" role="status">
            <strong>Esta novedad tiene una corrección</strong> publicada el @correction.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            <a class="alert-link" asp-action="Comunicado" asp-route-linkId="@Model.Resident.LinkId" asp-route-comunicadoId="@correction.Id">Ver la corrección</a>
        </div>
    }
    <div class="card mb-3">
        <div class="card-body">
            <p class="card-text mb-0" style="white-space: pre-line">@item.Text</p>
        </div>
    </div>
}
<p class="small text-body-secondary">Este portal no es un canal urgente. Si necesitas información urgente, llama por teléfono al centro.</p>
<a class="btn btn-outline-secondary" asp-action="Residente" asp-route-linkId="@Model.Resident.LinkId">Volver a las novedades</a>

@using ResidApp.Application.Authorization
@using ResidApp.Shared
@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@model ResidApp.Web.Models.DirectionBaselineQueryModel
@{
    ViewData["Title"] = "Consulta de Dirección Clínica";
    var declaracion = ViewBag.Declaracion as ClinicalAccessDeclaration;
    var residentes = ((IReadOnlyList<ResidApp.Application.Ports.ScopeResidentSummary>)ViewBag.Residentes)
        .Select(r => new SelectListItem($"{r.DisplayName} ({r.UnitName})", r.ResidentId.Value.ToString()))
        .ToList();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Consulta de Dirección Clínica</li>
    </ol>
</nav>

<h1 class="h3">Consulta auditada de contenido clínico (Dirección Clínica)</h1>
<p class="text-muted">
    Requiere perfil activo Dirección Clínica con permiso de lectura del detalle clínico; cada consulta
    autorizada queda registrada en la auditoría de forma obligatoria.
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <p>
            Ámbito activo: <strong>@ViewBag.AmbitoPerfilLabel</strong> · @ViewBag.AmbitoCentroNombre
            (<a asp-controller="ProfileScope" asp-action="Select" asp-route-returnUrl="@Url.Action("Direction", "Baseline")">Cambiar ámbito</a>)
        </p>

        <form asp-controller="Baseline" asp-action="Direction" method="post">
            <input type="hidden" asp-for="OperacionId" />

            <div class="mb-3">
                <label asp-for="ResidenteId" class="form-label"></label>
                @if (residentes.Count == 0)
                {
                    <p class="text-muted mb-0">No hay residentes en tu ámbito.</p>
                }
                else
                {
                    <select asp-for="ResidenteId" class="form-select form-select-lg" asp-items="residentes">
                        <option value="">Elige un residente</option>
                    </select>
                }
                <span asp-validation-for="ResidenteId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TipoRecurso" class="form-label"></label>
                <select asp-for="TipoRecurso" class="form-select form-select-lg">
                    @foreach (var tipo in Enum.GetValues<ClinicalResourceType>())
                    {
                        <option value="@tipo.ToCode()">@EnumDisplay.Label(tipo)</option>
                    }
                </select>
            </div>
            @if (declaracion is not null)
            {
                <div class="alert alert-info" role="status">
                    Ya has declarado la finalidad del acceso para este residente
                    (<strong>@EnumDisplay.Label(declaracion.Purpose)</strong>) y vale hasta las
                    <strong>@declaracion.ExpiresAt.ToLocalTime().ToString("HH:mm")</strong>. No hace falta repetirla; cada consulta
                    sigue quedando en la auditoría.
                </div>
            }
            else
            {
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Finalidad del acceso</legend>
                    <div id="finalidad-ayuda" class="form-text mb-2">
                        Elige para qué necesitas ver contenido clínico de este residente. La finalidad y tu justificación valen una hora
                        para todas sus pantallas clínicas y quedan en la auditoría de cada acceso. Si ya la declaraste para este residente
                        en la última hora, puedes dejarlas en blanco.
                    </div>
                    @foreach (var proposito in Enum.GetValues<ClinicalDetailAccessPurpose>())
                    {
                        var id = $"finalidad-{proposito.ToCode()}";
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="Proposito" id="@id" value="@proposito.ToCode()"
                                   checked="@(Model.Proposito == proposito.ToCode())" aria-describedby="@id-desc" />
                            <label class="form-check-label fw-semibold" for="@id">@EnumDisplay.Label(proposito)</label>
                            <div id="@id-desc" class="form-text">@ClinicalDetailAccessPurposeDisplay.Description(proposito)</div>
                        </div>
                    }
                    <span asp-validation-for="Proposito" class="text-danger"></span>
                </fieldset>
                <div class="mb-3">
                    <label asp-for="Justificacion" class="form-label"></label>
                    <div id="justificacion-ayuda" class="form-text mb-1">
                        Describe el motivo concreto sin copiar información clínica ni datos personales innecesarios (hasta 300 caracteres).
                    </div>
                    <textarea asp-for="Justificacion" class="form-control" rows="3" maxlength="300" aria-describedby="justificacion-ayuda"></textarea>
                    <span asp-validation-for="Justificacion" class="text-danger"></span>
                </div>
            }

            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary btn-lg">Consultar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

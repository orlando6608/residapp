@using ResidApp.Application.Authorization
@using ResidApp.Shared
@model ResidApp.Web.Models.DirectionBaselineQueryModel
@{
    ViewData["Title"] = "Consulta de Dirección Clínica";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Consulta de Dirección Clínica</li>
    </ol>
</nav>

<h1 class="h3">Consulta auditada de basal (Dirección Clínica)</h1>
<p class="text-muted">
    Requiere perfil activo Dirección Clínica con permiso de lectura del detalle clínico; cada consulta
    autorizada queda registrada en la auditoría de forma obligatoria.
</p>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-controller="Baseline" asp-action="Direction" method="post">
            <input type="hidden" asp-for="OperacionId" />

            <div class="mb-3">
                <label asp-for="AmbitoPerfilId" class="form-label"></label>
                <input asp-for="AmbitoPerfilId" class="form-control form-control-lg" />
                <span asp-validation-for="AmbitoPerfilId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CentroId" class="form-label"></label>
                <input asp-for="CentroId" class="form-control form-control-lg" />
                <span asp-validation-for="CentroId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ResidenteId" class="form-label"></label>
                <input asp-for="ResidenteId" class="form-control form-control-lg" />
                <span asp-validation-for="ResidenteId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TipoRecurso" class="form-label"></label>
                <select asp-for="TipoRecurso" class="form-select form-select-lg">
                    @foreach (var tipo in Enum.GetValues<ClinicalResourceType>())
                    {
                        <option value="@tipo.ToCode()">@EnumDisplay.Label(tipo)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Proposito" class="form-label"></label>
                <select asp-for="Proposito" class="form-select form-select-lg">
                    @foreach (var proposito in Enum.GetValues<ClinicalDetailAccessPurpose>())
                    {
                        <option value="@proposito.ToCode()">@EnumDisplay.Label(proposito)</option>
                    }
                </select>
                <span asp-validation-for="Proposito" class="text-danger"></span>
            </div>

            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary btn-lg">Consultar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ResidApp.Web.Models.DirectionBaselineQueryModel
@{
    ViewData["Title"] = "Resultado de la consulta";
    var headers = (IReadOnlyList<ResidApp.Application.Ports.AuditedBaselineHeader>)ViewBag.Headers;
}

<h1>Historial de basal auditado</h1>

@if (headers.Count == 0)
{
    <p class="text-muted">No hay versiones de basal registradas para este residente.</p>
}
else
{
    <!-- Escritorio/tablet ancha: tabla. Móvil: lista de tarjetas (directrices-pwa-movil.md, punto 2). -->
    <div class="table-responsive d-none d-md-block">
        <table class="table">
            <thead>
                <tr>
                    <th>Versión</th>
                    <th>Motivo</th>
                    <th>Firmado en</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var header in headers)
                {
                    <tr>
                        <td>@header.VersionNumber</td>
                        <td>@header.ReasonCode</td>
                        <td>@header.SignedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var header in headers)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h5 class="card-title mb-1">Versión @header.VersionNumber</h5>
                    <p class="card-text mb-1"><strong>Motivo:</strong> @header.ReasonCode</p>
                    <p class="card-text text-muted mb-0"><strong>Firmado:</strong> @header.SignedAt</p>
                </div>
            </div>
        }
    </div>
}

<div class="d-grid d-md-block">
    <a asp-controller="Baseline" asp-action="Direction" class="btn btn-secondary btn-lg">Nueva consulta</a>
</div>

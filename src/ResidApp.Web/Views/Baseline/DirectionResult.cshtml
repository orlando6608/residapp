@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@model ResidApp.Web.Models.DirectionBaselineQueryModel
@{
    ViewData["Title"] = "Resultado de la consulta";
    var declaracion = ViewBag.Declaracion as ClinicalAccessDeclaration;
    var headers = (IReadOnlyList<ResidApp.Application.Ports.AuditedBaselineHeader>)ViewBag.Headers;
    var contenido = ViewBag.Content as BaselineVersionDetail;
    var linea = ViewBag.Timeline as IReadOnlyList<TimelineEntry>;
    var cerrados = ViewBag.ClosedEvents as IReadOnlyList<ClosedEventSummary>;
    var correcciones = ViewBag.Amendments as ResidentAmendmentHistory;
    var trazabilidad = ViewBag.Traceability as ClinicalTraceabilityPage;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="Baseline" asp-action="Direction">Consulta de Dirección Clínica</a></li>
        <li class="breadcrumb-item active" aria-current="page">Resultado</li>
    </ol>
</nav>

<h1 class="h3">@(linea is not null ? "Línea temporal auditada" : cerrados is not null ? "Eventos cerrados auditados" : correcciones is not null ? "Correcciones y rectificaciones auditadas" : trazabilidad is not null ? "Trazabilidad clínica auditada" : contenido is null ? "Historial de basal auditado" : "Basal vigente auditado")</h1>

@if (trazabilidad is not null)
{
    <p class="text-muted">
        Solo lectura. Quién hizo qué sobre este residente, según la auditoría: la persona, su perfil, la unidad, la acción, el recurso y la hora. No incluye
        texto clínico ni valores. Esta consulta ha quedado registrada en la auditoría y aparece la primera.
    </p>
    <partial name="_TrazabilidadClinica" model="trazabilidad" />
}
else if (correcciones is not null)
{
    <p class="text-muted">
        Solo lectura. Cada valoración corregida o rectificada se muestra con su versión original, sus correcciones y rectificaciones, el motivo, el
        nombre y perfil de quien las hizo y su fecha. Los basales firmados se muestran como versiones vinculadas, nunca como una edición. Esta consulta ha quedado
        registrada en la auditoría.
    </p>
    <partial name="_CorreccionesRectificaciones" model="correcciones" />
}
else if (linea is not null)
{
    <p class="text-muted">
        Solo lectura, del registro más reciente al más antiguo: eventos de las unidades de tu ámbito con cada paso de su atención,
        versiones del basal y cambios de ubicación. Esta consulta ha quedado registrada en la auditoría.
    </p>
    if (linea.Count == 0)
    {
        <p class="text-muted">Este residente todavía no tiene registros en la línea temporal.</p>
    }
    else
    {
        <partial name="_LineaTemporalLista" model="new TimelineListModel(linea, null)" />
    }
}
else if (cerrados is not null)
{
    <p class="text-muted">
        Solo lectura. Cada evento muestra el basal y la ubicación que estaban vigentes cuando se registró, no los actuales. Esta
        consulta ha quedado registrada en la auditoría.
    </p>
    if (cerrados.Count == 0)
    {
        <p class="text-muted">Este residente no tiene eventos cerrados.</p>
    }
    else
    {
        <partial name="_EventosCerradosLista" model="new ClosedEventsListModel(cerrados, null)" />
    }
}
else if (headers.Count == 0)
{
    <p class="text-muted">Este residente todavía no tiene ningún basal firmado.</p>
}
else if (contenido is not null)
{
    <p class="text-muted">Solo lectura. Esta consulta ha quedado registrada en la auditoría.</p>
    <partial name="_ContenidoVersionBasal" model="contenido" />
}
else
{
    <!-- Escritorio/tablet ancha: tabla. Móvil: lista de tarjetas (directrices-pwa-movil.md, punto 2). -->
    <div class="table-responsive d-none d-md-block">
        <table class="table">
            <thead>
                <tr>
                    <th>Versión</th>
                    <th>Motivo</th>
                    <th>Firmado en</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var header in headers)
                {
                    <tr>
                        <td>@header.VersionNumber</td>
                        <td>@EnumDisplay.Label(header.ReasonCode)</td>
                        <td>@header.SignedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var header in headers)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h5 class="card-title mb-1">Versión @header.VersionNumber</h5>
                    <p class="card-text mb-1"><strong>Motivo:</strong> @EnumDisplay.Label(header.ReasonCode)</p>
                    <p class="card-text text-muted mb-0"><strong>Firmado:</strong> @header.SignedAt</p>
                </div>
            </div>
        }
    </div>
}

@if (declaracion is not null)
{
    <p class="text-body-secondary">
        Finalidad declarada: <strong>@EnumDisplay.Label(declaracion.Purpose)</strong>. Vale hasta las
        <strong>@declaracion.ExpiresAt.ToLocalTime().ToString("HH:mm")</strong> para este residente; cada consulta queda en la auditoría.
    </p>
}
<div class="d-grid d-md-flex gap-2">
    @if (declaracion is not null && Model.ResidenteId is { } residenteId)
    {
        <a asp-controller="Baseline" asp-action="Direction" asp-route-residenteId="@residenteId" class="btn btn-primary btn-lg">Consultar otro recurso de este residente</a>
    }
    <a asp-controller="Baseline" asp-action="Direction" class="btn btn-secondary btn-lg">Nueva consulta</a>
</div>

@model ResidApp.Web.Models.SignBaselineFormModel
@{
    ViewData["Title"] = "Firmar borrador de basal";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Firmar borrador de basal</li>
    </ol>
</nav>

<h1 class="h3">Firmar borrador de basal</h1>
<div class="alert alert-info">
    Esta pantalla firma directamente un borrador ya identificado por sus datos técnicos. Para crear el
    contenido del borrador (las nueve áreas y el índice de Barthel) y llegar aquí ya con los datos
    rellenados, entra por <a asp-controller="Enfermeria" asp-action="Residentes">Enfermería → Residentes</a>
    y abre «Estado basal» sobre el residente correspondiente.
</div>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-controller="Baseline" asp-action="Sign" method="post">
            <input type="hidden" asp-for="OperacionId" />

            <div class="mb-3">
                <label asp-for="AmbitoPerfilId" class="form-label"></label>
                <input asp-for="AmbitoPerfilId" class="form-control form-control-lg" />
                <span asp-validation-for="AmbitoPerfilId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CentroId" class="form-label"></label>
                <input asp-for="CentroId" class="form-control form-control-lg" />
                <span asp-validation-for="CentroId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ResidenteId" class="form-label"></label>
                <input asp-for="ResidenteId" class="form-control form-control-lg" />
                <span asp-validation-for="ResidenteId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BorradorId" class="form-label"></label>
                <input asp-for="BorradorId" class="form-control form-control-lg" />
                <span asp-validation-for="BorradorId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RevisionBorradorEsperada" class="form-label"></label>
                <input asp-for="RevisionBorradorEsperada" type="number" inputmode="numeric" class="form-control form-control-lg" />
                <span asp-validation-for="RevisionBorradorEsperada" class="text-danger"></span>
            </div>

            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-success btn-lg">Firmar estado basal</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ResidApp.Web.Models.AuxiliarRegistroViewModel
@{
    ViewData["Title"] = "Registro cotidiano";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Mis residentes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Registro cotidiano</li>
    </ol>
</nav>

<h1 class="h3">@Model.Resident.DisplayName</h1>
<p class="text-muted">
    @Model.Resident.LocationLabel
    @if (Model.Resident.CerradoHoy)
    {
        <span class="badge text-bg-success align-middle">Turno ya cerrado hoy</span>
    }
</p>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@* Las tres salidas excluyentes del cierre (registro-cotidiano-auxiliar.md) van juntas, arriba y con el mismo peso:
   destacar una empujaría a elegirla. El basal queda debajo, como consulta. *@
<div class="row g-3 mb-3">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Sin cambios</h2>
                <p class="text-muted">Confirma que la situación habitual del residente se mantiene. No genera tarea para Enfermería.</p>
                <form asp-action="SinCambios" method="post" class="mt-auto">
                    <input type="hidden" name="residenteId" value="@Model.Resident.ResidentId.Value" />
                    <input type="hidden" name="operacionId" value="@Model.SinCambiosOperacionId" />
                    <button type="submit" class="btn btn-success btn-lg w-100">Confirmar sin cambios</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Registrar cambio</h2>
                <p class="text-muted">Documenta cambios observados en una o varias áreas y clasifícalos como ordinarios o prioritarios.</p>
                <a asp-action="RegistrarCambio" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-primary btn-lg w-100 mt-auto">
                    Registrar cambio
                </a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">No valorable</h2>
                <p class="text-muted">Indica que no fue posible valorar al residente en este turno. Nunca equivale a estabilidad clínica.</p>
                <form asp-controller="Auxiliar" asp-action="NoValorable" method="post" class="mt-auto">
                    <input type="hidden" name="OperacionId" value="@Model.NoValorableOperacionId" />
                    <input type="hidden" name="ResidenteId" value="@Model.Resident.ResidentId.Value" />
                    <div class="mb-3">
                        <label for="Motivo" class="form-label">Motivo</label>
                        <textarea name="Motivo" id="Motivo" class="form-control" rows="2" required maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="btn btn-warning btn-lg w-100">Marcar no valorable</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h5 card-title">Estado basal vigente</h2>
        <partial name="_ResumenBasal" model="Model.Baseline" />
        <a asp-action="Basal" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg mt-3">
            Consultar estado basal
        </a>
    </div>
</div>

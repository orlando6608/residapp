@using ResidApp.Application.UseCases
@using ResidApp.Domain.Appointments
@using ResidApp.Shared
@using ResidApp.Web.Models
@model AuxiliarExternalAppointments
@* Citas externas del Auxiliar (PR 3): hoy y mañana, de sus residentes asignados. Solo hora, qué preparar, quién acompaña y cómo va: el servidor no devuelve especialidad, lugar, tipo, nota ni nombre
   de familiar (ExternalAppointmentForAuxiliar). *@
@{
    ViewData["Title"] = "Citas externas de hoy y mañana";
    var days = new[] { (Model.Today, "Hoy"), (Model.Today.AddDays(1), "Mañana") };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Mis residentes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Citas externas</li>
    </ol>
</nav>

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"citas"' />Citas externas de hoy y mañana</h1>
<p class="text-muted">Los residentes que salen del centro a una prueba, consulta o tratamiento. Aquí ves a quién, a qué hora y qué hay que preparar.</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@foreach (var (day, label) in days)
{
    var items = Model.Appointments.Where(a => a.Date == day).ToList();
    <section class="mb-4" aria-labelledby="dia-@day.ToString("yyyyMMdd")">
        <h2 class="h5" id="dia-@day.ToString("yyyyMMdd")">@label, @ExternalAppointmentDisplay.Date(day)</h2>
        @if (items.Count == 0)
        {
            <p class="estado-vacio">Ningún residente sale @(label == "Hoy" ? "hoy" : "mañana").</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var item in items)
                {
                    var preparation = ExternalAppointmentDisplay.Preparation(item.Preparation);
                    <li class="list-group-item">
                        <div class="fw-semibold">@(item.Time is { } time ? time.ToString("HH:mm") : "Por confirmar") · @item.ResidentName</div>
                        <div>Qué preparar: @(preparation ?? "nada indicado")</div>
                        <div class="text-body-secondary small">Acompaña: @EnumDisplay.Label(item.CompanionMode) · Transporte: @EnumDisplay.Label(item.TransportMode)</div>
                    </li>
                }
            </ul>
        }
    </section>
}

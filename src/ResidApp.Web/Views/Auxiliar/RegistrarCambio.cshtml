@using ResidApp.Domain.Auxiliar
@using ResidApp.Shared
@using ResidApp.Web.Models
@model RegistrarCambioFormModel
@{
    ViewData["Title"] = "Registrar cambio";
    var resident = (ResidApp.Application.Ports.AssignedResidentSummary)ViewBag.Resident;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Mis residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Registro" asp-route-residenteId="@resident.ResidentId.Value">@resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Registrar cambio</li>
    </ol>
</nav>

<h1 class="h3">Registrar cambio — @resident.DisplayName</h1>
<div asp-validation-summary="All" class="text-danger"></div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form asp-action="RegistrarCambio" method="post">
    <input type="hidden" asp-for="ResidenteId" />
    <input type="hidden" asp-for="OperacionId" />
    @* El aviso directo se escribe en la confirmación; viaja aquí para no perderlo al «Volver a editar». *@
    <input type="hidden" asp-for="AvisoDirecto" />

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Áreas observadas</h2>
            <p class="text-muted">Completa al menos una. Deja vacías las que no correspondan.</p>
            @foreach (var area in Enum.GetValues<DailyChangeAreaCode>())
            {
                var code = area.ToCode();
                var opciones = DailyChangeAreaOptionsCatalog.OptionsFor(area);
                var texto = Model.AreaTexto.GetValueOrDefault(code);
                <fieldset class="mb-4">
                    <legend class="fs-6 fw-semibold mb-2">@DailyChangeAreaDisplay.Label(area)</legend>
                    @if (opciones.Count > 0)
                    {
                        @* Opciones rápidas como botones-chip de 48px en pantalla táctil (guía, 3.2); el input sigue siendo
                           una casilla real con el mismo name y value. *@
                        <div class="d-flex flex-wrap gap-2 mb-1">
                            @foreach (var opcion in opciones)
                            {
                                var opcionCode = opcion.ToCode();
                                var inputId = $"opcion-{code}-{opcionCode}";
                                var entrada = $"{code}:{opcionCode}";
                                <input type="checkbox" class="btn-check" id="@inputId" name="AreaOpciones" value="@entrada" autocomplete="off"
                                       checked="@Model.AreaOpciones.Contains(entrada)" />
                                <label class="btn btn-outline-primary chip" for="@inputId">@DailyChangeAreaOptionDisplay.Label(opcion)</label>
                            }
                        </div>
                        @* Nota opcional bajo demanda; abierta si ya tiene texto (por ejemplo, al volver a editar). *@
                        <details open="@(!string.IsNullOrWhiteSpace(texto))">
                            <summary>Añadir nota</summary>
                            <label for="area-@code" class="form-label visually-hidden">Nota — @DailyChangeAreaDisplay.Label(area)</label>
                            <textarea name="AreaTexto[@code]" id="area-@code" class="form-control" rows="2" maxlength="1000">@texto</textarea>
                        </details>
                    }
                    else
                    {
                        <label for="area-@code" class="form-label visually-hidden">Observaciones — @DailyChangeAreaDisplay.Label(area)</label>
                        <textarea name="AreaTexto[@code]" id="area-@code" class="form-control" rows="2" maxlength="1000"
                                  placeholder="Explica lo sucedido">@texto</textarea>
                    }
                </fieldset>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Temperatura</h2>
            <div class="mb-0">
                <label asp-for="Temperatura" class="form-label"></label>
                <div class="input-group input-group-lg" style="max-width: 220px;">
                    <input asp-for="Temperatura" type="number" step="0.1" inputmode="decimal" class="form-control" />
                    <span class="input-group-text">°C</span>
                </div>
                <span asp-validation-for="Temperatura" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Clasificación</h2>
            <fieldset class="mb-3">
                <legend class="visually-hidden">Clasificación</legend>
                <div class="d-flex flex-wrap gap-2">
                    <input class="btn-check" type="radio" name="Clasificacion" id="clasificacion-ordinario" autocomplete="off"
                           value="@DailyChangeClassification.Ordinario" checked="@(Model.Clasificacion != DailyChangeClassification.Prioritario)" />
                    <label class="btn btn-outline-secondary chip" for="clasificacion-ordinario">Ordinario</label>
                    <input class="btn-check" type="radio" name="Clasificacion" id="clasificacion-prioritario" autocomplete="off"
                           value="@DailyChangeClassification.Prioritario" checked="@(Model.Clasificacion == DailyChangeClassification.Prioritario)" />
                    <label class="btn btn-outline-danger chip" for="clasificacion-prioritario">Prioritario</label>
                </div>
            </fieldset>
            <div class="mb-0">
                <label asp-for="MotivoPrioritario" class="form-label"></label>
                <select asp-for="MotivoPrioritario" class="form-select" asp-items="Html.GetEnumSelectList<DailyChangePriorityReason>()">
                    <option value="">— Solo si es prioritario —</option>
                </select>
                <span asp-validation-for="MotivoPrioritario" class="text-danger"></span>
            </div>
        </div>
    </div>

    @* Barra fija abajo: el formulario es largo y «Continuar» tiene que estar siempre a mano. *@
    <div class="barra-accion">
        <div class="d-grid d-md-flex justify-content-md-end">
            <button type="submit" class="btn btn-primary btn-lg">Continuar</button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

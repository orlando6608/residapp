@model IReadOnlyList<ResidApp.Application.Ports.AssignedResidentSummary>
@{
    ViewData["Title"] = "Mis residentes";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Mis residentes</li>
    </ol>
</nav>

<h1 class="h3">Mis residentes</h1>
<div asp-validation-summary="All" class="text-danger"></div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No tienes residentes asignados.</p>
}
else
{
    <div class="row g-3">
        @foreach (var resident in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                @* La tarjeta entera abre el registro cotidiano: el enlace del nombre se estira sobre ella (guía, 2.B). *@
                <div class="card h-100 border-start border-4 @(resident.TieneBasalVigente ? "border-success" : "border-danger")">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="flex-grow-1">
                            <h2 class="h5 card-title mb-1">
                                <a asp-action="Registro" asp-route-residenteId="@resident.ResidentId.Value" class="stretched-link text-body text-decoration-none">@resident.DisplayName</a>
                            </h2>
                            <p class="card-text text-muted mb-2">@resident.LocationLabel</p>
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge @(resident.TieneBasalVigente ? "text-bg-success" : "text-bg-danger")">
                                    @(resident.TieneBasalVigente ? "Basal vigente" : "Basal pendiente")
                                </span>
                                <span class="badge @(resident.CerradoHoy ? "text-bg-success" : "text-bg-light")">
                                    Cierre cotidiano: @(resident.CerradoHoy ? "Cerrado hoy" : "Pendiente")
                                </span>
                            </div>
                        </div>
                        <span class="fs-3 text-body-secondary" aria-hidden="true">›</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

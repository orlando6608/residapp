@using ResidApp.Shared
@{
    ViewData["Title"] = "ResidApp";
    var devSubject = Context.Request.Cookies[ResidApp.Web.Security.DevSessionIdentityProvider.CookieName];
    // Solo decide qué fichas se enseñan: cada caso de uso sigue autorizando en el servidor.
    var perfil = ResidApp.Web.Security.ActiveProfileScopeCookie.Read(Context.Request)?.Profile;
    var permisos = ViewBag.Permisos as IReadOnlyList<string> ?? [];
}

<h1 class="h3 mb-3">Inicio</h1>

@if (string.IsNullOrWhiteSpace(devSubject))
{
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body p-4 text-center">
                    <img src="~/images/logo.svg" alt="" width="96" height="96" class="mb-3" />
                    <p class="lead mb-2">Sistema integrado de comunicación familiar y registro del estado basal para residencias geriátricas.</p>
                    <p class="text-muted">No hay ninguna identidad de desarrollo activa.</p>
                    <div class="d-grid">
                        <a asp-controller="DevAuth" asp-action="Login" class="btn btn-primary btn-lg">Iniciar sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted">
        Identidad de desarrollo activa: <code>@devSubject</code> —
        <a asp-controller="DevAuth" asp-action="Login">cambiar</a>
    </p>
}

@if (perfil is SystemProfile.Familiar)
{
    <p class="text-muted">Tu perfil todavía no tiene pantallas disponibles.</p>
}

<div class="row g-3">
    @if (perfil is SystemProfile.Plataforma)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Plataforma" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Centros</h2>
                    <p class="card-text text-muted mb-0">Dar de alta un centro con su primera unidad y su administrador.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.Administracion)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Administracion" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Administración</h2>
                    <p class="card-text text-muted mb-0">Residentes, ficha administrativa, historial de ubicación y alta.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.Enfermeria && permisos.Contains(ResidApp.Domain.Accounts.ProfilePermissions.ResidentIdentityCreate))
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Residents" asp-action="Create" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Alta de residente</h2>
                    <p class="card-text text-muted mb-0">Registrar un nuevo residente en el centro.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.DireccionClinica)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Direccion" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Supervisión de Dirección Clínica</h2>
                    <p class="card-text text-muted mb-0">Episodios abiertos por unidad y pendientes, sin contenido clínico.</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a asp-controller="Baseline" asp-action="Direction" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Consulta de Dirección Clínica</h2>
                    <p class="card-text text-muted mb-0">Consulta auditada del historial de basal de un residente.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.Auxiliar)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Auxiliar" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Mis residentes (Auxiliar)</h2>
                    <p class="card-text text-muted mb-0">Registro cotidiano de los residentes asignados.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.Enfermeria)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Enfermeria" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Enfermería</h2>
                    <p class="card-text text-muted mb-0">Residentes del ámbito y su estado basal.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.Medicina)
    {
        <div class="col-12 col-md-4">
            <a asp-controller="Medicina" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Medicina</h2>
                    <p class="card-text text-muted mb-0">Escalados recibidos y eventos propios, valoración médica e indicaciones a Enfermería.</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.DireccionClinica
         && permisos.Contains(ResidApp.Domain.Accounts.ProfilePermissions.ReferenceRangesManage))
    {
        <div class="col-12 col-md-4">
            <a asp-controller="RangosReferencia" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Rangos de referencia de constantes</h2>
                    <p class="card-text text-muted mb-0">Fijar los rangos del centro (Dirección / Coordinación Clínica con permiso).</p>
                </div>
            </a>
        </div>
    }
    @if (perfil is SystemProfile.DireccionClinica
         && permisos.Contains(ResidApp.Domain.Accounts.ProfilePermissions.ProcessDeadlinesManage))
    {
        <div class="col-12 col-md-4">
            <a asp-controller="PlazosProceso" asp-action="Index" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Plazos de los hitos del proceso</h2>
                    <p class="card-text text-muted mb-0">Fijar los plazos del centro para la revisión de calidad de proceso (Dirección / Coordinación Clínica con permiso).</p>
                </div>
            </a>
        </div>
    }
</div>

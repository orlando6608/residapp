@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@model DireccionInicioViewModel
@{
    ViewData["Title"] = "Inicio de Dirección Clínica";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Dirección Clínica</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Dirección Clínica</h1>
<p class="text-muted">
    Supervisión operativa del proceso asistencial por unidad, sin contenido clínico. Cada cifra cuenta episodios abiertos;
    los cerrados no aparecen. No hay ninguna acción asistencial en este perfil; solo puedes publicar un comunicado a la familia antes de su hora.
</p>
<div asp-validation-summary="All" class="text-danger"></div>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a asp-action="Pendientes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"supervision"' />Supervisión de pendientes</h2>
                @* Cifra grande con plural real (guia-diseno-sistema-visual.md, 2.B). Los vencidos van en ámbar, como en
                   Pendientes y Episodio: Dirección supervisa, no actúa clínicamente. *@
                <span class="cifra">@Model.Open</span>
                <span class="text-body-secondary">@(Model.Open == 1 ? "episodio abierto" : "episodios abiertos")</span>
                @if (Model.FollowUpsOverdue > 0)
                {
                    <span class="d-block text-warning-emphasis fw-semibold mt-1">@Model.FollowUpsOverdue @(Model.FollowUpsOverdue == 1 ? "seguimiento pendiente" : "seguimientos pendientes")</span>
                }
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Derivaciones" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"derivaciones"' />Derivaciones a Urgencias</h2>
                <p class="card-text mb-0">En qué punto está cada derivación en curso: protocolo, informe firmado y llamadas a la familia.</p>
            </div>
        </a>
    </div>
    @if (Model.CanReviewQuality)
    {
        <div class="col-12 col-md-4">
            <a asp-action="Indicadores" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"indicadores"' />Indicadores e informe de actividad</h2>
                    <p class="card-text mb-0">Cifras agregadas por unidad y periodo, con su evolución mes a mes y versión para imprimir.</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a asp-action="Calidad" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"calidad"' />Calidad de proceso</h2>
                    <p class="card-text mb-0">Plazos de cada hito del proceso por unidad y periodo, solo cifras: ni residentes ni profesionales.</p>
                </div>
            </a>
        </div>
    }
    <div class="col-12 col-md-4">
        <a asp-action="PeticionesHistorial" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"peticiones"' />Peticiones de historial tras un traslado</h2>
                <p class="card-text mb-0">Quién ha pedido los episodios cerrados de la unidad anterior de un residente trasladado, para qué y cuántas lecturas hizo, sin contenido clínico.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Comunicados" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"comunicados"' />Comunicados a la familia</h2>
                <p class="card-text mb-0">Los comunicados de tu ámbito, la hora a la que se publican y cuándo publicar uno antes.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Ambito" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"ambito"' />Mi ámbito de supervisión</h2>
                <p class="card-text mb-0">Centro, unidades y permisos vigentes de tu perfil activo.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-controller="Baseline" asp-action="Direction" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title d-flex align-items-center gap-2"><partial name="_Icono" model='"basal"' />Consulta auditada del basal</h2>
                <p class="card-text mb-0">Historial de basal de un residente, con registro de auditoría previo.</p>
            </div>
        </a>
    </div>
</div>

<h2 class="h5 d-flex align-items-center gap-2"><partial name="_Icono" model='"unidades"' />Por unidad</h2>
@if (Model.Units.Count == 0)
{
    <p class="text-muted">Tu ámbito de supervisión no tiene unidades.</p>
}
else
{
    @* En pantallas estrechas, una tarjeta por unidad en lugar de la tabla de diez columnas
       (directrices-pwa-movil.md, sección 2). *@
    <div class="d-md-none">
        @foreach (var unit in Model.Units)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h6 card-title">
                        <a asp-action="Pendientes" asp-route-unidad="@unit.UnitId.Value" class="stretched-link">@unit.UnitName</a>
                    </h3>
                    <span class="cifra">@unit.Open</span>
                    <span class="text-body-secondary">@(unit.Open == 1 ? "episodio abierto" : "episodios abiertos")</span>
                    <dl class="row mb-0 mt-2">
                        <dt class="col-8 fw-normal text-body-secondary">Sin valorar</dt>
                        <dd class="col-4 text-end mb-1">@unit.WithoutAssessment de @unit.Open</dd>
                        <dt class="col-8 fw-normal text-body-secondary">En valoración</dt>
                        <dd class="col-4 text-end mb-1">@unit.InAssessment de @unit.Open</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Escalados</dt>
                        <dd class="col-4 text-end mb-1">@unit.Escalated de @unit.Open</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Seguimientos</dt>
                        <dd class="col-4 text-end mb-1">@unit.FollowUps de @unit.Open</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Seguimientos pendientes</dt>
                        <dd class="col-4 text-end mb-1">@unit.FollowUpsOverdue de @unit.FollowUps</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Indicaciones pendientes</dt>
                        <dd class="col-4 text-end mb-1">@unit.IndicationsPending</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Indicaciones no realizadas</dt>
                        <dd class="col-4 text-end mb-1">@unit.IndicationsNotDone</dd>
                        <dt class="col-8 fw-normal text-body-secondary">Protocolos urgentes</dt>
                        <dd class="col-4 text-end mb-0">@unit.UrgentProtocols de @unit.Open</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
    <div class="table-responsive d-none d-md-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Episodios abiertos por unidad, con el total de la unidad como denominador</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad</th>
                    <th scope="col" class="text-end">Abiertos</th>
                    <th scope="col" class="text-end">Sin valorar</th>
                    <th scope="col" class="text-end">En valoración</th>
                    <th scope="col" class="text-end">Escalados</th>
                    <th scope="col" class="text-end">Seguimientos</th>
                    <th scope="col" class="text-end">Pendientes</th>
                    <th scope="col" class="text-end">Indicaciones pendientes</th>
                    <th scope="col" class="text-end">Indicaciones no realizadas</th>
                    <th scope="col" class="text-end">Protocolos urgentes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <th scope="row"><a asp-action="Pendientes" asp-route-unidad="@unit.UnitId.Value">@unit.UnitName</a></th>
                        <td class="text-end">@unit.Open</td>
                        <td class="text-end">@unit.WithoutAssessment de @unit.Open</td>
                        <td class="text-end">@unit.InAssessment de @unit.Open</td>
                        <td class="text-end">@unit.Escalated de @unit.Open</td>
                        <td class="text-end">@unit.FollowUps de @unit.Open</td>
                        <td class="text-end">@unit.FollowUpsOverdue de @unit.FollowUps</td>
                        <td class="text-end">@unit.IndicationsPending</td>
                        <td class="text-end">@unit.IndicationsNotDone</td>
                        <td class="text-end">@unit.UrgentProtocols de @unit.Open</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

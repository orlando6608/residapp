@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@model SupervisionReferralsViewModel
@{
    ViewData["Title"] = "Derivaciones a Urgencias";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Dirección Clínica</a></li>
        <li class="breadcrumb-item active" aria-current="page">Derivaciones</li>
    </ol>
</nav>

<h1 class="h3">Derivaciones a Urgencias</h1>
<p class="text-muted">
    Episodios abiertos de tu ámbito con protocolo urgente (y, si lo pides, los de episodios ya cerrados en el periodo que elijas), del más reciente al más antiguo, y en qué punto está su derivación. Solo el estado
    del proceso: ni el contenido del informe ni las llamadas. El informe firmado se consulta aparte, con finalidad y justificación, y queda registrado en la auditoría. Dirección no genera ni firma informes.
</p>
<div asp-validation-summary="All" class="text-danger"></div>

<form method="get" asp-action="Derivaciones" class="card card-body mb-3" aria-label="Incluir derivaciones de episodios cerrados">
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="cerradas" name="cerradas" value="true" checked="@Model.IncludeClosed" />
        <label class="form-check-label" for="cerradas">Incluir también las de episodios ya cerrados, con el protocolo activado en este periodo</label>
    </div>
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label for="desde" class="form-label">Desde</label>
            <input type="date" class="form-control" id="desde" name="desde" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-3">
            <label for="hasta" class="form-label">Hasta</label>
            <input type="date" class="form-control" id="hasta" name="hasta" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-3 d-grid">
            <button type="submit" class="btn btn-primary">Aplicar</button>
        </div>
    </div>
    <div class="form-text">Sin marcar la casilla solo salen las derivaciones de episodios abiertos. Sin fechas, los últimos 30 días.</div>
</form>

@if (Model.Referrals.Count == 0)
{
    <p class="estado-vacio">@(Model.IncludeClosed ? "No hay derivaciones en curso ni de episodios cerrados en ese periodo." : "No hay derivaciones en curso.")</p>
}
else
{
    <p role="status">
        <span class="badge text-bg-primary">@(Model.Referrals.Count - Model.Closed)</span> en curso ·
        @if (Model.IncludeClosed)
        {
            <span class="badge text-bg-dark">@Model.Closed</span> @:de episodios cerrados ·
        }
        <span class="badge text-bg-secondary">@Model.Signed</span> con informe firmado ·
        <span class="badge text-bg-warning">@Model.Unsigned</span> sin informe firmado ·
        <span class="badge text-bg-secondary">@Model.WithCalls</span> con alguna llamada a la familia registrada
    </p>
    @* En pantallas estrechas, una tarjeta pulsable por derivación en lugar de la tabla (directrices-pwa-movil.md,
       sección 2). *@
    <div class="d-md-none">
        @foreach (var item in Model.Referrals)
        {
            <div class="card mb-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="flex-grow-1">
                        <h2 class="h6 card-title mb-1">
                            @if (item.Closed)
                            {
                                @item.ResidentDisplayName
                                <span class="badge text-bg-dark ms-1">Cerrado</span>
                            }
                            else
                            {
                                <a asp-action="Episodio" asp-route-eventoId="@item.EventId" class="stretched-link text-body text-decoration-none">@item.ResidentDisplayName</a>
                            }
                        </h2>
                        <p class="text-body-secondary small mb-1">@item.UnitName</p>
                        <dl class="row small mb-0">
                            <dt class="col-5 fw-normal text-body-secondary">Protocolo urgente</dt>
                            <dd class="col-7 mb-1">
                                Activado el @item.ProtocolActivatedAt.ToLocalTime().ToString("g") (@ElapsedTimeDisplay.Since(item.ProtocolActivatedAt))
                                · @ProfileLabel(item.ProtocolProfile)
                            </dd>
                            <dt class="col-5 fw-normal text-body-secondary">Informe</dt>
                            <dd class="col-7 mb-1">
                                @if (item.ReportSigned)
                                {
                                    <span class="badge text-bg-success">Firmado</span>
                                    @:el @item.ReportSignedAt!.Value.ToLocalTime().ToString("g") · @ProfileLabel(item.ReportProfile!.Value)
                                    <div><a asp-controller="Baseline" asp-action="Direction" asp-route-residenteId="@item.ResidentId.Value" class="small position-relative z-3">Consultar el informe (con registro en la auditoría)</a></div>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Sin firmar</span>
                                }
                            </dd>
                            <dt class="col-5 fw-normal text-body-secondary">Llamadas a la familia</dt>
                            <dd class="col-7 mb-0">
                                @if (item.FamilyCallAttempts == 0)
                                {
                                    @:Ninguna registrada
                                }
                                else
                                {
                                    @:@item.FamilyCallAttempts · la última el @item.LastCallAt!.Value.ToLocalTime().ToString("g")
                                }
                            </dd>
                        </dl>
                    </div>
                    @if (!item.Closed)
                    {
                        <span class="fs-3 text-body-secondary" aria-hidden="true">›</span>
                    }
                </div>
            </div>
        }
    </div>
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Derivaciones en curso: residente, unidad, protocolo urgente, informe de derivación y llamadas a la familia</caption>
            <thead>
                <tr>
                    <th scope="col">Residente</th>
                    <th scope="col">Unidad</th>
                    <th scope="col">Protocolo urgente</th>
                    <th scope="col">Informe de derivación</th>
                    <th scope="col">Llamadas a la familia</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Referrals)
                {
                    <tr>
                        <td>@item.ResidentDisplayName</td>
                        <td>@item.UnitName</td>
                        <td>
                            Activado el @item.ProtocolActivatedAt.ToLocalTime().ToString("g") (@ElapsedTimeDisplay.Since(item.ProtocolActivatedAt))
                            · @ProfileLabel(item.ProtocolProfile)
                        </td>
                        <td>
                            @if (item.ReportSigned)
                            {
                                <span class="badge text-bg-success">Firmado</span>
                                @:el @item.ReportSignedAt!.Value.ToLocalTime().ToString("g") · @ProfileLabel(item.ReportProfile!.Value)
                                <div><a asp-controller="Baseline" asp-action="Direction" asp-route-residenteId="@item.ResidentId.Value" class="small">Consultar el informe (con registro en la auditoría)</a></div>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Sin firmar</span>
                            }
                        </td>
                        <td>
                            @if (item.FamilyCallAttempts == 0)
                            {
                                @:Ninguna registrada
                            }
                            else
                            {
                                @:@item.FamilyCallAttempts · la última el @item.LastCallAt!.Value.ToLocalTime().ToString("g")
                            }
                        </td>
                        <td>
                            @if (item.Closed)
                            {
                                <span class="badge text-bg-dark">Episodio cerrado el @item.ClosedAt!.Value.ToLocalTime().ToString("g")</span>
                            }
                            else
                            {
                                <a asp-action="Episodio" asp-route-eventoId="@item.EventId" class="btn btn-outline-primary btn-sm">Ver detalle operativo</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    static string ProfileLabel(ResidApp.Shared.SystemProfile profile) => profile == ResidApp.Shared.SystemProfile.Medicina ? "Medicina" : "Enfermería";
}

@using ResidApp.Application.Ports
@using ResidApp.Web.Models
@model SupervisionIndicatorsViewModel
@{
    ViewData["Title"] = "Indicadores de actividad";
    var indicators = Model.Indicators;
    var period = $"del {Model.From:dd/MM/yyyy} al {Model.To:dd/MM/yyyy}";
    List<(string Name, SupervisionIndicatorCounts Counts, bool IsTotal)> rows = indicators is null
        ? []
        : [.. indicators.Units.Select(u => (u.UnitName, u.Counts, false)), ("Total del ámbito", indicators.Total, true)];
    static string Of(int part, int total) => $"{part} de {total}";

    // Barra neutra de la proporción «n de m»: acompaña a la cifra, que es la que lo dice (de ahí aria-hidden). Sin color
    // semafórico: los indicadores no valoran el trabajo de nadie. No se imprime (los navegadores no imprimen fondos).
    void Barra(int part, int total)
    {
        var pct = total == 0 ? 0 : (int)Math.Round(part * 100.0 / total);
        <div class="progress barra-proporcion d-print-none" aria-hidden="true"><div class="progress-bar bg-secondary" style="width: @pct%"></div></div>
    }

    // En pantallas estrechas, una tarjeta por unidad (o por mes) con sus cifras en lugar de una tabla de 4 a 9 columnas
    // (directrices-pwa-movil.md, sección 2). Al imprimir salen las tablas.
    void Ficha(string nombre, bool esTotal, params (string Etiqueta, int Parte, int? De)[] cifras)
    {
        <div class="card mb-2 @(esTotal ? "border-secondary" : null)">
            <div class="card-body py-3">
                <h3 class="h6 card-title mb-2">@nombre</h3>
                <dl class="mb-0">
                    @foreach (var cifra in cifras)
                    {
                        <div class="d-flex justify-content-between align-items-start gap-3 py-1 border-top">
                            <dt class="fw-normal">@cifra.Etiqueta</dt>
                            <dd class="mb-0 text-end text-nowrap fw-semibold">
                                @(cifra.De is int de ? Of(cifra.Parte, de) : cifra.Parte.ToString())
                                @if (cifra.De is int total)
                                {
                                    Barra(cifra.Parte, total);
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    }
}

@* DIR-16: al imprimir solo queda el informe; la navegación, el pie y el formulario no salen. *@
<style>
    @@media print {
        header, footer { display: none !important; }
        .container { max-width: none !important; }
        .table-responsive { overflow: visible !important; }
        .table { font-size: 0.8rem; }
    }
</style>

<nav aria-label="breadcrumb" class="d-print-none">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Dirección Clínica</a></li>
        <li class="breadcrumb-item active" aria-current="page">Indicadores</li>
    </ol>
</nav>

@if (indicators is not null)
{
    <div class="d-none d-print-block mb-3">
        <p class="h4 mb-1">Informe de actividad agregado</p>
        <p class="mb-0">@indicators.CenterName · @string.Join(", ", indicators.Units.Select(u => u.UnitName))</p>
        <p class="mb-0">Periodo @period · generado el @Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</p>
        <p class="mb-0">Solo cifras agregadas: sin datos de residentes ni de profesionales.</p>
    </div>
}

<h1 class="h3">Indicadores de actividad</h1>
<p class="text-muted">
    Cifras agregadas por unidad de tu ámbito para el periodo elegido, con su denominador. No identifican a ningún residente
    ni profesional y no valoran el trabajo de nadie: sirven para ver cómo funciona el proceso.
</p>
<div asp-validation-summary="All" class="text-danger"></div>

<form method="get" asp-action="Indicadores" class="card mb-3 d-print-none">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label for="periodo-desde" class="form-label">Desde</label>
                <input id="periodo-desde" name="desde" type="date" class="form-control form-control-lg" value="@Model.From.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3">
                <label for="periodo-hasta" class="form-label">Hasta</label>
                <input id="periodo-hasta" name="hasta" type="date" class="form-control form-control-lg" value="@Model.To.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-auto d-grid d-md-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg">Aplicar</button>
                @if (indicators is not null)
                {
                    <button type="button" class="btn btn-outline-primary btn-lg" onclick="window.print()">Imprimir / guardar como PDF</button>
                }
            </div>
        </div>
        <p class="form-text mb-0">Las dos fechas se incluyen. Por defecto, los últimos @IndicatorPeriodFilter.DefaultDays días; como máximo, @SupervisionIndicatorRules.MaxPeriodDays.</p>
    </div>
</form>

@if (indicators is not null)
{
    <p><span class="fw-semibold">Periodo @period.</span> <a href="#como-se-cuenta" class="d-print-none">Cómo se cuenta cada cifra</a></p>

    <h2 class="h5">Actividad</h2>
    <div class="d-md-none d-print-none mb-4">
        @foreach (var row in rows)
        {
            var c = row.Counts;
            Ficha(row.Name, row.IsTotal,
                ("Registrados", c.Registered, null),
                ("De Auxiliar", c.FromAuxiliar, c.Registered),
                ("De Enfermería", c.FromNursing, c.Registered),
                ("De Medicina", c.FromMedicine, c.Registered),
                ("Prioritarios", c.Priority, c.Registered),
                ("Cerrados en el periodo", c.Closed, null));
        }
    </div>
    <div class="table-responsive mb-4 d-none d-md-block d-print-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Episodios registrados y cerrados en el periodo, por unidad</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad</th>
                    <th scope="col" class="text-end">Registrados</th>
                    <th scope="col" class="text-end">De Auxiliar</th>
                    <th scope="col" class="text-end">De Enfermería</th>
                    <th scope="col" class="text-end">De Medicina</th>
                    <th scope="col" class="text-end">Prioritarios</th>
                    <th scope="col" class="text-end">Cerrados en el periodo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var c = row.Counts;
                    <tr class="@(row.IsTotal ? "fw-semibold table-group-divider" : null)">
                        <th scope="row">@row.Name</th>
                        <td class="text-end">@c.Registered</td>
                        <td class="text-end">@Of(c.FromAuxiliar, c.Registered)@{ Barra(c.FromAuxiliar, c.Registered); }</td>
                        <td class="text-end">@Of(c.FromNursing, c.Registered)@{ Barra(c.FromNursing, c.Registered); }</td>
                        <td class="text-end">@Of(c.FromMedicine, c.Registered)@{ Barra(c.FromMedicine, c.Registered); }</td>
                        <td class="text-end">@Of(c.Priority, c.Registered)@{ Barra(c.Priority, c.Registered); }</td>
                        <td class="text-end">@c.Closed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5">Escalados y urgencias</h2>
    <div class="d-md-none d-print-none mb-4">
        @foreach (var row in rows)
        {
            var c = row.Counts;
            Ficha(row.Name, row.IsTotal,
                ("Registrados", c.Registered, null),
                ("Escalados a Medicina", c.Escalated, c.Registered),
                ("Con protocolo urgente", c.UrgentProtocols, c.Registered),
                ("Con informe de derivación firmado", c.Referrals, c.Registered));
        }
    </div>
    <div class="table-responsive mb-4 d-none d-md-block d-print-block">
        <table class="table align-middle">
            <caption class="visually-hidden">De los episodios registrados en el periodo, cuántos se escalaron, activaron protocolo urgente o se derivaron, por unidad</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad</th>
                    <th scope="col" class="text-end">Registrados</th>
                    <th scope="col" class="text-end">Escalados a Medicina</th>
                    <th scope="col" class="text-end">Con protocolo urgente</th>
                    <th scope="col" class="text-end">Con informe de derivación firmado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var c = row.Counts;
                    <tr class="@(row.IsTotal ? "fw-semibold table-group-divider" : null)">
                        <th scope="row">@row.Name</th>
                        <td class="text-end">@c.Registered</td>
                        <td class="text-end">@Of(c.Escalated, c.Registered)@{ Barra(c.Escalated, c.Registered); }</td>
                        <td class="text-end">@Of(c.UrgentProtocols, c.Registered)@{ Barra(c.UrgentProtocols, c.Registered); }</td>
                        <td class="text-end">@Of(c.Referrals, c.Registered)@{ Barra(c.Referrals, c.Registered); }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5">Indicaciones médicas</h2>
    <div class="d-md-none d-print-none mb-4">
        @foreach (var row in rows)
        {
            var c = row.Counts;
            Ficha(row.Name, row.IsTotal,
                ("Emitidas", c.IndicationsIssued, null),
                ("Leídas", c.IndicationsRead, c.IndicationsIssued),
                ("Realizadas", c.IndicationsDone, c.IndicationsIssued),
                ("No realizadas", c.IndicationsNotDone, c.IndicationsIssued),
                ("Sin resolver", c.IndicationsUnresolved, c.IndicationsIssued));
        }
    </div>
    <div class="table-responsive mb-4 d-none d-md-block d-print-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Indicaciones médicas emitidas en el periodo y su estado de hoy, por unidad</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad</th>
                    <th scope="col" class="text-end">Emitidas</th>
                    <th scope="col" class="text-end">Leídas</th>
                    <th scope="col" class="text-end">Realizadas</th>
                    <th scope="col" class="text-end">No realizadas</th>
                    <th scope="col" class="text-end">Sin resolver</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var c = row.Counts;
                    <tr class="@(row.IsTotal ? "fw-semibold table-group-divider" : null)">
                        <th scope="row">@row.Name</th>
                        <td class="text-end">@c.IndicationsIssued</td>
                        <td class="text-end">@Of(c.IndicationsRead, c.IndicationsIssued)@{ Barra(c.IndicationsRead, c.IndicationsIssued); }</td>
                        <td class="text-end">@Of(c.IndicationsDone, c.IndicationsIssued)@{ Barra(c.IndicationsDone, c.IndicationsIssued); }</td>
                        <td class="text-end">@Of(c.IndicationsNotDone, c.IndicationsIssued)@{ Barra(c.IndicationsNotDone, c.IndicationsIssued); }</td>
                        <td class="text-end">@Of(c.IndicationsUnresolved, c.IndicationsIssued)@{ Barra(c.IndicationsUnresolved, c.IndicationsIssued); }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5">Continuidad entre turnos</h2>
    <div class="d-md-none d-print-none mb-4">
        @foreach (var row in rows)
        {
            var c = row.Counts;
            Ficha(row.Name, row.IsTotal,
                ("Transferencias de Enfermería recibidas", c.NursingTransfersReceived, c.NursingTransfers),
                ("Transferencias de Medicina recibidas", c.MedicalTransfersReceived, c.MedicalTransfers),
                ("Seguimientos pendientes (fecha prevista pasada)", c.FollowUpsOverdue, c.FollowUpsOpen));
        }
    </div>
    <div class="table-responsive mb-4 d-none d-md-block d-print-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Transferencias de seguimiento registradas en el periodo y cuántas tienen la recepción confirmada, y seguimientos pendientes con la fecha prevista pasada en el periodo, por unidad</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad</th>
                    <th scope="col" class="text-end">Transferencias de Enfermería recibidas</th>
                    <th scope="col" class="text-end">Transferencias de Medicina recibidas</th>
                    <th scope="col" class="text-end">Seguimientos pendientes (fecha prevista pasada)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var c = row.Counts;
                    <tr class="@(row.IsTotal ? "fw-semibold table-group-divider" : null)">
                        <th scope="row">@row.Name</th>
                        <td class="text-end">@Of(c.NursingTransfersReceived, c.NursingTransfers)@{ Barra(c.NursingTransfersReceived, c.NursingTransfers); }</td>
                        <td class="text-end">@Of(c.MedicalTransfersReceived, c.MedicalTransfers)@{ Barra(c.MedicalTransfersReceived, c.MedicalTransfers); }</td>
                        <td class="text-end">@Of(c.FollowUpsOverdue, c.FollowUpsOpen)@{ Barra(c.FollowUpsOverdue, c.FollowUpsOpen); }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5">Evolución mes a mes</h2>
    <p class="text-muted">Totales del ámbito en cada mes del periodo. Los meses de los extremos pueden estar incompletos.</p>
    <div class="d-md-none d-print-none mb-4">
        @foreach (var month in indicators.Months)
        {
            var c = month.Counts;
            Ficha(SupervisionDisplay.MonthLabel(month), false,
                ("Registrados", c.Registered, null),
                ("Cerrados", c.Closed, null),
                ("Escalados", c.Escalated, c.Registered),
                ("Con protocolo urgente", c.UrgentProtocols, c.Registered),
                ("Con derivación", c.Referrals, c.Registered),
                ("Indicaciones emitidas", c.IndicationsIssued, null),
                ("Transferencias recibidas", c.NursingTransfersReceived + c.MedicalTransfersReceived, c.NursingTransfers + c.MedicalTransfers),
                ("Seguimientos pendientes (fecha pasada)", c.FollowUpsOverdue, c.FollowUpsOpen));
        }
    </div>
    <div class="table-responsive mb-4 d-none d-md-block d-print-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Totales del ámbito por mes dentro del periodo</caption>
            <thead>
                <tr>
                    <th scope="col">Mes</th>
                    <th scope="col" class="text-end">Registrados</th>
                    <th scope="col" class="text-end">Cerrados</th>
                    <th scope="col" class="text-end">Escalados</th>
                    <th scope="col" class="text-end">Con protocolo urgente</th>
                    <th scope="col" class="text-end">Con derivación</th>
                    <th scope="col" class="text-end">Indicaciones emitidas</th>
                    <th scope="col" class="text-end">Transferencias recibidas</th>
                    <th scope="col" class="text-end">Seguimientos pendientes (fecha pasada)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in indicators.Months)
                {
                    var c = month.Counts;
                    <tr>
                        <th scope="row">@SupervisionDisplay.MonthLabel(month)</th>
                        <td class="text-end">@c.Registered</td>
                        <td class="text-end">@c.Closed</td>
                        <td class="text-end">@Of(c.Escalated, c.Registered)@{ Barra(c.Escalated, c.Registered); }</td>
                        <td class="text-end">@Of(c.UrgentProtocols, c.Registered)@{ Barra(c.UrgentProtocols, c.Registered); }</td>
                        <td class="text-end">@Of(c.Referrals, c.Registered)@{ Barra(c.Referrals, c.Registered); }</td>
                        <td class="text-end">@c.IndicationsIssued</td>
                        <td class="text-end">@Of(c.NursingTransfersReceived + c.MedicalTransfersReceived, c.NursingTransfers + c.MedicalTransfers)@{ Barra(c.NursingTransfersReceived + c.MedicalTransfersReceived, c.NursingTransfers + c.MedicalTransfers); }</td>
                        <td class="text-end">@Of(c.FollowUpsOverdue, c.FollowUpsOpen)@{ Barra(c.FollowUpsOverdue, c.FollowUpsOpen); }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Primero las cifras y después cómo se cuentan (antes la explicación ocupaba media pantalla antes de los datos);
       sigue saliendo en el informe impreso. *@
    <section id="como-se-cuenta" class="card mb-4">
        <div class="card-body">
            <h2 class="h5 card-title">Cómo se cuenta</h2>
            <ul class="mb-0">
                <li><strong>Registrados:</strong> episodios registrados en el periodo (cambios de Auxiliar y eventos de Enfermería o de Medicina). Son el denominador de los escalados, protocolos y derivaciones, que cuentan lo que pasó después con esos episodios, hasta hoy.</li>
                <li><strong>Cerrados en el periodo:</strong> episodios cerrados en esas fechas, aunque se registraran antes. No tiene denominador.</li>
                <li><strong>Indicaciones:</strong> indicaciones médicas emitidas en el periodo, que son el denominador, con su estado de hoy. «Sin resolver» son las que aún no se han registrado como realizadas o no realizadas.</li>
                <li><strong>Continuidad:</strong> transferencias de un seguimiento al equipo o turno entrante registradas en el periodo, y cuántas tienen la recepción confirmada. En Medicina confirmar la recepción es opcional.</li>
                <li><strong>Seguimientos pendientes (fecha prevista pasada):</strong> de los seguimientos que estuvieron abiertos algún día del periodo (el denominador), cuántos tuvieron su fecha prevista ya pasada algún día del periodo, con el plan que regía ese día (una reprogramación posterior no lo borra). Un seguimiento sigue abierto, y por tanto pendiente, hasta que se cierra el episodio: escalarlo a Medicina o activar el protocolo urgente no lo cierra; derivarlo a Urgencias o el fallecimiento sí. Los seguimientos sin fecha no vencen. En la evolución mensual cada mes se calcula por separado, así que un mismo seguimiento puede contar en varios meses.</li>
                <li>La unidad es la del episodio. Las horas son las del centro.</li>
            </ul>
        </div>
    </section>
}

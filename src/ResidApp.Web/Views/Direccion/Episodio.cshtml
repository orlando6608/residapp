@using ResidApp.Application.Ports
@using ResidApp.Domain.Auxiliar
@using ResidApp.Web.Models
@model SupervisionEpisodeDetail
@{
    var episode = Model.Episode;
    ViewData["Title"] = "Detalle operativo del episodio";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Dirección Clínica</a></li>
        <li class="breadcrumb-item"><a asp-action="Pendientes">Pendientes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalle operativo</li>
    </ol>
</nav>

<h1 class="h3">Detalle operativo del episodio</h1>
<div class="alert alert-info" role="note">
    Vista de supervisión: muestra el estado y los hitos del episodio, sin observaciones, valoraciones ni indicaciones. Desde aquí no
    se puede valorar, indicar, escalar ni corregir. Lo único que se puede hacer es cerrar un episodio con indicaciones médicas que
    nadie va a cumplir, indicando el motivo (más abajo).
</div>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">@episode.ResidentDisplayName</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">Unidad</dt>
            <dd class="col-sm-9">@episode.UnitName</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge @ClinicalEventStatusDisplay.BadgeClass(episode.Status, episode.Classification == DailyChangeClassification.Prioritario)">@ClinicalEventStatusDisplay.Label(episode.Status)</span>
                @if (episode.Classification == DailyChangeClassification.Prioritario)
                {
                    <span class="badge text-bg-danger">Prioritario</span>
                }
            </dd>
            <dt class="col-sm-3">Origen</dt>
            <dd class="col-sm-9">@EnumDisplay.Label(episode.Origin)</dd>
            <dt class="col-sm-3">Registro</dt>
            <dd class="col-sm-9">@episode.ReceivedAt.ToLocalTime().ToString("g") (@ElapsedTimeDisplay.Since(episode.ReceivedAt))</dd>
            <dt class="col-sm-3">Equipo responsable</dt>
            <dd class="col-sm-9">El de la unidad (todavía no hay equipos ni turnos configurados).</dd>
            @if (episode.HasFollowUp)
            {
                <dt class="col-sm-3">Seguimiento</dt>
                <dd class="col-sm-9">
                    @(episode.FollowUpDue is { } due ? $"Fecha prevista {due:d}" : "Sin fecha prevista (por criterio)")
                    @if (episode.FollowUpDue < DateOnly.FromDateTime(DateTime.Today))
                    {
                        <span class="badge text-bg-warning">Pendiente</span>
                    }
                </dd>
            }
            @if (episode.IndicationsPending > 0 || episode.IndicationsNotDone > 0)
            {
                <dt class="col-sm-3">Indicaciones</dt>
                <dd class="col-sm-9">@episode.IndicationsPending @(episode.IndicationsPending == 1 ? "pendiente" : "pendientes") · @episode.IndicationsNotDone @(episode.IndicationsNotDone == 1 ? "no realizada" : "no realizadas")</dd>
            }
        </dl>
    </div>
</div>

<h2 class="h5">Hitos</h2>
<ol class="list-group list-group-numbered mb-3">
    @foreach (var milestone in Model.Milestones)
    {
        <li class="list-group-item">
            <strong>@SupervisionDisplay.Label(milestone.Kind)</strong>
            · @milestone.At.ToLocalTime().ToString("g")
            @if (milestone.Profile is { } profile)
            {
                <span class="text-muted">· @SystemProfileDisplay.Label(profile)</span>
            }
        </li>
    }
</ol>

@if (episode.IndicationsPending > 0)
{
    <section class="card border-warning mb-4" aria-labelledby="cierre-excepcional-titulo">
        <div class="card-body">
            <h2 class="h5 card-title" id="cierre-excepcional-titulo">Cerrar el episodio con indicaciones sin cumplir</h2>
            <p>
                Este episodio tiene @episode.IndicationsPending @(episode.IndicationsPending == 1 ? "indicación médica abierta" : "indicaciones médicas abiertas"), así que
                Enfermería y Medicina no pueden cerrarlo. Si nadie las va a cumplir, puedes cerrarlo tú, indicando el motivo. Es una decisión con
                responsabilidad clínica: el cierre queda en la auditoría con tu nombre y tu motivo, las indicaciones <strong>no se tocan</strong> (siguen
                sin resolver y se cuentan así en los indicadores) y no se prepara ningún comunicado a la familia. No se puede deshacer.
            </p>
            <form asp-action="CerrarEpisodio" method="post">
                <input type="hidden" name="Form.EventoId" value="@episode.EventId" />
                <div class="mb-3">
                    <label for="cierre-motivo" class="form-label">Motivo del cierre</label>
                    <textarea id="cierre-motivo" name="Form.Motivo" class="form-control" rows="3" maxlength="@ResidApp.Domain.Supervision.ExceptionalEpisodeClosure.MaxReasonLength" required></textarea>
                    <div class="form-text">Hasta @ResidApp.Domain.Supervision.ExceptionalEpisodeClosure.MaxReasonLength caracteres. Sin datos clínicos innecesarios.</div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="cierre-confirmo" name="Form.Confirmo" value="true" />
                    <label class="form-check-label" for="cierre-confirmo">Entiendo que las indicaciones médicas se quedan sin resolver</label>
                </div>
                <button type="submit" class="btn btn-warning btn-lg">Cerrar el episodio</button>
            </form>
        </div>
    </section>
}

<a asp-action="Pendientes" class="btn btn-outline-secondary btn-lg">Volver a los pendientes</a>

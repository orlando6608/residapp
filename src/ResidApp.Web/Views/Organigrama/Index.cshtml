@model ResidApp.Web.Models.OrganigramaViewModel
@{
    ViewData["Title"] = "Organigrama";
    var canManage = ViewData["PuedeGestionar"] as bool? == true;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Organigrama</li>
    </ol>
</nav>

<h1 class="h3">Organigrama del centro</h1>
<p class="text-muted">
    Los cargos del centro, de quién depende cada uno y quién los ocupa ahora. Es solo para consultar: ocupar un cargo no da ningún permiso ni
    acceso, y lo que cada persona puede hacer en la aplicación depende de su perfil.
    @if (canManage)
    {
        <span>Como Administración, puedes <a asp-controller="Administracion" asp-action="Cargos">gestionar los cargos</a>.</span>
    }
</p>
<div asp-validation-summary="All" class="text-danger"></div>

@if (ViewData.ModelState.IsValid && Model.PositionCount == 0)
{
    <p class="estado-vacio">El centro todavía no ha definido su organigrama.</p>
}
else if (Model.PositionCount > 0)
{
    <ul class="organigrama-raiz">
        @foreach (var root in Model.Roots)
        {
            <partial name="_OrganigramaNodo" model="new ResidApp.Web.Models.OrganigramaNodeModel(root, false)" />
        }
    </ul>
}

@using ResidApp.Domain.Enfermeria
@model ResidApp.Application.Ports.PendingChangeDetail
@{
    ViewData["Title"] = "Conducta médica";
    var conIndicaciones = Model.Status == ClinicalEventStatus.ConIndicacionPendiente;
    var enSeguimiento = Model.Status == ClinicalEventStatus.EnSeguimientoMedico;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Medicina</a></li>
        <li class="breadcrumb-item"><a asp-action="Escalado" asp-route-eventoId="@Model.EventId">Detalle</a></li>
        <li class="breadcrumb-item active" aria-current="page">Conducta médica</li>
    </ol>
</nav>

<h1 class="h3">Conducta médica — @Model.ResidentDisplayName</h1>
<p class="text-muted">Elige cómo continúa el evento. El sistema no decide ni propone ninguna salida, ni asigna prioridades.</p>
@if (enSeguimiento)
{
    <div class="alert alert-info">
        Estás resolviendo el seguimiento médico. Registrar una indicación o cerrar el evento lo da por terminado.
        <a asp-action="Seguimiento" asp-route-eventoId="@Model.EventId">Volver al seguimiento</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
        <a asp-action="Indicacion" asp-route-eventoId="@Model.EventId" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">@(conIndicaciones ? "Registrar otra indicación" : "Registrar indicaciones a Enfermería")</h2>
                <p class="card-text text-muted mb-0">
                    Texto, fecha prevista o criterio e información adicional. Enfermería de la unidad confirma la lectura y registra si la realizó.
                    @if (enSeguimiento)
                    {
                        <span>El seguimiento médico termina y el evento pasa a indicación pendiente.</span>
                    }
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Cerrar" asp-route-eventoId="@Model.EventId" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Cerrar el evento</h2>
                <p class="card-text text-muted mb-0">Pasa a Historial sin un segundo cierre de Enfermería. Decides si se comunica a la familia. Las indicaciones sin resolver siguen visibles para Enfermería.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        @if (Model.Medical.FollowUp is null)
        {
            <a asp-action="IniciarSeguimiento" asp-route-eventoId="@Model.EventId" class="card text-decoration-none h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Iniciar seguimiento médico</h2>
                    <p class="card-text text-muted mb-0">Objetivo y fecha prevista o criterio. El equipo responsable es Medicina de la unidad; el evento sigue en seguimiento hasta que lo resuelvas.</p>
                </div>
            </a>
        }
        else
        {
            <div class="card h-100 text-muted">
                <div class="card-body">
                    <h2 class="h5 card-title">Iniciar seguimiento médico</h2>
                    <p class="card-text mb-0">
                        @(enSeguimiento ? "El evento ya está en seguimiento médico." : "Este evento ya tuvo su seguimiento médico: cada evento admite uno.")
                    </p>
                </div>
            </div>
        }
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="ActivarProtocolo" asp-route-eventoId="@Model.EventId" class="card text-decoration-none h-100 border-danger">
            <div class="card-body">
                <h2 class="h5 card-title">Activar protocolo urgente</h2>
                <p class="card-text text-muted mb-0">Un solo paso para no retrasar la atención; después documentas actuaciones, evolución y contactos. Las indicaciones emitidas siguen visibles. La derivación a Urgencias llegará pronto.</p>
            </div>
        </a>
    </div>
</div>

<div class="d-grid d-md-flex justify-content-md-end gap-2">
    @if (enSeguimiento)
    {
        <a asp-action="Seguimiento" asp-route-eventoId="@Model.EventId" class="btn btn-outline-secondary btn-lg">Volver al seguimiento</a>
    }
    <a asp-action="Escalado" asp-route-eventoId="@Model.EventId" class="btn btn-outline-secondary btn-lg">Volver al detalle</a>
</div>

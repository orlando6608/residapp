@model ResidApp.Web.Models.MedicinaInicioViewModel
@{
    ViewData["Title"] = "Inicio de Medicina";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Medicina</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Medicina</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <a asp-action="Escalados" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Escalados y eventos propios</h2>
                <p class="card-text mb-0"><span class="badge text-bg-primary">@Model.Escalados</span> escalado(s) de Enfermería o evento(s) propio(s) por valorar.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Residentes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Residentes</h2>
                <p class="card-text mb-0">Residentes de tu ámbito, con su ficha y el registro de un evento que observes.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Indicaciones" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Indicaciones</h2>
                <p class="card-text mb-0">
                    <span class="badge text-bg-info">@Model.Indicaciones</span> indicación(es) emitida(s)
                    @if (Model.IndicacionesSinLeer > 0)
                    {
                        <span>· <span class="badge text-bg-warning">@Model.IndicacionesSinLeer</span> sin leer</span>
                    }
                    @if (Model.IndicacionesConIncidencia > 0)
                    {
                        <span>· <span class="badge text-bg-danger">@Model.IndicacionesConIncidencia</span> con incidencia</span>
                    }
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Protocolos" class="card text-decoration-none h-100 border-danger">
            <div class="card-body">
                <h2 class="h5 card-title">Protocolos urgentes</h2>
                <p class="card-text mb-0"><span class="badge text-bg-danger">@Model.Protocolos</span> protocolo(s) urgente(s) activo(s).</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="Seguimientos" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Seguimientos</h2>
                <p class="card-text mb-0">
                    <span class="badge text-bg-info">@Model.Seguimientos</span> seguimiento(s) médico(s) abierto(s)
                    @if (Model.SeguimientosVencidos > 0)
                    {
                        <span>· <span class="badge text-bg-danger">@Model.SeguimientosVencidos</span> vencido(s)</span>
                    }
                </p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 text-muted">
            <div class="card-body">
                <h2 class="h5 card-title">Comunicaciones</h2>
                <p class="card-text mb-0">Próximamente: comunicaciones familiares pendientes de aprobación.</p>
            </div>
        </div>
    </div>
</div>

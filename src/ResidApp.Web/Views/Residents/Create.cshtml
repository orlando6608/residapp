@model ResidApp.Web.Models.CreateResidentFormModel
@{
    ViewData["Title"] = "Alta de residente";
    var units = (List<SelectListItem>?)ViewBag.Unidades ?? [];
    var locations = (IReadOnlyList<ResidApp.Application.Ports.LocationOption>?)ViewBag.Ubicaciones ?? [];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Alta de residente</li>
    </ol>
</nav>

<h1 class="h3">Alta de residente</h1>
<p class="text-muted">
    Vertical Residente/Basal. La unidad se elige entre las de tu ámbito activo; la habitación y la plaza son opcionales.
</p>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>

        <p>
            Ámbito activo: <strong>@ViewBag.AmbitoPerfilLabel</strong> · @ViewBag.AmbitoCentroNombre
            (<a asp-controller="ProfileScope" asp-action="Select" asp-route-returnUrl="@Url.Action("Create", "Residents")">Cambiar ámbito</a>)
        </p>

        @if (ViewBag.PuedeDarDeAlta != true)
        {
            <div class="alert alert-warning" role="alert">
                Tu ámbito activo no tiene permiso para dar de alta residentes. Si lo necesitas, pídeselo a Administración.
            </div>
        }
        else if (units.Count == 0)
        {
            <div class="alert alert-warning" role="alert">
                Tu ámbito activo no tiene ninguna unidad concedida, así que no puedes dar de alta residentes en él.
            </div>
        }
        else
        {
        <form asp-controller="Residents" asp-action="Create" method="post">
            <input type="hidden" asp-for="OperacionId" />
            <input type="hidden" asp-for="AmbitoPerfilId" />
            <input type="hidden" asp-for="CentroId" />

            <div class="mb-3">
                <label asp-for="UnidadId" class="form-label"></label>
                <select asp-for="UnidadId" class="form-select form-select-lg" asp-items="units">
                    @if (units.Count > 1)
                    {
                        <option value="">Elige una unidad</option>
                    }
                </select>
                <span asp-validation-for="UnidadId" class="text-danger"></span>
            </div>
            @if (locations.Count > 0)
            {
                <div class="mb-3">
                    <label asp-for="Ubicacion" class="form-label"></label>
                    <select asp-for="Ubicacion" class="form-select form-select-lg" aria-describedby="ayuda-ubicacion">
                        <option value="">Sin habitación ni plaza</option>
                        @foreach (var unitGroup in locations.GroupBy(l => l.UnitName))
                        {
                            <optgroup label="@unitGroup.Key">
                                @foreach (var option in unitGroup)
                                {
                                    @if (option.PlaceId is { } placeId)
                                    {
                                        <option value="p:@placeId">@option.RoomName · @option.PlaceName</option>
                                    }
                                    else
                                    {
                                        <option value="r:@option.RoomId">@option.RoomName</option>
                                    }
                                }
                            </optgroup>
                        }
                    </select>
                    <div id="ayuda-ubicacion" class="form-text">
                        Opcional. Debe ser de la unidad que elijas arriba; las plazas ocupadas no se ofrecen. Para cambiar después de habitación o plaza,
                        usa «Trasladar» en la ficha del residente.
                    </div>
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>
            }
            <div class="mb-3">
                <label asp-for="NombreVisible" class="form-label"></label>
                <input asp-for="NombreVisible" class="form-control form-control-lg" />
                <span asp-validation-for="NombreVisible" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FechaNacimiento" class="form-label"></label>
                <input asp-for="FechaNacimiento" class="form-control form-control-lg" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SexoDocumentadoCodigo" class="form-label"></label>
                <select asp-for="SexoDocumentadoCodigo" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<ResidApp.Domain.Residents.DocumentedSexCode>()"></select>
                <span asp-validation-for="SexoDocumentadoCodigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ReferenciaInterna" class="form-label"></label>
                <input asp-for="ReferenciaInterna" class="form-control form-control-lg" />
                <span asp-validation-for="ReferenciaInterna" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="h6">Familiares de contacto</legend>
                <p class="form-text">
                    Registra a los familiares de contacto prioritario, referentes y tutores legales del residente. Cada uno necesita nombre, relación y
                    teléfono; deja en blanco las filas que no uses (puedes añadir más después desde su ficha). Solo uno puede ser el contacto prioritario
                    (el contacto urgente). Añadirlos no les da acceso al Portal Familiar.
                </p>
                <span asp-validation-for="Familiares" class="text-danger d-block mb-2"></span>
                <div class="form-check mb-3">
                    <input type="radio" name="ContactoPrioritario" value="" id="contacto-prioritario-ninguno" class="form-check-input"
                           checked="@(Model.ContactoPrioritario is null)" />
                    <label for="contacto-prioritario-ninguno" class="form-check-label">Sin contacto prioritario por ahora</label>
                </div>
                @for (var i = 0; i < Model.Familiares.Count; i++)
                {
                    <div class="border rounded p-3 mb-3">
                        <p class="fw-semibold mb-2">Familiar @(i + 1)</p>
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label asp-for="Familiares[i].NombreVisible" class="form-label"></label>
                                <input asp-for="Familiares[i].NombreVisible" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Familiares[i].Relacion" class="form-label"></label>
                                <input asp-for="Familiares[i].Relacion" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Familiares[i].Telefono" class="form-label"></label>
                                <input asp-for="Familiares[i].Telefono" type="tel" class="form-control" autocomplete="off" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Familiares[i].Correo" class="form-label"></label>
                                <input asp-for="Familiares[i].Correo" type="email" class="form-control" autocomplete="off" />
                            </div>
                        </div>
                        <div class="mt-2">
                            <div class="form-check">
                                <input type="radio" name="ContactoPrioritario" value="@i" id="contacto-prioritario-@i" class="form-check-input"
                                       checked="@(Model.ContactoPrioritario == i)" />
                                <label for="contacto-prioritario-@i" class="form-check-label">Contacto prioritario (contacto urgente)</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="Familiares[i].Referente" class="form-check-input" />
                                <label asp-for="Familiares[i].Referente" class="form-check-label"></label>
                            </div>
                            <div class="form-check">
                                <input asp-for="Familiares[i].TutorLegal" class="form-check-input" />
                                <label asp-for="Familiares[i].TutorLegal" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                }
            </fieldset>

            <div class="d-grid d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary btn-lg">Dar de alta</button>
            </div>
        </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

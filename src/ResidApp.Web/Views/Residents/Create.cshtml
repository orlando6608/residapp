@model ResidApp.Web.Models.CreateResidentFormModel
@{
    ViewData["Title"] = "Alta de residente";
}

<h1>Alta de residente</h1>
<p class="text-muted">
    Vertical Residente/Basal. Los identificadores de perfil, centro y unidad deben corresponder a datos ya
    sembrados (ver <code>database/seed/dev_seed_residente_basal.sql</code>); no se listan aquí porque
    todavía no existe una pantalla de selección de organización.
</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Residents" asp-action="Create" method="post">
    <input type="hidden" asp-for="OperationId" />

    <div class="mb-3">
        <label asp-for="ProfileScopeId" class="form-label"></label>
        <input asp-for="ProfileScopeId" class="form-control form-control-lg" />
        <span asp-validation-for="ProfileScopeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CenterId" class="form-label"></label>
        <input asp-for="CenterId" class="form-control form-control-lg" />
        <span asp-validation-for="CenterId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitId" class="form-label"></label>
        <input asp-for="UnitId" class="form-control form-control-lg" />
        <span asp-validation-for="UnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DisplayName" class="form-label"></label>
        <input asp-for="DisplayName" class="form-control form-control-lg" />
        <span asp-validation-for="DisplayName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BirthDate" class="form-label"></label>
        <input asp-for="BirthDate" class="form-control form-control-lg" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DocumentedSexCode" class="form-label"></label>
        <select asp-for="DocumentedSexCode" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<ResidApp.Domain.Residents.DocumentedSexCode>()"></select>
        <span asp-validation-for="DocumentedSexCode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="InternalReference" class="form-label"></label>
        <input asp-for="InternalReference" class="form-control form-control-lg" />
        <span asp-validation-for="InternalReference" class="text-danger"></span>
    </div>

    <div class="d-grid d-md-block">
        <button type="submit" class="btn btn-primary btn-lg">Dar de alta</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

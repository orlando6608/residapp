@{
    ViewData["Title"] = "Residente dado de alta";
}

<div class="card border-success">
    <div class="card-body">
        <h1 class="h4 text-success">✓ Residente dado de alta</h1>
        <p>Id del residente: <code>@ViewBag.ResidentId</code></p>
        <div class="d-grid d-md-flex">
            <a asp-controller="Residents" asp-action="Create" class="btn btn-primary btn-lg">Dar de alta otro residente</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Volver al inicio</a>
        </div>
    </div>
</div>

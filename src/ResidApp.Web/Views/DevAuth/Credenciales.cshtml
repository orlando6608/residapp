@model ResidApp.Web.Models.DevAuthCredencialesViewModel
@{
    ViewData["Title"] = "Credenciales de prueba";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Credenciales de prueba</h1>
                <p class="text-muted small">
                    Solo en el acceso de desarrollo, mientras no haya invitaciones (ADR 0007, incremento I2): pon una contraseña a la cuenta de
                    esta sesión para probar con ella «Iniciar sesión». Queda en el registro de accesos.
                </p>

                <dl class="row mb-3">
                    <dt class="col-sm-5">Usuario</dt>
                    <dd class="col-sm-7"><code class="text-break">@Model.Usuario</code></dd>
                    <dt class="col-sm-5">Contraseña</dt>
                    <dd class="col-sm-7">@(Model.TieneContrasena ? "Tiene" : "No tiene")</dd>
                    <dt class="col-sm-5">Segundo factor</dt>
                    <dd class="col-sm-7">@(Model.SegundoFactorActivo ? "Activado" : "Sin activar")</dd>
                </dl>

                @if (Model.Aviso is not null)
                {
                    <div class="alert alert-success" role="status">@Model.Aviso</div>
                }
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                <form asp-controller="DevAuth" asp-action="Credenciales" method="post">
                    <div class="mb-3">
                        <label for="contrasena" class="form-label">Contraseña nueva</label>
                        <input type="password" class="form-control form-control-lg" id="contrasena" name="contrasena" autocomplete="new-password"
                               minlength="@ResidApp.Web.Security.AccesoOptions.LongitudMinimaContrasena" aria-describedby="contrasena-ayuda" required />
                        <div id="contrasena-ayuda" class="form-text">
                            Al menos @ResidApp.Web.Security.AccesoOptions.LongitudMinimaContrasena caracteres. Guardarla también desbloquea la cuenta.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="confirmacion" class="form-label">Repite la contraseña</label>
                        <input type="password" class="form-control form-control-lg" id="confirmacion" name="confirmacion" autocomplete="new-password" required />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Guardar contraseña</button>
                    </div>
                </form>

                @if (Model.SegundoFactorActivo)
                {
                    <form asp-controller="DevAuth" asp-action="QuitarSegundoFactor" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-secondary">Quitar el segundo factor</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

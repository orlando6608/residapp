@model ResidApp.Web.Models.DevAuthCredencialesViewModel
@{
    ViewData["Title"] = "Credenciales de prueba";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Credenciales de prueba</h1>
                <p class="text-muted small">
                    Solo en el acceso de desarrollo: crea una invitación para la cuenta de esta sesión, como la que entrega Administración, y
                    ábrela para elegir la contraseña y, si es del personal, preparar el código del móvil. Queda en el registro de accesos.
                </p>

                <dl class="row mb-3">
                    <dt class="col-sm-5">Usuario</dt>
                    <dd class="col-sm-7"><code class="text-break">@Model.Usuario</code></dd>
                    <dt class="col-sm-5">Contraseña</dt>
                    <dd class="col-sm-7">@(Model.TieneContrasena ? "Tiene" : "No tiene")</dd>
                    <dt class="col-sm-5">Segundo factor</dt>
                    <dd class="col-sm-7">@(Model.SegundoFactorActivo ? "Activado" : "Sin activar")</dd>
                </dl>

                <form asp-controller="DevAuth" asp-action="Credenciales" method="post">
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            @(Model.TieneContrasena ? "Crear una invitación de recuperación" : "Crear una invitación de acceso")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

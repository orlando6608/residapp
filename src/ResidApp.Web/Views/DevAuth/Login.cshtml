@model ResidApp.Web.Models.DevAuthLoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/images/logo.svg" alt="ResidApp" style="max-width: 120px; width: 100%;" />
                </div>

                <h1 class="h4 text-center mb-3">Iniciar sesión</h1>
                <p class="text-muted small">
                    Acceso de desarrollo, no autenticación real: escribe el usuario de una cuenta de prueba (por ejemplo,
                    <code>almendros-enfermeria</code>)@(Model.RequiresKey ? " y la clave de desarrollo" : "").
                    El inicio de sesión con contraseña llegará con el proveedor de identidad.
                </p>

                <div asp-validation-summary="All" class="text-danger"></div>

                <form asp-controller="DevAuth" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div class="mb-3">
                        <label for="externalSubject" class="form-label">Usuario</label>
                        <input type="text" class="form-control form-control-lg" id="externalSubject" name="externalSubject" value="@Model.CurrentSubject"
                               placeholder="almendros-enfermeria" autocomplete="username" />
                    </div>
                    @if (Model.RequiresKey)
                    {
                        <div class="mb-3">
                            <label for="clave" class="form-label">Clave de desarrollo</label>
                            <input type="password" class="form-control form-control-lg" id="clave" name="clave" autocomplete="current-password" />
                        </div>
                    }
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                    </div>
                </form>

                <p class="text-center small mt-3 mb-0">
                    ¿No tienes cuenta? <a asp-controller="DevAuth" asp-action="Register">Solicita acceso</a>
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.CurrentSubject))
                {
                    <form asp-controller="DevAuth" asp-action="Logout" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Salir (@Model.CurrentSubject)</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

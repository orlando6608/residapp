@model string?
@{
    ViewData["Title"] = "Identidad de desarrollo";
}

<h1>Identidad de desarrollo</h1>
<p class="text-muted">
    Esto no es autenticación real: escribe el <code>external_subject</code> de una cuenta ya sembrada en
    la base de datos (por ejemplo, <code>dev-admin</code>) para ejercitar el motor de autorización.
</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="DevAuth" asp-action="Login" method="post" class="row g-2 align-items-end">
    <div class="col-12 col-md-auto">
        <label for="externalSubject" class="form-label">Sujeto externo (external_subject)</label>
        <input type="text" class="form-control form-control-lg" id="externalSubject" name="externalSubject" value="@Model" placeholder="dev-admin" />
    </div>
    <div class="col-12 col-md-auto">
        <div class="d-grid d-md-block">
            <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model))
{
    <form asp-controller="DevAuth" asp-action="Logout" method="post" class="mt-3">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Salir (@Model)</button>
    </form>
}

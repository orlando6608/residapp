@model string?
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <img src="~/images/logo.svg" alt="ResidApp" style="max-width: 120px; width: 100%;" />
                </div>

                <h1 class="h4 text-center mb-3">Iniciar sesión</h1>
                <p class="text-muted small">
                    Esto no es autenticación real: escribe el sujeto externo de una cuenta ya sembrada en
                    la base de datos (por ejemplo, <code>dev-admin</code>) para ejercitar el motor de
                    autorización. El proveedor de autenticación productivo todavía no está decidido.
                </p>

                <div asp-validation-summary="All" class="text-danger"></div>

                <form asp-controller="DevAuth" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label for="externalSubject" class="form-label">Usuario</label>
                        <input type="text" class="form-control form-control-lg" id="externalSubject" name="externalSubject" value="@Model" placeholder="dev-admin" />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                    </div>
                </form>

                <p class="text-center small mt-3 mb-0">
                    ¿No tienes cuenta? <a asp-controller="DevAuth" asp-action="Register">Solicita acceso</a>
                </p>

                @if (!string.IsNullOrWhiteSpace(Model))
                {
                    <form asp-controller="DevAuth" asp-action="Logout" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Salir (@Model)</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

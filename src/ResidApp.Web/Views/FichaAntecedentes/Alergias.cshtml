@using ResidApp.Domain.Residents
@using ResidApp.Shared
@using ResidApp.Web.Models
@model AllergyEditViewModel
@* Ficha de antecedentes de salud, fase 1: alergias e intolerancias a medicamentos (script 0094). Sin ningún valor preseleccionado, sin autocompletado del navegador y con la
   persona a la vista antes de guardar (revisión del DPO, 2026-11-15). Las filas se añaden con site.js (data-anadir-fila); sin JavaScript hay filas de sobra. *@
@{
    ViewData["Title"] = "Alergias e intolerancias a medicamentos";
    var form = Model.Form;
    var isNew = form.VersionVista == 0;
    var rows = form.Filas.Count + 2 < 4 ? 4 : form.Filas.Count + 2;
    if (rows > AllergyRecordContent.MaxItems)
    {
        rows = AllergyRecordContent.MaxItems;
    }
    var states = new[] { HealthBackgroundState.ConEntradas, HealthBackgroundState.NoRefiere, HealthBackgroundState.NoConsta };
    var stateLabels = new Dictionary<HealthBackgroundState, (string Label, string Hint)>
    {
        [HealthBackgroundState.ConEntradas] = ("Tiene alergias a medicamentos", "Escribe cada una en la lista de abajo."),
        [HealthBackgroundState.NoRefiere] = ("No refiere alergias a medicamentos", "Lo dice el residente o su familia."),
        [HealthBackgroundState.NoConsta] = ("No se sabe o no consta", "Su información no es fiable (por ejemplo, por demencia), no hay familiar que lo confirme y no consta en ningún informe médico."),
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="@Model.RecordController" asp-action="Residente" asp-route-residenteId="@Model.Resident.ResidentId.Value">@Model.Resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Alergias</li>
    </ol>
</nav>

<h1 class="h3">Alergias e intolerancias a medicamentos</h1>

<div class="card mb-3" role="group" aria-label="Residente al que pertenece esta ficha">
    <div class="card-body d-flex align-items-center gap-3">
        <partial name="_FotoResidente" model="new ResidentPhotoViewModel(Model.Resident.ResidentId.Value, Model.Resident.DisplayName, Model.Resident.PhotoUpdatedAt, Large: true)" />
        <div>
            <p class="h5 mb-1">@Model.Resident.DisplayName</p>
            <p class="text-muted mb-0">@Model.Resident.LocationLabel</p>
        </div>
    </div>
</div>
<p><strong>Revisa que sea la persona correcta.</strong> Lo que guardes no se puede borrar: si te equivocas, se guarda una versión nueva que lo corrige y la anterior se conserva.</p>
<p class="text-muted">Solo alergias e intolerancias a medicamentos. Escribe lo que consta, no lo que sospechas. Lo que guardes se imprime en el informe de derivación a Urgencias.</p>

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<form asp-controller="FichaAntecedentes" asp-action="Alergias" method="post" autocomplete="off">
    <input type="hidden" name="Form.ResidenteId" value="@form.ResidenteId" />
    <input type="hidden" name="Form.VersionVista" value="@form.VersionVista" />

    <fieldset class="mb-4">
        <legend class="h5">¿Tiene alergias a medicamentos?</legend>
        @foreach (var state in states)
        {
            var code = state.ToCode();
            var (label, hint) = stateLabels[state];
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="Form.Estado" id="estado-@code" value="@code" required checked="@(form.Estado == code)" />
                <label class="form-check-label" for="estado-@code">@label</label>
                <div class="form-text">@hint</div>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h5">Lista de alergias e intolerancias</legend>
        <p class="form-text">
            <strong>Medicamento o grupo:</strong> solo el nombre (por ejemplo, «Penicilina»), sin personas, sin explicaciones ni fechas.
            <strong>Reacción o motivo:</strong> qué le ocurre, en pocas palabras (por ejemplo, «urticaria»); sin nombres de familiares ni de quién lo cuenta, y sin opiniones.
            En una intolerancia o efecto adverso el motivo es obligatorio. Las intolerancias se pueden anotar aunque marques «No refiere» o «No se sabe o no consta».
        </p>
        <div id="alergias-filas">
            @for (var i = 0; i < rows; i++)
            {
                var row = i < form.Filas.Count ? form.Filas[i] : new AllergyRowModel();
                <div class="row g-2 border rounded p-2 mb-2" data-fila>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="fila-@i-tipo">Tipo</label>
                        <select class="form-select" id="fila-@i-tipo" name="Form.Filas[@i].Tipo">
                            @foreach (var type in new[] { AllergyItemType.Alergia, AllergyItemType.Intolerancia })
                            {
                                <option value="@type.ToCode()" selected="@(row.Tipo == type.ToCode())">@EnumDisplay.Label(type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="fila-@i-nombre">Medicamento o grupo</label>
                        <input class="form-control" id="fila-@i-nombre" name="Form.Filas[@i].Nombre" maxlength="@AllergyItem.MaxNameLength" value="@row.Nombre" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="fila-@i-reaccion">Reacción o motivo</label>
                        <input class="form-control" id="fila-@i-reaccion" name="Form.Filas[@i].Reaccion" maxlength="@AllergyItem.MaxReactionLength" value="@row.Reaccion" autocomplete="off" />
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-secondary" data-anadir-fila="alergias-filas" data-plantilla="alergias-fila-plantilla" data-maximo="@AllergyRecordContent.MaxItems">Añadir otra fila</button>
        <template id="alergias-fila-plantilla">
            <div class="row g-2 border rounded p-2 mb-2" data-fila>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="fila-__i__-tipo">Tipo</label>
                    <select class="form-select" id="fila-__i__-tipo" name="Form.Filas[__i__].Tipo">
                        @foreach (var type in new[] { AllergyItemType.Alergia, AllergyItemType.Intolerancia })
                        {
                            <option value="@type.ToCode()">@EnumDisplay.Label(type)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="fila-__i__-nombre">Medicamento o grupo</label>
                    <input class="form-control" id="fila-__i__-nombre" name="Form.Filas[__i__].Nombre" maxlength="@AllergyItem.MaxNameLength" autocomplete="off" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="fila-__i__-reaccion">Reacción o motivo</label>
                    <input class="form-control" id="fila-__i__-reaccion" name="Form.Filas[__i__].Reaccion" maxlength="@AllergyItem.MaxReactionLength" autocomplete="off" />
                </div>
            </div>
        </template>
    </fieldset>

    <div class="mb-4">
        <label class="form-label h5" for="fuente">¿De dónde sale el dato? (opcional)</label>
        <select class="form-select" id="fuente" name="Form.Fuente">
            <option value="">Sin indicar</option>
            @foreach (var source in Enum.GetValues<HealthBackgroundSource>())
            {
                <option value="@source.ToCode()" selected="@(form.Fuente == source.ToCode())">@EnumDisplay.Label(source)</option>
            }
        </select>
        <div class="form-text">No hace falta un método concreto. No escribas el nombre de quien te lo ha dicho.</div>
    </div>

    @if (!isNew)
    {
        <fieldset class="mb-4">
            <legend class="h5">¿Por qué guardas una versión nueva?</legend>
            @foreach (var reason in new[] { HealthBackgroundReason.Actualizacion, HealthBackgroundReason.Correccion })
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="Form.Motivo" id="motivo-@reason.ToCode()" value="@reason.ToCode()" required checked="@(form.Motivo == reason.ToCode())" />
                    <label class="form-check-label" for="motivo-@reason.ToCode()">@EnumDisplay.Label(reason)</label>
                </div>
            }
        </fieldset>
    }

    <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg">Guardar la ficha de alergias</button>
        <a asp-controller="@Model.RecordController" asp-action="Residente" asp-route-residenteId="@Model.Resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Cancelar</a>
    </div>
</form>

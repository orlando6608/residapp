@using ResidApp.Web.Models
@model EmergencyContactViewModel
@{
    var resident = Model.Detail.Resident;
    ViewData["Title"] = "Contacto urgente";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value">@resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Contacto urgente</li>
    </ol>
</nav>

<h1 class="h3">Contacto urgente</h1>
<p class="text-muted">
    Elige, entre los familiares de @resident.DisplayName, a quién se avisa en una urgencia. Ser contacto urgente no da acceso
    al Portal Familiar. Cada cambio queda en el historial de la ficha.
</p>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="ContactoUrgente" method="post">
            <input type="hidden" name="Form.ResidenteId" value="@Model.Form.ResidenteId" />
            <input type="hidden" name="Form.DesignacionesEsperadas" value="@Model.Form.DesignacionesEsperadas" />
            <fieldset class="mb-3">
                <legend class="form-label fs-6">Contacto urgente</legend>
                @foreach (var member in Model.Detail.Family)
                {
                    var id = "contacto-" + member.LinkId;
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="Form.VinculoId" id="@id" value="@member.LinkId"
                               checked="@(Model.Form.VinculoId == member.LinkId)" />
                        <label class="form-check-label" for="@id">@member.DisplayName (@member.Relationship) · @member.Phone</label>
                    </div>
                }
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Form.VinculoId" id="contacto-ninguno" value=""
                           checked="@(Model.Form.VinculoId is null)" />
                    <label class="form-check-label" for="contacto-ninguno">Sin contacto urgente</label>
                </div>
            </fieldset>

            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">Guardar</button>
            </div>
        </form>
    </div>
</div>

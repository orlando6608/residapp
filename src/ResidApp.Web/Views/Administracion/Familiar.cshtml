@using ResidApp.Web.Models
@model FamilyMemberViewModel
@{
    var resident = Model.Resident;
    var editing = Model.Form.VinculoId is not null;
    var title = editing ? "Editar familiar" : "Añadir familiar";
    ViewData["Title"] = title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value">@resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@title</li>
    </ol>
</nav>

<h1 class="h3">@title</h1>
<p class="text-muted">
    @if (editing)
    {
        @:Los cambios quedan en la auditoría. Cambiar los datos no cambia su autorización de acceso.
    }
    else
    {
        @:Familiar de @resident.DisplayName. Añadirlo no le da acceso a nada: su autorización se abre y se activa aparte.
    }
</p>

@if (editing && Model.SharedWith > 0)
{
    <div class="alert alert-warning">
        Este familiar está vinculado también a @(Model.SharedWith == 1 ? "otro residente" : $"{Model.SharedWith} residentes más"). El nombre, el
        teléfono y el correo son los mismos para todos: el cambio vale para todos ellos. La relación es solo de este residente.
    </div>
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="@(editing ? "EditarFamiliar" : "AnadirFamiliar")" method="post">
            <input type="hidden" name="Form.ResidenteId" value="@Model.Form.ResidenteId" />
            @if (editing)
            {
                <input type="hidden" name="Form.VinculoId" value="@Model.Form.VinculoId" />
                <input type="hidden" name="Form.Version" value="@Model.Form.Version" />
            }
            else
            {
                <input type="hidden" name="Form.OperacionId" value="@Model.Form.OperacionId" />
            }

            <div class="mb-3">
                <label asp-for="Form.NombreVisible" class="form-label"></label>
                <input asp-for="Form.NombreVisible" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.NombreVisible" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Relacion" class="form-label"></label>
                <input asp-for="Form.Relacion" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.Relacion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Telefono" class="form-label"></label>
                <input asp-for="Form.Telefono" type="tel" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.Telefono" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Correo" class="form-label"></label>
                <input asp-for="Form.Correo" type="email" class="form-control form-control-lg" autocomplete="off" aria-describedby="ayuda-correo" />
                <span asp-validation-for="Form.Correo" class="text-danger"></span>
                <div id="ayuda-correo" class="form-text">
                    <p class="mb-1">
                        Este correo solo sirve para mandar a esa persona avisos de ResidApp: que tiene una propuesta de cita pendiente o que el centro ha cambiado o cancelado
                        una cita que reservó. Los avisos no dicen el nombre del residente, ni el centro, ni la fecha, ni el motivo: solo que entre en ResidApp. Es voluntario:
                        puede pedir que se quite cuando quiera y entonces lo verá todo al entrar en ResidApp.
                    </p>
                    <p class="mb-0">
                        Antes de marcar la casilla, cuéntele esto, léale la dirección despacio (letra a letra si hace falta) y espere a que le diga que es correcta. Dígale también que los avisos salen de no-responder@avisos.residapp.es y que, si no ve alguno, mire el correo no deseado y añada esa dirección a sus
                        contactos. Si no ha podido
                        hacerlo, deje la casilla sin marcar: es correcto y simplemente no se enviará ningún aviso a esa dirección. Si cambia o borra la dirección, la confirmación se quita y hay que volver a
                        confirmarla. Si alguien le pide que no le manden más avisos, borre la dirección. El correo no sustituye al teléfono: si algo
                        es urgente, llame.
                    </p>
                </div>
                @if (Model.EmailConfirmedAt is { } confirmedAt)
                {
                    <div class="alert alert-success py-2 mt-2 mb-2" role="status">
                        La dirección actual está confirmada desde el @confirmedAt.ToLocalTime().ToString("dd/MM/yyyy"). Si la cambias o la borras, la confirmación se quita.
                    </div>
                }
                else if (editing && !string.IsNullOrWhiteSpace(Model.Form.Correo))
                {
                    <div class="alert alert-warning py-2 mt-2 mb-2" role="status">Correo sin confirmar: ResidApp no enviará avisos a esta dirección.</div>
                }
                <div class="form-check mt-2">
                    <input asp-for="Form.ConfirmarCorreo" class="form-check-input" />
                    <label asp-for="Form.ConfirmarCorreo" class="form-check-label"></label>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="Form.Referente" class="form-check-input" />
                    <label asp-for="Form.Referente" class="form-check-label"></label>
                </div>
                <div class="form-check">
                    <input asp-for="Form.TutorLegal" class="form-check-input" />
                    <label asp-for="Form.TutorLegal" class="form-check-label"></label>
                </div>
                <div class="form-text">Los contactos prioritarios (urgentes) se designan aparte, desde «Contactos urgentes» en la ficha del residente.</div>
            </div>

            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">@(editing ? "Guardar cambios" : "Añadir familiar")</button>
            </div>
        </form>
        @if (editing && Model.EmailConfirmedAt is not null)
        {
            <hr />
            <form asp-action="QuitarConfirmacionCorreo" method="post" class="d-grid d-md-flex justify-content-md-end">
                <input type="hidden" name="residenteId" value="@Model.Form.ResidenteId" />
                <input type="hidden" name="vinculoId" value="@Model.Form.VinculoId" />
                <input type="hidden" name="version" value="@Model.Form.Version" />
                <button type="submit" class="btn btn-outline-danger">Quitar la confirmación de la dirección</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@using ResidApp.Web.Models
@model FamilyMemberViewModel
@inject Microsoft.Extensions.Options.IOptions<ResidApp.Web.Security.PrivacidadOptions> Privacidad
@inject ResidApp.Application.Ports.FamilyAccessPolicy FamilyAccess
@{
    var resident = Model.Resident;
    var editing = Model.Form.VinculoId is not null;
    var title = editing ? "Editar familiar" : "Añadir familiar";
    var warnsEmailAccess = FamilyAccess.EmailCode && editing && Model.HasPortalAccount;
    ViewData["Title"] = title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value">@resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@title</li>
    </ol>
</nav>

<h1 class="h3">@title</h1>
<p class="text-muted">
    @if (editing)
    {
        @:Los cambios quedan en la auditoría. Cambiar los datos no cambia su autorización de acceso.
    }
    else
    {
        @:Familiar de @resident.DisplayName. Añadirlo no le da acceso a nada: su autorización se abre y se activa aparte.
    }
</p>

@if (editing && Model.SharedWith > 0)
{
    <div class="alert alert-warning">
        Este familiar está vinculado también a @(Model.SharedWith == 1 ? "otro residente" : $"{Model.SharedWith} residentes más"). El nombre, el
        teléfono y el correo son los mismos para todos: el cambio vale para todos ellos. La relación es solo de este residente.
    </div>
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="@(editing ? "EditarFamiliar" : "AnadirFamiliar")" method="post">
            <input type="hidden" name="Form.ResidenteId" value="@Model.Form.ResidenteId" />
            @if (editing)
            {
                <input type="hidden" name="Form.VinculoId" value="@Model.Form.VinculoId" />
                <input type="hidden" name="Form.Version" value="@Model.Form.Version" />
            }
            else
            {
                <input type="hidden" name="Form.OperacionId" value="@Model.Form.OperacionId" />
            }

            <div class="mb-3">
                <label asp-for="Form.NombreVisible" class="form-label"></label>
                <input asp-for="Form.NombreVisible" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.NombreVisible" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Relacion" class="form-label"></label>
                <input asp-for="Form.Relacion" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.Relacion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Telefono" class="form-label"></label>
                <input asp-for="Form.Telefono" type="tel" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.Telefono" class="text-danger"></span>
            </div>
            <div class="mb-3">
                @if (FamilyAccess.EmailCode)
                {
                    <label asp-for="Form.Correo" class="form-label">Correo para entrar en el portal y para avisos de ResidApp</label>
                }
                else
                {
                    <label asp-for="Form.Correo" class="form-label"></label>
                }
                @if (warnsEmailAccess)
                {
                    <div class="alert alert-warning py-2 mb-2" id="aviso-correo-acceso">
                        Esta persona entra con un código enviado a este correo. Compruebe que es ella quien pide el cambio (en persona o llamando al teléfono que ya
                        consta). Al cambiarlo se cierran sus sesiones y se avisa a la dirección anterior. Si lo borra, no podrá entrar.
                    </div>
                }
                <input asp-for="Form.Correo" type="email" class="form-control form-control-lg" autocomplete="off"
                       aria-describedby="@(warnsEmailAccess ? "aviso-correo-acceso ayuda-correo" : "ayuda-correo")" />
                <span asp-validation-for="Form.Correo" class="text-danger"></span>
                <div id="ayuda-correo" class="form-text">
                    @if (FamilyAccess.EmailCode)
                    {
                        <p class="mb-1">
                            Se usa para el código con el que esta persona entra en el portal y para avisos genéricos: que tiene una propuesta de cita pendiente, que el centro ha cambiado
                            o cancelado una cita que reservó, un recordatorio el día antes de una cita o, si el centro ha encendido los avisos de citas externas, un aviso sobre una cita
                            fuera del centro de la persona a la que cuida, sin decir cuándo, dónde ni de qué. Los avisos no dicen el nombre del residente, ni el centro, ni la hora, ni el
                            motivo. Sin correo no puede entrar en el portal. Antes de cambiarlo, compruebe que es ella quien lo pide.
                        </p>
                        <p class="mb-0">
                            Antes de marcar la casilla, cuéntele esto, léale la dirección despacio (letra a letra si hace falta) y espere a que le diga que es correcta. Dígale también que
                            los correos salen de no-responder@avisos.residapp.es y que, si no ve alguno, mire el correo no deseado y añada esa dirección a sus contactos. Sin la casilla
                            marcada no se le envía ningún aviso, pero el código para entrar le llega igual. Si cambia o borra la dirección, la confirmación se quita y hay que volver a
                            confirmarla. Si no quiere avisos, dela de baja en «Avisos por correo», en la pantalla de editar sus datos; no borre la dirección, porque dejaría de poder
                            entrar. El correo no sustituye al teléfono: si algo es urgente, llame.
                        </p>
                    }
                    else
                    {
                    <p class="mb-1">
                        Este correo solo sirve para mandar a esa persona avisos de ResidApp: que tiene una propuesta de cita pendiente, que el centro ha cambiado o cancelado
                        una cita que reservó, un recordatorio el día antes de una cita o, si el centro ha encendido los avisos de citas externas, un aviso sobre una cita fuera del centro de la persona a la que cuida, sin decir cuándo, dónde ni de qué. Los avisos no dicen el nombre del residente, ni el centro, ni la hora, ni el motivo: solo que entre en ResidApp;
                        el recordatorio, además, dice que tiene una cita mañana. Es voluntario:
                        puede pedir dejar de recibirlos cuando quiera y lo verá todo al entrar en ResidApp.
                    </p>
                    <p class="mb-0">
                        Antes de marcar la casilla, cuéntele esto, léale la dirección despacio (letra a letra si hace falta) y espere a que le diga que es correcta. Dígale también que los avisos salen de no-responder@avisos.residapp.es y que, si no ve alguno, mire el correo no deseado y añada esa dirección a sus
                        contactos. Si no ha podido
                        hacerlo, deje la casilla sin marcar: es correcto y simplemente no se enviará ningún aviso a esa dirección. Si cambia o borra la dirección, la confirmación se quita y hay que volver a
                        confirmarla. Si alguien le pide que no le manden más avisos, dela de baja en «Avisos por correo», en la pantalla de editar sus datos; no hace falta borrar la dirección. Si solo quiere dejar de recibir los de citas externas, dela de baja desde «Lo que ve la familia» de su residente en Citas externas. El correo no sustituye al teléfono: si algo
                        es urgente, llame.
                    </p>
                    }
                </div>
                @if (Model.EmailConfirmedAt is { } confirmedAt)
                {
                    <div class="alert alert-success py-2 mt-2 mb-2" role="status">
                        La dirección actual está confirmada desde el @CenterTime.Local(confirmedAt).ToString("dd/MM/yyyy"). Si la cambias o la borras, la confirmación se quita.
                    </div>
                }
                else if (editing && !string.IsNullOrWhiteSpace(Model.Form.Correo))
                {
                    <div class="alert alert-warning py-2 mt-2 mb-2" role="status">Correo sin confirmar: ResidApp no enviará avisos a esta dirección.</div>
                }
                <div class="form-check mt-2">
                    <input asp-for="Form.ConfirmarCorreo" class="form-check-input" />
                    <label asp-for="Form.ConfirmarCorreo" class="form-check-label"></label>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="Form.Referente" class="form-check-input" />
                    <label asp-for="Form.Referente" class="form-check-label"></label>
                </div>
                <div class="form-check">
                    <input asp-for="Form.TutorLegal" class="form-check-input" />
                    <label asp-for="Form.TutorLegal" class="form-check-label"></label>
                </div>
                <div class="form-text">Los contactos prioritarios (urgentes) se designan aparte, desde «Contactos urgentes» en la ficha del residente.</div>
            </div>

            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">@(editing ? "Guardar cambios" : "Añadir familiar")</button>
            </div>
        </form>
        @if (editing)
        {
            var optedOutAt = Model.NoticesOptOutAt;
            <hr />
            <section aria-labelledby="avisos-correo">
                <h2 class="h5" id="avisos-correo">Avisos por correo</h2>
                @if (optedOutAt is { } since)
                {
                    <div class="alert alert-warning py-2 mb-2" role="status">
                        De baja de los avisos desde el @CenterTime.Local(since).ToString("dd/MM/yyyy"). No se le envía ningún aviso sobre citas de ninguno de sus residentes en este centro.
                        @if (FamilyAccess.EmailCode)
                        {
                            <text>El código para entrar y el aviso de seguridad por cambio de correo le siguen llegando.</text>
                        }
                    </div>
                }
                else if (Model.EmailConfirmedAt is null)
                {
                    <p class="mb-2">No está de baja, pero no se le envían avisos porque no tiene una dirección confirmada.</p>
                }
                else
                {
                    <p class="mb-2">No está de baja de los avisos.</p>
                }
                <p class="form-text" id="ayuda-avisos">
                    Dala de baja cuando pida no recibir más avisos; no tiene que explicar por qué. No borres la dirección ni quites la confirmación para esto: si el correo es dudoso o un
                    aviso llegó a quien no debía, corrígelo o quita la confirmación. Si esta persona figura en dos fichas distintas, dala de baja en las dos. Lo que no se envíe mientras
                    está de baja no se enviará después, salvo el aviso de una cita fuera del centro que toque el mismo día en que se reactive. Si algo es urgente, llama. Este botón no
                    guarda los cambios de la ficha: guárdalos antes.
                </p>
                <form asp-action="AvisosFamiliar" method="post">
                    <input type="hidden" name="residenteId" value="@Model.Form.ResidenteId" />
                    <input type="hidden" name="vinculoId" value="@Model.Form.VinculoId" />
                    <input type="hidden" name="baja" value="@(optedOutAt is null ? "true" : "false")" />
                    <input type="hidden" name="bajaVista" value="@optedOutAt?.UtcTicks" />
                    @if (optedOutAt is not null)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="pedida" name="pedida" value="true" required />
                            <label class="form-check-label" for="pedida">Esta persona me ha pedido volver a recibir los avisos</label>
                        </div>
                    }
                    <div class="d-grid d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-lg @(optedOutAt is null ? "btn-outline-danger" : "btn-outline-primary")" aria-describedby="ayuda-avisos">
                            @(optedOutAt is null ? "Dar de baja de los avisos" : "Volver a activar los avisos")
                        </button>
                    </div>
                </form>
            </section>
        }
        @if (editing && Privacidad.Value.AnonimizarFamiliarActivo)
        {
            <hr />
            <div class="d-grid d-md-flex justify-content-md-end">
                <a asp-action="AnonimizarFamiliar" asp-route-residenteId="@Model.Form.ResidenteId" asp-route-vinculoId="@Model.Form.VinculoId"
                   class="btn btn-outline-danger">Anonimizar a este familiar…</a>
            </div>
        }
        @if (editing && Model.EmailConfirmedAt is not null)
        {
            <hr />
            <form asp-action="QuitarConfirmacionCorreo" method="post" class="d-grid d-md-flex justify-content-md-end">
                <input type="hidden" name="residenteId" value="@Model.Form.ResidenteId" />
                <input type="hidden" name="vinculoId" value="@Model.Form.VinculoId" />
                <input type="hidden" name="version" value="@Model.Form.Version" />
                <button type="submit" class="btn btn-outline-danger">Quitar la confirmación de la dirección</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

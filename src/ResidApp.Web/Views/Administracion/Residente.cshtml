@using ResidApp.Web.Models
@model AdministrativeResidentViewModel
@{
    var resident = Model.Detail.Resident;
    ViewData["Title"] = resident.DisplayName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@resident.DisplayName</li>
    </ol>
</nav>

<h1 class="h3">@resident.DisplayName</h1>
<p class="text-muted">Ficha administrativa. No incluye el basal ni ningún contenido clínico.</p>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (Model.Suspension is { } suspension)
{
    <div class="alert alert-warning" role="status">
        <p class="fw-semibold mb-1">Suspendido por ingreso hospitalario desde el @suspension.Since.ToLocalTime().ToString("dd/MM/yyyy")</p>
        <p class="mb-2">No se puede actuar sobre este residente (cambios, eventos, constantes, basales ni comunicados a familias) hasta que se reanude.@(suspension.Note is null ? "" : " Nota: " + suspension.Note)</p>
        <form asp-action="Reanudar" asp-route-residenteId="@resident.ResidentId.Value" method="post">
            <button type="submit" class="btn btn-outline-dark">Reanudar atención</button>
        </form>
    </div>
}

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h5 card-title">Identidad</h2>
        <dl class="row mb-3">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@resident.DisplayName</dd>
            <dt class="col-sm-4">Fecha de nacimiento</dt>
            <dd class="col-sm-8">@resident.BirthDate.ToString("dd/MM/yyyy") (@AdministrativeResidentDisplay.Age(resident.BirthDate, Model.Today) años)</dd>
            <dt class="col-sm-4">Sexo documentado</dt>
            <dd class="col-sm-8">@EnumDisplay.Label(resident.DocumentedSex)</dd>
            <dt class="col-sm-4">Unidad actual</dt>
            <dd class="col-sm-8">@resident.UnitName</dd>
            <dt class="col-sm-4">Fecha de alta</dt>
            <dd class="col-sm-8">@resident.AdmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
        <a asp-action="CorregirIdentidad" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">Corregir identidad</a>
        <a asp-action="Trasladar" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">Trasladar</a>
        @if (Model.Suspension is null)
        {
            <a asp-action="Suspender" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">Suspender (ingreso hospitalario)</a>
        }
        <a asp-action="DarDeBaja" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-danger btn-lg">Dar de baja</a>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">Familiares</h2>
    <p class="text-muted">Solo una autorización Activa dará acceso al Portal Familiar cuando exista. Añadir un familiar no la abre.</p>
    @if (Model.Detail.Family.Count > 0 && Model.Detail.CurrentEmergencyContacts.Count == 0 && !Model.Detail.Family.Any(f => f.IsReferent || f.IsLegalGuardian))
    {
        <div class="alert alert-warning" role="status">
            No hay ningún familiar de contacto prioritario, referente ni tutor legal. Márcalos al editar a cada familiar o designa los contactos urgentes.
        </div>
    }
    @if (Model.Detail.Family.Count == 0)
    {
        <div class="alert alert-warning" role="status">
            Este residente no tiene familiares registrados. Añade al menos a su contacto prioritario, referente o tutor legal.
        </div>
    }
    @if (Model.Detail.Family.Count == 0)
    {
        <p class="text-muted">No hay familiares vinculados.</p>
    }
    else
    {
        @* En pantallas estrechas, una entrada por familiar en lugar de la tabla de seis columnas (directrices-pwa-movil.md,
           sección 2). *@
        <ul class="list-group d-md-none mb-3">
            @foreach (var member in Model.Detail.Family)
            {
                <li class="list-group-item py-3">
                    <div class="fw-semibold">
                        @member.DisplayName
                        @if (Model.Detail.CurrentEmergencyContacts.Contains(member.LinkId))
                        {
                            <span class="badge text-bg-primary ms-1 align-middle">Contacto urgente</span>
                        }
                        @if (member.IsReferent)
                        {
                            <span class="badge text-bg-secondary ms-1 align-middle">Referente</span>
                        }
                        @if (member.IsLegalGuardian)
                        {
                            <span class="badge text-bg-secondary ms-1 align-middle">Tutor legal</span>
                        }
                    </div>
                    <div class="text-body-secondary small">@member.Relationship · @member.Phone</div>
                    @if (member.Email is not null)
                    {
                        <div class="text-body-secondary small text-break">@member.Email</div>
                    }
                    <div class="small mb-2">@AdministrativeResidentDisplay.Authorization(member, Model.Today)</div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="AutorizacionFamiliar" asp-route-residenteId="@resident.ResidentId.Value" asp-route-vinculoId="@member.LinkId"
                           class="btn btn-outline-primary">Autorización</a>
                        <a asp-action="EditarFamiliar" asp-route-residenteId="@resident.ResidentId.Value" asp-route-vinculoId="@member.LinkId"
                           class="btn btn-outline-secondary">Editar</a>
                    </div>
                </li>
            }
        </ul>
        <div class="table-responsive d-none d-md-block">
            <table class="table align-middle">
                <caption class="visually-hidden">Familiares vinculados al residente</caption>
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Relación</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Autorización</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Detail.Family)
                    {
                        <tr>
                            <th scope="row">
                                @member.DisplayName
                                @if (Model.Detail.CurrentEmergencyContacts.Contains(member.LinkId))
                                {
                                    <span class="badge text-bg-primary ms-1">Contacto urgente</span>
                                }
                    @if (member.IsReferent)
                    {
                        <span class="badge text-bg-secondary ms-1">Referente</span>
                    }
                    @if (member.IsLegalGuardian)
                    {
                        <span class="badge text-bg-secondary ms-1">Tutor legal</span>
                    }
                            </th>
                            <td>@member.Relationship</td>
                            <td>@member.Phone</td>
                            <td>@(member.Email ?? "—")</td>
                            <td>@AdministrativeResidentDisplay.Authorization(member, Model.Today)</td>
                            <td class="text-nowrap">
                                <a asp-action="AutorizacionFamiliar" asp-route-residenteId="@resident.ResidentId.Value" asp-route-vinculoId="@member.LinkId"
                                   class="btn btn-outline-primary">Autorización</a>
                                <a asp-action="EditarFamiliar" asp-route-residenteId="@resident.ResidentId.Value" asp-route-vinculoId="@member.LinkId"
                                   class="btn btn-outline-secondary">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="AnadirFamiliar" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary btn-lg">Añadir familiar</a>
        <a asp-action="VincularFamiliar" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Vincular un familiar que ya existe</a>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">Contactos urgentes</h2>
    @{
        var currentContacts = Model.Detail.CurrentEmergencyContacts
            .Select(linkId => Model.Detail.Family.FirstOrDefault(f => f.LinkId == linkId)).OfType<ResidApp.Application.Ports.ResidentFamilyMember>().ToList();
    }
    @if (currentContacts.Count == 0)
    {
        <p class="text-muted">No hay contacto urgente designado.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var currentContact in currentContacts)
            {
                <li><strong>@currentContact.DisplayName</strong> @($"({currentContact.Relationship}) · {currentContact.Phone}")</li>
            }
        </ul>
    }
    @if (Model.Detail.Family.Count > 0)
    {
        <a asp-action="ContactoUrgente" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary btn-lg mb-3">
            @(currentContacts.Count == 0 ? "Designar contactos urgentes" : "Cambiar contactos urgentes")
        </a>
    }
    @if (Model.Detail.EmergencyContacts.Count > 0)
    {
        <h3 class="h6">Historial</h3>
        <ol class="list-group list-group-numbered">
            @foreach (var designation in Model.Detail.EmergencyContacts)
            {
                <li class="list-group-item">
                    @designation.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Administración ·
                    @(designation.Action switch
                    {
                        "AGREGAR" => "Contacto urgente añadido: " + designation.DisplayName,
                        "QUITAR" => "Contacto urgente quitado: " + designation.DisplayName,
                        _ => designation.DisplayName ?? "Sin contacto urgente",
                    })
                </li>
            }
        </ol>
    }
</section>

<section class="mb-4">
    <h2 class="h5">Historial de ubicación</h2>
    <p class="text-muted">Del más reciente al más antiguo. Cada cambio de ubicación cierra el anterior; ninguno se reescribe.</p>
    @* En pantallas estrechas, una entrada por intervalo en lugar de la tabla (directrices-pwa-movil.md, sección 2). *@
    <ul class="list-group d-md-none mb-3">
        @foreach (var location in Model.Detail.Locations)
        {
            <li class="list-group-item py-3">
                <div class="fw-semibold">@location.UnitName</div>
                @if (location.RoomName is not null)
                {
                    <div class="text-body-secondary small">@location.RoomName@(location.PlaceName is null ? "" : $" · {location.PlaceName}")</div>
                }
                <div class="small">
                    Desde el @location.From.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    · @(location.Until is { } until ? $"hasta el {until.ToLocalTime():dd/MM/yyyy HH:mm}" : "vigente")
                </div>
                <div class="text-body-secondary small">Registrado por @SystemProfileDisplay.Label(location.RecordedBy)</div>
            </li>
        }
    </ul>
    <div class="table-responsive d-none d-md-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Intervalos de ubicación del residente</caption>
            <thead>
                <tr>
                    <th scope="col">Unidad (y habitación o plaza)</th>
                    <th scope="col">Desde</th>
                    <th scope="col">Hasta</th>
                    <th scope="col">Registrado por</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in Model.Detail.Locations)
                {
                    <tr>
                        <th scope="row">
                            @location.UnitName
                            @if (location.RoomName is not null)
                            {
                                <div class="text-muted small fw-normal">@location.RoomName@(location.PlaceName is null ? "" : $" · {location.PlaceName}")</div>
                            }
                        </th>
                        <td>@location.From.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(location.Until is { } until ? until.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Vigente")</td>
                        <td>@SystemProfileDisplay.Label(location.RecordedBy)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="mb-4">
    <h2 class="h5">Correcciones de identidad</h2>
    @if (Model.Detail.Corrections.Count == 0)
    {
        <p class="text-muted">La identidad no se ha corregido nunca.</p>
    }
    else
    {
        <ol class="list-group list-group-numbered">
            @foreach (var correction in Model.Detail.Corrections)
            {
                <li class="list-group-item">
                    <span class="fw-semibold">@correction.CorrectedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Administración</span>
                    <div>Antes: @AdministrativeResidentDisplay.Identity(correction.Before)</div>
                    <div>Después: @AdministrativeResidentDisplay.Identity(correction.After)</div>
                    <div>Motivo: @correction.Reason</div>
                </li>
            }
        </ol>
    }
</section>

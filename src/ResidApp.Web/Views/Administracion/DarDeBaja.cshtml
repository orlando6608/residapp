@using ResidApp.Domain.Residents
@using ResidApp.Web.Models
@model DischargeResidentViewModel
@{
    var resident = Model.Resident;
    ViewData["Title"] = "Dar de baja";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Residentes">Residentes</a></li>
        <li class="breadcrumb-item"><a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value">@resident.DisplayName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Dar de baja</li>
    </ol>
</nav>

<h1 class="h3">Dar de baja</h1>
<p class="text-muted">
    Cierra la estancia de @resident.DisplayName en el centro. Los datos no se borran: se conservan @ResidentDischarge.RetentionYears años desde la baja,
    en solo lectura (los ve Administración en «Residentes dados de baja»), y Administración puede reactivar al residente. Si solo está ingresado
    en un hospital durante un tiempo, usa <strong>Suspender</strong> en su ficha: no es una baja.
</p>

@if (Model.Load.FutureAppointments > 0 || Model.Load.OpenRequests > 0)
{
    <div class="alert alert-warning" role="status" id="aviso-citas">
        <strong>Al dar de baja se cancelarán solas las citas y se cerrarán las solicitudes de cita de @resident.DisplayName:</strong>
        @Model.Load.FutureAppointments @(Model.Load.FutureAppointments == 1 ? "cita futura" : "citas futuras") y
        @Model.Load.OpenRequests @(Model.Load.OpenRequests == 1 ? "solicitud abierta" : "solicitudes abiertas").
        Quedan en el historial como «Sistema, a causa de la baja». <strong>La familia no recibe ningún aviso: avísala tú</strong> (por teléfono o por el canal habitual del centro).
        Si más tarde reactivas al residente, esas citas no se restauran: la familia tendrá que pedirlas de nuevo.
    </div>
}
else
{
    <p class="text-muted" id="aviso-citas">No tiene citas futuras ni solicitudes de cita abiertas: la baja no cancela ni cierra nada de la agenda.</p>
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="DarDeBaja" method="post">
            <input type="hidden" name="Form.ResidenteId" value="@Model.Form.ResidenteId" />
            <input type="hidden" name="Form.OperacionId" value="@Model.Form.OperacionId" />

            <div class="mb-3">
                <label asp-for="Form.Motivo" class="form-label"></label>
                <select asp-for="Form.Motivo" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<ResidentDischargeReason>()"></select>
                <span asp-validation-for="Form.Motivo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Form.MotivoTexto" class="form-label"></label>
                <textarea asp-for="Form.MotivoTexto" class="form-control form-control-lg" rows="3"></textarea>
                <span asp-validation-for="Form.MotivoTexto" class="text-danger"></span>
            </div>

            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Residente" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-danger btn-lg">Dar de baja</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

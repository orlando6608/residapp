@model IReadOnlyList<ResidApp.Application.Ports.StructureUnit>
@{
    ViewData["Title"] = "Estructura del centro";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item active" aria-current="page">Estructura</li>
    </ol>
</nav>

<h1 class="h3">Estructura del centro</h1>
<p class="text-muted">
    Unidades concedidas a tu ámbito. Una unidad nueva queda concedida a tu ámbito; después, desde Usuarios, se concede a cada
    perfil. Crear o cambiar una unidad no da acceso clínico a nadie. Los edificios y las plantas son del centro y agrupan las unidades
    (desde «Edificios y plantas»); las habitaciones y las plazas son de cada unidad (desde «Habitaciones y plazas»).
</p>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

@if (ViewData.ModelState.IsValid)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="NuevaUnidad" class="btn btn-primary btn-lg">Nueva unidad</a>
        <a asp-action="Edificios" class="btn btn-outline-secondary btn-lg">Edificios y plantas</a>
    </div>
}

@if (ViewData.ModelState.IsValid && Model.Count == 0)
{
    <p class="estado-vacio">Tu ámbito no tiene ninguna unidad.</p>
}
else if (Model.Count > 0)
{
    @* En pantallas estrechas, una entrada por unidad en lugar de la tabla de seis columnas (directrices-pwa-movil.md,
       sección 2). *@
    <ul class="list-group d-md-none mb-3">
        @foreach (var unit in Model)
        {
            <li class="list-group-item py-3">
                <div class="fw-semibold">
                    @unit.Name
                    <span class="badge @(unit.Active ? "text-bg-success" : "text-bg-secondary") align-middle">@(unit.Active ? "Activa" : "Inactiva")</span>
                </div>
                <div class="text-body-secondary small">
                    <code>@unit.Code</code> · @unit.CurrentResidents @(unit.CurrentResidents == 1 ? "residente ubicado" : "residentes ubicados")
                </div>
                <div class="text-body-secondary small mb-2">
                    @(unit.BuildingName is null ? "Sin edificio" : unit.FloorName is null ? unit.BuildingName : $"{unit.BuildingName} · {unit.FloorName}")
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="NombreUnidad" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Cambiar nombre</a>
                    <a asp-action="UbicacionUnidad" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Edificio y planta</a>
                    <a asp-action="Habitaciones" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Habitaciones y plazas</a>
                    <form asp-action="EstadoUnidad" method="post">
                        <input type="hidden" name="unidadId" value="@unit.UnitId.Value" />
                        <input type="hidden" name="activa" value="@(unit.Active ? "false" : "true")" />
                        <button type="submit" class="btn @(unit.Active ? "btn-outline-danger" : "btn-outline-success")">
                            @(unit.Active ? "Inactivar" : "Reactivar")
                        </button>
                    </form>
                </div>
            </li>
        }
    </ul>
    <div class="table-responsive d-none d-md-block">
        <table class="table align-middle">
            <caption class="visually-hidden">Unidades del ámbito</caption>
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Código</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Edificio y planta</th>
                    <th scope="col">Residentes ubicados</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model)
                {
                    <tr>
                        <th scope="row">@unit.Name</th>
                        <td><code>@unit.Code</code></td>
                        <td>
                            <span class="badge @(unit.Active ? "text-bg-success" : "text-bg-secondary")">@(unit.Active ? "Activa" : "Inactiva")</span>
                        </td>
                        <td>@(unit.BuildingName is null ? "—" : unit.FloorName is null ? unit.BuildingName : $"{unit.BuildingName} · {unit.FloorName}")</td>
                        <td>@unit.CurrentResidents</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="NombreUnidad" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Cambiar nombre</a>
                                <a asp-action="UbicacionUnidad" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Edificio y planta</a>
                                <a asp-action="Habitaciones" asp-route-unidadId="@unit.UnitId.Value" class="btn btn-outline-primary">Habitaciones y plazas</a>
                                <form asp-action="EstadoUnidad" method="post">
                                    <input type="hidden" name="unidadId" value="@unit.UnitId.Value" />
                                    <input type="hidden" name="activa" value="@(unit.Active ? "false" : "true")" />
                                    <button type="submit" class="btn @(unit.Active ? "btn-outline-danger" : "btn-outline-success")">
                                        @(unit.Active ? "Inactivar" : "Reactivar")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        Una unidad con residentes ubicados no se puede inactivar. Una unidad inactiva deja de ofrecerse en el alta de residentes y en
        la gestión de usuarios.
    </p>
}

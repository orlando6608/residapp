@using ResidApp.Web.Models
@model ReactivateResidentViewModel
@{
    var resident = Model.Resident;
    ViewData["Title"] = "Reactivar residente";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Bajas">Residentes dados de baja</a></li>
        <li class="breadcrumb-item active" aria-current="page">Reactivar</li>
    </ol>
</nav>

<h1 class="h3">Reactivar residente</h1>
<p class="text-muted">
    @resident.DisplayName vuelve al centro: se abre una estancia nueva en la unidad que elijas y vuelve a estar en las listas. Su historial
    anterior se conserva.
</p>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 card-title">Baja</h2>
        <p class="mb-0">@EnumDisplay.Label(resident.Reason) · @resident.DischargedAt.ToLocalTime().ToString("dd/MM/yyyy") · última unidad: @resident.LastUnitName</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        @if (Model.Units.Count == 0)
        {
            <div class="alert alert-warning" role="alert">Tu ámbito activo no tiene ninguna unidad en la que reactivar al residente.</div>
        }
        else
        {
            <form asp-action="Reactivar" method="post">
                <input type="hidden" name="Form.ResidenteId" value="@Model.Form.ResidenteId" />
                <input type="hidden" name="Form.OperacionId" value="@Model.Form.OperacionId" />

                <div class="mb-3">
                    <label asp-for="Form.UnidadId" class="form-label"></label>
                    <select asp-for="Form.UnidadId" class="form-select form-select-lg" asp-items="Model.Units">
                        <option value="">Elige una unidad</option>
                    </select>
                    <span asp-validation-for="Form.UnidadId" class="text-danger"></span>
                </div>
                @if (Model.Locations.Count > 0)
                {
                    <div class="mb-3">
                        <label asp-for="Form.Ubicacion" class="form-label"></label>
                        <select asp-for="Form.Ubicacion" class="form-select form-select-lg" aria-describedby="ayuda-ubicacion">
                            <option value="">Sin habitación ni plaza</option>
                            @foreach (var unitGroup in Model.Locations.GroupBy(l => l.UnitName))
                            {
                                <optgroup label="@unitGroup.Key">
                                    @foreach (var option in unitGroup)
                                    {
                                        @if (option.PlaceId is { } placeId)
                                        {
                                            <option value="p:@placeId">@option.RoomName · @option.PlaceName</option>
                                        }
                                        else
                                        {
                                            <option value="r:@option.RoomId">@option.RoomName</option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>
                        <div id="ayuda-ubicacion" class="form-text">Opcional. Debe ser de la unidad elegida; las plazas ocupadas no se ofrecen.</div>
                        <span asp-validation-for="Form.Ubicacion" class="text-danger"></span>
                    </div>
                }

                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <a asp-action="Bajas" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-lg">Reactivar</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

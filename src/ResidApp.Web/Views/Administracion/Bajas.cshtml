@using ResidApp.Domain.Residents
@using ResidApp.Web.Models
@model DischargedResidentsViewModel
@{
    ViewData["Title"] = "Residentes dados de baja";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item active" aria-current="page">Residentes dados de baja</li>
    </ol>
</nav>

<h1 class="h3 d-flex align-items-center gap-2"><partial name="_Icono" model='"baja"' />Residentes dados de baja</h1>
<p class="text-muted">
    Solo lectura. Sus datos no se borran solos y se conservan @ResidentDischarge.RetentionYears años desde la baja; puedes reactivar a un residente si vuelve al centro.
</p>
@{
    var expired = Model.Residents.Count(r => ResidentDischarge.RetentionStatus(r.RetainUntil, Model.Today) == ResidentRetentionStatus.Vencido);
    var soon = Model.Residents.Count(r => ResidentDischarge.RetentionStatus(r.RetainUntil, Model.Today) == ResidentRetentionStatus.VenceEnBreve);
}
@if (expired > 0 || soon > 0)
{
    <div class="alert alert-warning" role="status">
        <strong>Plazo de conservación:</strong>
        @(expired > 0 ? $"{expired} con el plazo vencido" : "")@(expired > 0 && soon > 0 ? " y " : "")@(soon > 0 ? $"{soon} que vence{(soon == 1 ? "" : "n")} en los próximos {ResidentDischarge.RetentionWarningMonths} meses" : "").
        ResidApp <strong>no borra nada</strong> por sí sola. Que un plazo haya vencido no obliga a destruir la documentación: conservarla o expurgarla lo decide
        la dirección médica del centro, y el centro deja constancia de lo que elimine.
    </div>
}
<div asp-validation-summary="All" class="text-danger"></div>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

@if (Model.Residents.Count == 0)
{
    <p class="estado-vacio text-muted">No hay residentes dados de baja en tu ámbito.</p>
}
else
{
    <div class="list-group">
        @foreach (var resident in Model.Residents)
        {
            <div class="list-group-item">
                <div class="d-md-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h6 mb-1">@resident.DisplayName</h2>
                        <p class="mb-1 small">
                            @resident.BirthDate.ToString("dd/MM/yyyy") (@AdministrativeResidentDisplay.Age(resident.BirthDate, Model.Today) años) ·
                            @EnumDisplay.Label(resident.DocumentedSex) · última unidad: @resident.LastUnitName
                        </p>
                        <p class="mb-1 small">
                            Baja el @resident.DischargedAt.ToLocalTime().ToString("dd/MM/yyyy"): <strong>@EnumDisplay.Label(resident.Reason)</strong>@(resident.ReasonText is null ? "" : " · " + resident.ReasonText)
                        </p>
                        @{ var retention = ResidentDischarge.RetentionStatus(resident.RetainUntil, Model.Today); }
                        <p class="mb-0 small text-body-secondary">
                            Datos conservados hasta el @resident.RetainUntil.ToString("dd/MM/yyyy").
                            @if (retention == ResidentRetentionStatus.Vencido)
                            {
                                <span class="badge text-bg-warning">Plazo vencido</span>
                            }
                            else if (retention == ResidentRetentionStatus.VenceEnBreve)
                            {
                                <span class="badge text-bg-warning">Vence en menos de @ResidentDischarge.RetentionWarningMonths meses</span>
                            }
                        </p>
                    </div>
                    <a asp-action="Reactivar" asp-route-residenteId="@resident.ResidentId.Value" class="btn btn-outline-primary mt-2 mt-md-0">Reactivar</a>
                </div>
            </div>
        }
    </div>
}

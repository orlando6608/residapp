@using ResidApp.Application.Ports
@using ResidApp.Application.UseCases
@using ResidApp.Web.Models
@model AdministracionInicioViewModel
@{
    ViewData["Title"] = "Inicio de Administración";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Administración</li>
    </ol>
</nav>

<h1 class="h3">Inicio de Administración</h1>
<p class="text-muted">
    Gestión administrativa de los residentes de tu ámbito. Administración no ve el basal ni ningún contenido clínico.
</p>
<div asp-validation-summary="All" class="text-danger"></div>

@{
    string Plural(int count, string one, string many) => count == 1 ? $"{count} {one}" : $"{count} {many}";
    var attention = Model.Attention;
    var communications = Model.Communications;
}
@if (attention is not null)
{
    <section class="mb-4" aria-labelledby="atencion">
        <h2 class="h5" id="atencion">Requiere atención</h2>
        @* Por orden de importancia (CJ, tercera 4.4): primero a quién llamar en una urgencia; al final, las cuentas que conviene revisar. *@
        @if (Model.NothingPending)
        {
            <p class="mb-2">No hay nada pendiente.</p>
        }
        else
        {
            <ul class="list-group mb-2">
                @if (attention.ResidentsWithoutEmergencyContact > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="SinContactoUrgente">@Plural(attention.ResidentsWithoutEmergencyContact, "residente sin contacto urgente ni motivo indicado", "residentes sin contacto urgente ni motivo indicado")</a></li>
                }
                @if (attention.AppointmentRequestsPending > 0)
                {
                    <li class="list-group-item"><a asp-action="SolicitudesCitas">@Plural(attention.AppointmentRequestsPending, "solicitud de cita por gestionar", "solicitudes de cita por gestionar")</a></li>
                }
                @if (attention.AppointmentRequestsAwaitingFamily > 0)
                {
                    <li class="list-group-item"><a asp-action="SolicitudesCitas">@Plural(attention.AppointmentRequestsAwaitingFamily, "propuesta de cita esperando respuesta de la familia", "propuestas de cita esperando respuesta de la familia")</a></li>
                }
                @if (attention.AppointmentsPastUnclosed > 0)
                {
                    <li class="list-group-item"><a asp-action="AgendaCitas" asp-fragment="sin-cerrar">@Plural(attention.AppointmentsPastUnclosed, "cita pasada sin cerrar", "citas pasadas sin cerrar")</a></li>
                }
                @if (attention.AuthorizationsPending > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="AutorizacionPendiente">@Plural(attention.AuthorizationsPending, "autorización de familiar pendiente de activar", "autorizaciones de familiares pendientes de activar")</a></li>
                }
                @if (attention.AuthorizationsExpired > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="AutorizacionCaducada">@Plural(attention.AuthorizationsExpired, "autorización de familiar caducada", "autorizaciones de familiares caducadas")</a></li>
                }
                @if (attention.AuthorizationsExpiringSoon > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="AutorizacionPorCaducar">@Plural(attention.AuthorizationsExpiringSoon, "autorización de familiar caduca", "autorizaciones de familiares caducan") en @AdministrationOverviewRules.ExpiringSoonDays días o menos</a></li>
                }
                @if (attention.ResidentsLocationPending > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="UbicacionPendiente">@Plural(attention.ResidentsLocationPending, "residente con la ubicación pendiente (sin habitación o sin cama)", "residentes con la ubicación pendiente (sin habitación o sin cama)")</a></li>
                }
                @if (attention.PhotosToRenew > 0)
                {
                    <li class="list-group-item"><a asp-action="Residentes" asp-route-atencion="FotoAntigua">@Plural(attention.PhotosToRenew, "foto de residente", "fotos de residentes") con más de @ResidApp.Domain.Residents.ResidentPhotoRenewal.Months meses: conviene @(attention.PhotosToRenew == 1 ? "renovarla" : "renovarlas")</a></li>
                }
                @if (Model.AccountsToReview is > 0 and var accountsToReview)
                {
                    <li class="list-group-item"><a asp-action="Usuarios" asp-route-revisar="true">@Plural(accountsToReview, "cuenta profesional suspendida o sin ámbito", "cuentas profesionales suspendidas o sin ámbito")</a></li>
                }
            </ul>
        }
        <p class="text-body-secondary small mb-0">
            <a asp-action="AgendaCitas">Citas confirmadas: @attention.AppointmentsToday hoy y @attention.AppointmentsComing en los próximos @AdministrationOverviewRules.ComingAppointmentDays días</a>.
            @if (communications is not null)
            {
                <span> <a asp-action="Comunicados">Comunicados a la familia: @communications.Scheduled programados y @communications.PublishedRecently publicados en los últimos @AdministrationCommunicationsSummary.RecentDays días</a>.</span>
            }
        </p>
    </section>
}
else
{
    <p class="text-body-secondary small">Ahora mismo no se pueden mostrar las cifras de lo que requiere atención. El resto del inicio funciona con normalidad.</p>
}

<div class="row g-3">
    <div class="col-12 col-md-6">
        <a asp-action="Residentes" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Residentes</h2>
                @* Cifra grande con plural real (guia-diseno-sistema-visual.md, 2.B). *@
                <span class="cifra">@Model.Residents</span>
                <span class="d-block">@(Model.Residents == 1 ? "residente en tu ámbito" : "residentes en tu ámbito")</span>
                <p class="card-text text-body-secondary mb-0">Ficha administrativa, historial de ubicación y corrección de identidad.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-controller="Residents" asp-action="Create" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Alta de residente</h2>
                <p class="card-text mb-0">Registrar un nuevo residente en el centro. Su basal queda pendiente.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Bajas" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Residentes dados de baja</h2>
                <p class="card-text mb-0">Lista de solo lectura con el motivo de cada baja y hasta cuándo se conservan sus datos. Desde ahí puedes reactivar a un residente.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Usuarios" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Usuarios</h2>
                <span class="cifra">@Model.Accounts</span>
                <span class="d-block">@(Model.Accounts == 1 ? "cuenta con perfil en el centro" : "cuentas con perfil en el centro")</span>
                <p class="card-text text-body-secondary mb-0">Alta, suspensión, perfiles, unidades y residentes asignados.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="AmbitoCentro" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Unidades del centro</h2>
                <p class="card-text mb-0">Todas las unidades del centro y las de tu ámbito; la Administración principal puede añadirse las que no tiene.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Comunicados" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Comunicados a la familia</h2>
                <p class="card-text mb-0">Los comunicados de tus unidades, la hora a la que se publican y cuándo publicar uno antes.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Citas" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Citas con la familia</h2>
                <p class="card-text mb-0">El servicio de citas del centro, sus franjas y bloqueos, y la agenda de citas reservadas.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="DatosCentro" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Datos del centro</h2>
                <p class="card-text mb-0">El nombre y el logo del centro, que salen en el encabezado, al imprimir y en los PDF.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Estructura" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Estructura del centro</h2>
                <p class="card-text mb-0">Crear, renombrar e inactivar las unidades de tu ámbito.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Turnos" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Turnos</h2>
                <p class="card-text mb-0">El catálogo de turnos del centro: nombre y horas.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Equipos" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Equipos</h2>
                <p class="card-text mb-0">Grupos con nombre en cada unidad y sus miembros.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Planificacion" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Planificación de turnos</h2>
                <p class="card-text mb-0">Qué equipo hace qué turno cada día, con aviso de solapamientos.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Importar" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Importar datos</h2>
                <p class="card-text mb-0">Traer la estructura del centro y los residentes desde un fichero CSV o Excel de otra aplicación.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Exportar" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Exportar datos</h2>
                <p class="card-text mb-0">Descargar la estructura y el censo de residentes en CSV, con las columnas de ResidApp o de otra aplicación.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a asp-action="Auditoria" class="card text-decoration-none h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Auditoría</h2>
                <p class="card-text mb-0">Quién hizo qué y cuándo en cuentas, perfiles, estructura, residentes y familias.</p>
            </div>
        </a>
    </div>
</div>

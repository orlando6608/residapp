@using ResidApp.Application.UseCases
@using ResidApp.Domain.Enfermeria
@using ResidApp.Web.Models
@model IReadOnlyList<FamilyCommunicationStatusView>
@{
    ViewData["Title"] = "Comunicados a la familia";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item active" aria-current="page">Comunicados a la familia</li>
    </ol>
</nav>

<h1 class="h3">Comunicados a la familia</h1>
<p class="text-muted">
    Los comunicados de las unidades de tu ámbito de los últimos @AdministrationFamilyCommunicationApplicationService.WindowDays días. Quien lo prepara lo
    aprueba al guardarlo. Se deja 1 hora de margen para corregir errores y después se publica a las @FamilyCommunicationSchedule.PublicationTime.ToString("HH:mm")
    del día. Tú puedes publicar uno antes de su hora. Si la información es urgente este no es el canal: avisa también por otros medios.
    La familia lo verá firmado como «@FamilyCommunicationChoice.VisibleAuthor».
</p>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

@if (Model.Count == 0)
{
    <p class="estado-vacio">No hay comunicados a la familia en los últimos @AdministrationFamilyCommunicationApplicationService.WindowDays días.</p>
}
else
{
    @foreach (var item in Model)
    {
        var communication = item.Communication;
        <div class="card mb-3 border-start border-4 @(item.Published ? "border-success" : "border-info")">
            <div class="card-body">
                <h2 class="h5 card-title">@communication.ResidentName</h2>
                <p class="text-muted mb-2">
                    @(communication.UnitName ?? "Sin unidad") ·
                    <span class="badge text-bg-light border">@FamilyCommunicationDisplay.Label(communication.Type)</span>
                    · Preparado el @communication.PreparedAt.ToLocalTime().ToString("g") ·
                    @if (communication.PublishedEarlyAt is { } early)
                    {
                        <span class="badge text-bg-success">Publicado antes de su hora, el @early.ToLocalTime().ToString("g")</span>
                    }
                    else if (item.Published)
                    {
                        <span class="badge text-bg-success">Publicado el @item.ScheduledAt.ToLocalTime().ToString("g")</span>
                    }
                    else
                    {
                        <span class="badge text-bg-info">Se publica el @item.ScheduledAt.ToLocalTime().ToString("g")</span>
                    }
                </p>
                <p class="mb-2" style="white-space: pre-line">@communication.Text</p>
                @if (!item.Published)
                {
                    <form asp-action="PublicarComunicado" method="post">
                        <input type="hidden" name="comunicadoId" value="@communication.Id" />
                        <button type="submit" class="btn btn-outline-primary">Publicar ahora</button>
                    </form>
                }
            </div>
        </div>
    }
}

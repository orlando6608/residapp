@model ResidApp.Web.Models.RenameTeamViewModel
@{
    ViewData["Title"] = "Nombre del equipo";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Administración</a></li>
        <li class="breadcrumb-item"><a asp-action="Equipos">Equipos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nombre</li>
    </ol>
</nav>

<h1 class="h3">Nombre del equipo</h1>
<p class="text-muted">Unidad: @Model.Team.UnitName (no cambia). El cambio de nombre queda en la auditoría.</p>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="NombreEquipo" method="post">
            <input type="hidden" name="Form.EquipoId" value="@Model.Form.EquipoId" />
            <div class="mb-3">
                <label asp-for="Form.Nombre" class="form-label"></label>
                <input asp-for="Form.Nombre" class="form-control form-control-lg" autocomplete="off" />
                <span asp-validation-for="Form.Nombre" class="text-danger"></span>
            </div>
            <div class="d-grid d-md-flex justify-content-md-end gap-2">
                <a asp-action="Equipos" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg">Guardar nombre</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ResidApp.Application\ResidApp.Application.csproj" />
    <ProjectReference Include="..\ResidApp.Domain\ResidApp.Domain.csproj" />
    <ProjectReference Include="..\ResidApp.Shared\ResidApp.Shared.csproj" />
  </ItemGroup>

  <!-- ASP.NET Core Identity (ADR 0007, I1): UserManager y las interfaces de almacén vienen en el framework compartido, sin paquete. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <!-- Lectura de los ficheros de importación (CSV, XLS y XLSX; ADR 0010). Licencia MIT. -->
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Dependencia transitiva de SqlClient y PDFsharp fijada en una versión corregida (GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7:
         ellos piden 9.0.13, vulnerable). Se puede quitar cuando ambos pidan una versión corregida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Fuente del PDF de derivación (SIL OFL 1.1, ver Pdf/Fonts/OFL.txt): PDFsharp no encuentra fuentes del
       sistema en Linux (Azure y CI), así que se incrusta y se resuelve siempre desde aquí. -->
  <ItemGroup>
    <EmbeddedResource Include="Pdf\Fonts\LiberationSans-Regular.ttf" LogicalName="ResidApp.Fonts.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Pdf\Fonts\LiberationSans-Bold.ttf" LogicalName="ResidApp.Fonts.LiberationSans-Bold.ttf" />
    <!-- Icono del encabezado: PDFsharp no importa SVG, así que es wwwroot\images\logo.svg rasterizado a PNG, aplanado sobre blanco y sin alfa (con alfa deja un halo oscuro en las esquinas). -->
    <EmbeddedResource Include="Pdf\Images\logo.png" LogicalName="ResidApp.Images.logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
